        "type": "SetDoorState",
        "target": {
          "kind": "Door",
          "id": "door_gate_01"
        },
        "params": {
          "isOpen": true,
          "animate": true
        }
      }
    ],
    "cooldownSec": 0,
    "once": true
  },
