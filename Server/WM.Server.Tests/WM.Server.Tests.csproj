<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TASK-WM-216 — 서버 판정 시험.
    서버가 「클라가 보낸 값을 그대로 믿지 않는다」를 시험이 증명한다.
    이 묶음은 CI 의 엔진 밖 게이트에서 함께 돈다(WM-214 가 세운 자리).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>none</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../WM.Server/WM.Server.csproj" />
  </ItemGroup>

  <!--
    유니티 없이 도는 EditMode 시험을 <b>여기서 같이 돌린다</b> (TASK-WM-364).

    ★ 왜: EditMode 에 시험이 1572개 있는데 CI 에서는 <b>한 개도 안 돈다</b>(유니티 라이선스, WM-221).
      그중 969개는 유니티를 아예 안 쓴다 — DomainSDK 만 본다. 즉 판정 규칙의 대부분이
      「시험은 있는데 아무도 안 보는」 상태였다(WM-363 에서 실제로 그 틈으로 결함이 하나 나왔다).
      복사하지 않고 <b>같은 파일을 링크</b>한다 — 두 벌이 되면 곧 갈라진다.
  -->
  <ItemGroup>
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/Portable/Net/**/*.cs">
      <Link>EditMode/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>

    <!-- 코어에 가까운 자리부터 한 파일씩 (TASK-WM-364 이어서) — 유니티를 안 쓰는 것만 -->
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/Portable/Item/InventoryCanReceiveTests.cs">
      <Link>EditMode/Item/InventoryCanReceiveTests.cs</Link>
    </Compile>
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/Portable/Item/InventoryCoreTests.cs">
      <Link>EditMode/Item/InventoryCoreTests.cs</Link>
    </Compile>
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/Portable/Item/RecipeKeyTests.cs">
      <Link>EditMode/Item/RecipeKeyTests.cs</Link>
    </Compile>
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/Portable/Combat/DamageCalculationTests.cs">
      <Link>EditMode/Combat/DamageCalculationTests.cs</Link>
    </Compile>
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/Portable/Combat/HealthResolutionTests.cs">
      <Link>EditMode/Combat/HealthResolutionTests.cs</Link>
    </Compile>
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/Portable/Combat/UnitStatEngineFreeTests.cs">
      <Link>EditMode/Combat/UnitStatEngineFreeTests.cs</Link>
    </Compile>
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/Portable/Building/BuildingCensusTests.cs">
      <Link>EditMode/Building/BuildingCensusTests.cs</Link>
    </Compile>
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/Portable/Building/BuildingFootprintTests.cs">
      <Link>EditMode/Building/BuildingFootprintTests.cs</Link>
    </Compile>
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/Portable/BuildingProductionModelTest.cs">
      <Link>EditMode/BuildingProductionModelTest.cs</Link>
    </Compile>
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/Portable/CityEconomyTest.cs">
      <Link>EditMode/CityEconomyTest.cs</Link>
    </Compile>
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/Portable/CitySimulationSystemTest.cs">
      <Link>EditMode/CitySimulationSystemTest.cs</Link>
    </Compile>
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/Portable/FreshnessTest.cs">
      <Link>EditMode/FreshnessTest.cs</Link>
    </Compile>
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/Portable/LeylineGraphTest.cs">
      <Link>EditMode/LeylineGraphTest.cs</Link>
    </Compile>
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/Portable/ManaFlowTest.cs">
      <Link>EditMode/ManaFlowTest.cs</Link>
    </Compile>
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/Portable/ModeControllerEdgeTriggerTest.cs">
      <Link>EditMode/ModeControllerEdgeTriggerTest.cs</Link>
    </Compile>
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/RciDemandModelTest.cs">
      <Link>EditMode/RciDemandModelTest.cs</Link>
    </Compile>
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/Portable/SimulationTickSchedulerTest.cs">
      <Link>EditMode/SimulationTickSchedulerTest.cs</Link>
    </Compile>
  </ItemGroup>

  <!--
    ⚠ 여기 못 데려오는 것들 (TASK-WM-364):
      · 대화(Dialogue*)·주입(CompositionRoot/SceneDi/VContainer)·로비/넷코드/UGC — DomainSDK 밖을 본다.
      · `ConstructIdempotencyTests` — <b>소스 파일을 훑는</b> 시험이라 도는 자리(bin 폴더)에서는 길이 없다.
        「유니티를 안 쓴다」와 「엔진 밖에서 돈다」는 다른 말이다.
  -->

  <!--
    창 파일들을 시험 자리에도 갖다 둔다 (TASK-WM-226).

    ★ 왜: 미리 눌러 보내는 길은 <b>진짜 파일이 있어야</b> 시험할 수 있다. 서버의 build 산출물에는
      wwwroot 가 안 실린다(publish 에만 실린다) — 그래서 시험이 「눌린 게 없다」로 헛돌았다.
      배포 모양(publish)은 웹 관문(wm-web-*.mjs)이 지키고, 여기서는 <b>코드</b>를 지킨다.
  -->
  <ItemGroup>
    <Content Include="../WM.Server/wwwroot/**/*">
      <Link>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
