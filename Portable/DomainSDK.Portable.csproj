<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TASK-WM-214 — DomainSDK 를 Unity 없이 컴파일한다.

    이 프로젝트는 Unity 가 만드는 .csproj 와 무관하다. 같은 소스(DomainSDK, 레포 루트의 로컬 UPM 패키지)를
    엔진 밖 컴파일러로 한 번 더 굽는 것이 목적 — "판정이 정말 엔진에서 독립했는가" 를 매번 증명하는 게이트.
    빌드가 초록이면 그 순간의 DomainSDK 는 헤드리스 서버 / 웹 백엔드에서 그대로 돌 수 있다.

    Unity 는 Assets/ 밖의 .csproj 를 읽지 않으므로 에디터 쪽에 영향 0.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>WitchMendokusai.DomainSDK.Portable</AssemblyName>
    <RootNamespace>WitchMendokusai</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!--
      이 게이트가 묻는 것은 단 하나 - "Unity 없이 컴파일되는가".
      루트 Directory.Build.props 의 EnforceCodeStyleInBuild=true 를 그대로 물면
      .NET 기본 서식 규칙(IDE0055 등)이 WM 스타일(탭/Allman)과 부딪혀 4500여 개의
      '서식 오류'가 쏟아진다 - 엔진 독립성과 아무 상관 없는 잡음이다.
      WM 코드 룰의 정본 집행자는 .github/scripts/wm-rule-gate.ps1 (pre-push + CI) 이다.
    -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>none</AnalysisLevel>
    <!-- 소스는 Assets 아래 한 벌뿐 — 여기로 복사하지 않는다(사본 = drift). -->
    <SdkSourceRoot>$(MSBuildThisFileDirectory)../DomainSDK/</SdkSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(SdkSourceRoot)**/*.cs" />
  </ItemGroup>

</Project>
