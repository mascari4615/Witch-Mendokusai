#!/usr/bin/env bash
# WM pre-push hook — 「내가 안 만진 줄이 왜 바뀌었나」를 기계가 본다.
#
# WHY (2026-08-06, TASK-WM-205 / WM-207 실측): 세션이 옛 사본을 든 작업트리로 커밋하면
# 앞선 커밋의 일이 통째로 되돌아간다. 두 번 났고 합계 파일 135개다:
#   - 54a3da61 (경고 정리)      : .cs 57개 되돌림, 58건이 그대로 살아남음
#   - 8e9381d9 (개척 마수 수정) : 파일 77개 삭제 — Phase 0 계약 코드가 **넉 달** 사라져 있었다
# 둘 다 커밋 메시지에 그 얘기가 없고, **되돌림이 자기완결적이라 컴파일도 통과한다.**
# 그래서 사람 눈으로는 안 잡힌다. 푸시 전이 마지막 값싼 관문이다.
#
# NOT A BLOCKER: 항상 exit 0. 의도적 `git revert` 도 같은 모양으로 걸리기 때문에
# 막으면 거짓 차단이 된다. 거짓 차단은 게이트를 죽인다(사람이 무시하기 시작한다).
# 대신 **눈에 띄게 말하고 지나간다** — 진짜였으면 푸시 직후 되돌리면 된다.
#
# 이 자리는 새로 만든 게 아니라 `.github/scripts/wm-rule-gate.ps1` 머리말이 이미
# 「로컬 seam = .git hook pre-push」라고 적어둔 곳이다. 그동안 install 이 안 깔았을 뿐.
# (rule-gate 도 여기 같이 물리면 좋다 — 그건 그 소유자 판단.)
#
# 설치: powershell -File Tools/git-hooks/install.ps1

set -u

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
audit="$repo_root/.github/scripts/wm-revert-audit.sh"
[ -f "$audit" ] || exit 0

# 푸시 범위가 너무 크면(첫 푸시·대형 머지) 건너뛴다 — 훅이 몇 분씩 잡으면 다음엔 --no-verify 를 쓴다.
MAX_COMMITS=20

flagged=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
	# 브랜치 삭제 푸시
	case "$local_sha" in *[!0]*) ;; *) continue ;; esac

	case "$remote_sha" in
		*[!0]*) range="$remote_sha..$local_sha" ;;
		*)      range="$local_sha" ;;   # 새 브랜치 — 상한만큼만
	esac

	commits=$(git rev-list --no-merges -n "$MAX_COMMITS" "$range" 2>/dev/null) || continue
	[ -z "$commits" ] && continue

	for sha in $commits; do
		out=$(bash "$audit" "$sha" 2>/dev/null) || true
		still=$(printf '%s' "$out" | sed -n 's/.*아직 되돌아가 있음 \([0-9]*\)건.*/\1/p' | head -1)
		[ -z "${still:-}" ] && continue
		[ "$still" -eq 0 ] && continue

		if [ "$flagged" -eq 0 ]; then
			echo ""
			echo "[wm-pre-push] ★ 이 푸시에 **다른 커밋의 일을 되돌린** 커밋이 있다:"
			flagged=1
		fi
		echo "[wm-pre-push]   $(git log -1 --format='%h %s' "$sha" | cut -c1-72)"
		echo "[wm-pre-push]     되돌아간 파일 ${still}개 — 자세히: bash .github/scripts/wm-revert-audit.sh $sha"
	done
done

if [ "$flagged" -eq 1 ]; then
	echo "[wm-pre-push]"
	echo "[wm-pre-push]   의도한 revert 면 그대로 두면 된다(막지 않는다)."
	echo "[wm-pre-push]   아니면 = 작업트리가 옛 사본을 들고 있었다는 뜻 — 푸시 직후 되돌릴 것."
	echo "[wm-pre-push]   정본: memo/automation-debt-ledger.md § 푸시 전 「내가 안 만진 줄이 왜 바뀌었나」"
	echo ""
fi

exit 0
