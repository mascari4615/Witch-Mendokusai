<Project Sdk="Microsoft.NET.Sdk">

  <!--
    대화 시스템의 순수 로직을 **유니티 없이** 컴파일·실행한다 (TASK-WM-052).

    ★ 소스를 복사하지 않는다 — 아래 Compile Include 가 저장소의 *진짜 파일*을 그대로 문다.
      그래서 코드가 바뀌면 여기도 같이 바뀐다(사본이 낡아 거짓 초록을 내는 일이 없다).
      가짜인 것은 `stubs/` 뿐이다: UnityEngine 최소 대역 · NUnit 최소 대역 · 게임 쪽 인터페이스 몇 개.

    ⚠ 무엇을 보장하지 *않는가* (README 참조):
      직렬화 · 에셋 임포트 · MonoBehaviour 수명주기 · PlayMode. 그건 유니티 run_tests 가 정본이다.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DialogueHarness</AssemblyName>
    <RootNamespace>DialogueHarness</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0414;CS0169;CS0649;CS0108;CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="stubs/*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

  <!-- 진짜 게임 소스 (복사 X) -->
  <ItemGroup>
    <Compile Include="../../Assets/_WitchMendokusai/Domain/Narrative/**/*.cs" />
    <Compile Include="../../Assets/_WitchMendokusai/Domain/Data/NodeGraph/NodeBase.cs" />
    <Compile Include="../../Assets/_WitchMendokusai/Domain/Data/NodeGraph/NodePort.cs" />
    <Compile Include="../../Assets/_WitchMendokusai/Domain/Data/NodeGraph/NodeGraph.cs" />
    <Compile Include="../../Assets/_WitchMendokusai/Domain/Data/NodeGraph/NodeExecutionContext.cs" />
    <Compile Include="../../Assets/_WitchMendokusai/Domain/Data/Effect/Base/EffectInfo.cs" />
    <Compile Include="../../Assets/_WitchMendokusai/Core/Scripts/NodeGraph/FlowSignal.cs" />
    <Compile Include="../../Assets/_WitchMendokusai/Core/Scripts/NodeGraph/NodeConnection.cs" />
    <Compile Include="../../Assets/_WitchMendokusai/Core/Scripts/NodeGraph/NodeDomain.cs" />
    <Compile Include="../../Assets/_WitchMendokusai/Core/Scripts/NodeGraph/NodeGraphValidationResult.cs" />
    <Compile Include="../../Assets/_WitchMendokusai/DomainSDK/Criteria/Criteria.cs" />
    <Compile Include="../../Assets/_WitchMendokusai/DomainSDK/Criteria/ICriteria.cs" />
    <Compile Include="../../Assets/_WitchMendokusai/DomainSDK/Effect/EffectType.cs" />
    <Compile Include="../../Assets/_WitchMendokusai/DomainSDK/Common/ArithmeticOperator.cs" />
    <!-- 엔진 무관 수학·좌표 (TASK-WM-214) — SDK 소스가 UnityEngine 대신 이걸 문다. -->
    <Compile Include="../../Assets/_WitchMendokusai/DomainSDK/Numerics/*.cs" />
    <Compile Include="../../Assets/_WitchMendokusai/DomainSDK/Quest/QuestState.cs" />
  </ItemGroup>

  <!-- 진짜 EditMode 시험 파일 (복사 X — 「시험을 썼다」가 아니라 「시험이 돈다」) -->
  <ItemGroup>
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/Dialogue*Test.cs" />
    <!-- 시험 도우미 — 이름이 *Test.cs 로 안 끝나니 따로 문다. Awake 를 양쪽 세계에서 같은 자리에서 부른다. -->
    <Compile Include="../../Assets/_WitchMendokusai/Tests/EditMode/DialogueTestHost.cs" />
  </ItemGroup>

  <!-- MonoBehaviour·에디터 의존이라 유니티 밖에서 못 서는 것들 -->
  <ItemGroup>

    <Compile Remove="../../Assets/_WitchMendokusai/Domain/Narrative/Scripts/DialogueSpeakerTag.cs" />
    <!-- 가방(Inventory)에 붙는 얇은 어댑터 — 게임 타입이라 유니티 밖에서는 못 선다(안쪽 조건은 시험됨). -->
    <!-- 퀘스트 관리자에 붙는 어댑터도 같은 이유로 제외(조건 자체는 시험된다 — 그래서 파일을 갈랐다). -->
    <!-- 에디터 자산 데이터베이스를 쓰는 시험 — 유니티 안에서만 뜻이 있다(거기선 CI 가 돌린다). -->
    <Compile Remove="../../Assets/_WitchMendokusai/Tests/EditMode/DialogueShippedScriptTests.cs" />
    <!-- 저장 왕복 시험 — Json.NET 과 GameData(게임 전역 타입)를 쓴다. 유니티 안에서만 뜻이 있다. -->
    <Compile Remove="../../Assets/_WitchMendokusai/Tests/EditMode/DialogueHistorySaveRoundTripTests.cs" />
  </ItemGroup>

</Project>
