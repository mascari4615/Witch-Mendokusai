# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio (Code) cache directory
.vs/
.vsconfig
.vscode/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj

# ⚠ 위 `*.csproj` 는 <b>유니티가 만드는</b> 것들을 막는 규칙이다. 그런데 손으로 쓴 프로젝트도
#   같이 삼킨다 — 2026-08-20 에 `Portable/DomainSDK.Wasm/DomainSDK.Wasm.csproj` 가 그렇게
#   사라져, 소스 4개만 커밋되고 프로젝트 파일만 빠졌다. 그 결과 `WM server deploy` 가
#   30판 내리 `MSB1009: 프로젝트 파일이 없습니다` 로 죽었다(만든 사람 기계에만 있던 파일).
#   손으로 쓰는 프로젝트가 사는 두 곳은 <b>예외로 박는다</b> — 다시 조용히 사라지지 않게.
!Portable/**/*.csproj
!Server/**/*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
#*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
# 빌드가 만드는 링커 보존 목록 — 원격에 없고 열 때마다 다시 생긴다 (TASK-KAR-215)
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/link.xml*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- ---- ---- ----

# Never ignore DLLs in the FMOD subfolder.
!/[Aa]ssets/Plugins/FMOD/**/lib/*

# Don't ignore images and gizmos used by FMOD in the Unity Editor.
!/[Aa]ssets/Gizmos/FMOD/*
!/[Aa]ssets/Editor Default Resources/FMOD/*

# Ignore the Cache folder since it is updated locally.
/[Aa]ssets/Plugins/FMOD/Cache/*

# Ignore bank files in the StreamingAssets folder.
/[Aa]ssets/StreamingAssets/**/*.bank
/[Aa]ssets/StreamingAssets/**/*.bank.meta

# If the source bank files are kept outside of the StreamingAssets folder then these can be ignored.
# Log files can be ignored.
fmod_editor.log


# FMOD files
/Assets/Plugins/FMOD/Resources/FMODStudioCache.asset
# /Assets/Plugins/FMOD*

/FMODAssets/.cache/*

/FMODAssets/Assets/PROTODOME/PROTODOME - 4000AD
!/FMODAssets/Assets/PROTODOME/PROTODOME - BLUENOISE
/FMODAssets/Assets/PROTODOME/PROTODOME - BLUESCREEN
/FMODAssets/Assets/PROTODOME/PROTODOME - BLUESHIFT
/FMODAssets/Assets/PROTODOME/PROTODOME - CHIPFUNK
/FMODAssets/Assets/PROTODOME/PROTODOME - Computer Music 2020-2023
/FMODAssets/Assets/PROTODOME/PROTODOME - FAMIFOOD
/FMODAssets/Assets/PROTODOME/PROTODOME - SUPER CHIPFUNK

# ---- ---- ---- ----

/Assets/StreamingAssets/build_info*

Assets/PlayFabEditorExtensions/Editor/Resources/PlayFabEditorPrefsSO*
Assets/PlayFabSDK/Shared/Public/Resources/PlayFabSharedSettings*

# Rainbow Folders 2, Rainbow Hierachy 2
/Assets/Plugins/Borodar*
/Assets/Plugins/Unity-Logs-Viewer*
/Assets/AssetKits*
/Assets/Samples*

Bakery
bakery_times.log
# *.hdr*

# ---- ---- ---- ----

/Assets/_WitchMendokusai/Sprites*

WM.json*

# Claude Code worktrees
/.claude/worktrees/

# Local editor and shell crash artifacts
bash.exe.stackdump*

# Shader pack build output (TASK-WM-055 P1-F)
/Shaderpacks_Output/

.worktrees
/Assets/initTestScene*
# 검증 스크린샷 (로컬 산출물)
/Assets/Screenshots/
/Assets/Screenshots.meta

# Unity 강제 종료 뒤 남는 씬 복구본 — 남의 미저장 편집이 공개 레포로 새는 자리다.
/Assets/_Recovery/
/Assets/_Recovery.meta

# 웹어셈블리 판정 산출물 (TASK-WM-411) — 소스는 DomainSDK 하나뿐이고 이건 구워 낸 것이다.
# 배포 때 워크플로가 다시 굽는다(저장소에 5MB 짜리 바이너리를 넣지 않는다).
Server/WM.Server/wwwroot/versus/_framework/
