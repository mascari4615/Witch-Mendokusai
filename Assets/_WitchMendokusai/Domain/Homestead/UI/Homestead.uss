/* 생활 화면. 무대, 판, 꺾쇠, 분류 띠와 색은 상점 것 (Shop.uss) 을 그대로 쓰고 안쪽만 */

.wm-hs--none {
    display: none;
}

/* 머리 */
.wm-hs__head {
    position: absolute;
    left: 40px;
    top: 24px;
    height: 64px;
    flex-direction: row;
    align-items: center;
}

.wm-hs__head-icon {
    width: 64px;
    height: 64px;
    margin-right: 14px;
    background-color: var(--wm-shop-slot-lit);
    border-width: 2px;
    border-color: var(--wm-shop-line-soft);
    -unity-background-scale-mode: scale-to-fit;
}

.wm-hs__head-title {
    font-size: 38px;
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: var(--wm-shop-outline-color);
    padding: 0;
    margin-top: 4px;
    margin-right: 20px;
}

.wm-hs__head-status {
    font-size: 20px;
    color: var(--wm-shop-soft);
    margin-top: 8px;
}

/* 손가락 닫기. 냥 띠 왼쪽 */
.wm-hs__close {
    position: absolute;
    left: 1330px;
    top: 28px;
    width: 196px;
    height: 56px;
    flex-direction: row;
    align-items: center;
    padding: 4px 26px 2px 26px;
}

.wm-hs__close .wm-hs__action-name {
    -unity-text-align: middle-center;
}

/* 목록 */
.wm-hs__list {
    left: 40px;
    top: 166px;
    width: 1090px;
    height: 838px;
}

.wm-hs__list-body {
    padding: 16px;
}

.wm-hs__list-content {
    flex-direction: column;
}

.wm-hs__list-content--grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 1048px;
}

.wm-hs__empty {
    position: absolute;
    left: 40px;
    right: 40px;
    top: 120px;
    color: var(--wm-shop-faint);
    font-size: 22px;
    -unity-text-align: upper-center;
    white-space: normal;
}

.wm-hs__cell {
    width: 144px;
    height: 144px;
    margin-right: 5px;
    margin-bottom: 5px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.36);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0);
}

.wm-hs__cell-image {
    width: 96px;
    height: 96px;
    margin-top: -14px;
    -unity-background-scale-mode: scale-to-fit;
}

.wm-hs__cell-stand {
    position: absolute;
    left: 34px;
    right: 34px;
    bottom: 32px;
    height: 3px;
    background-color: var(--wm-shop-line-soft);
}

.wm-hs__cell-count {
    position: absolute;
    right: 8px;
    bottom: 4px;
    font-size: 20px;
    color: var(--wm-shop-value);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--wm-shop-outline-color);
    padding: 0;
}

.wm-hs__cell--dim .wm-hs__cell-image {
    opacity: 0.35;
}

.wm-hs__cell--unknown .wm-hs__cell-image {
    -unity-background-image-tint-color: rgb(0, 0, 0);
    opacity: 0.55;
}

.wm-hs__cell--marked .wm-hs__cell-stand {
    background-color: var(--wm-shop-value);
}

.wm-hs__row {
    flex-direction: row;
    align-items: center;
    height: 92px;
    margin-bottom: 6px;
    padding: 0 18px 0 12px;
    background-color: rgba(0, 0, 0, 0.36);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0);
    flex-shrink: 0;
}

.wm-hs__row-box {
    width: 70px;
    height: 70px;
    margin-right: 16px;
    align-items: center;
    justify-content: center;
    background-color: var(--wm-shop-slot-lit);
    border-width: 1px;
    border-color: var(--wm-shop-line-soft);
    flex-shrink: 0;
}

.wm-hs__row-image {
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
}

.wm-hs__row-texts {
    flex-grow: 1;
    flex-shrink: 1;
}

.wm-hs__row-name {
    font-size: 23px;
}

.wm-hs__row-sub {
    margin-top: 4px;
    font-size: 18px;
    color: var(--wm-shop-soft);
    white-space: normal;
}

.wm-hs__row-count {
    font-size: 21px;
    color: var(--wm-shop-value);
    margin-left: 14px;
    -unity-text-align: middle-right;
}

.wm-hs__row--dim .wm-hs__row-image {
    opacity: 0.4;
}

.wm-hs__row--dim .wm-hs__row-name {
    color: var(--wm-shop-faint);
}

.wm-hs__row--dim .wm-hs__row-sub {
    color: var(--wm-shop-faint);
}

.wm-hs__mark {
    position: absolute;
    right: 6px;
    top: 6px;
    width: 14px;
    height: 14px;
    rotate: 45deg;
    background-color: var(--wm-shop-value);
}

.wm-hs__entry--on {
    background-color: rgba(255, 255, 255, 0.025);
    border-color: rgb(255, 255, 255);
}

/* 상세 */
.wm-hs__detail {
    left: 1150px;
    top: 166px;
    width: 730px;
    height: 838px;
}

.wm-hs__detail-body {
    padding: 22px 26px;
}

.wm-hs__detail-head {
    flex-direction: row;
    align-items: center;
    min-height: 112px;
    flex-shrink: 0;
}

.wm-hs__detail-icon-box {
    width: 112px;
    height: 112px;
    margin-right: 20px;
    align-items: center;
    justify-content: center;
    background-color: var(--wm-shop-slot-lit);
    border-width: 2px;
    border-color: var(--wm-shop-line-soft);
    flex-shrink: 0;
}

.wm-hs__detail-icon {
    width: 96px;
    height: 96px;
    -unity-background-scale-mode: scale-to-fit;
}

.wm-hs__detail-texts {
    flex-grow: 1;
    flex-shrink: 1;
}

.wm-hs__detail-title {
    font-size: 30px;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--wm-shop-outline-color);
    padding: 0;
}

.wm-hs__detail-note {
    margin-top: 6px;
    font-size: 19px;
    color: var(--wm-shop-soft);
    white-space: normal;
}

.wm-hs__bar {
    height: 30px;
    margin-top: 16px;
    background-color: rgb(13, 11, 17);
    border-width: 2px;
    border-color: var(--wm-shop-line-soft);
    flex-shrink: 0;
}

.wm-hs__bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(43, 117, 115);
}

.wm-hs__bar-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 17px;
    -unity-text-align: middle-center;
}

.wm-hs__lines {
    margin-top: 14px;
}

.wm-hs__line {
    font-size: 20px;
    white-space: normal;
    padding: 6px 4px;
    border-bottom-width: 1px;
    border-color: var(--wm-shop-row-line);
}

.wm-hs__cost-title {
    margin-top: 18px;
    font-size: 19px;
    color: var(--wm-shop-soft);
}

.wm-hs__costs {
    margin-top: 6px;
    flex-direction: row;
    flex-wrap: wrap;
}

.wm-hs__cost {
    width: 334px;
    height: 46px;
    flex-direction: row;
    align-items: center;
    padding-right: 14px;
    border-bottom-width: 1px;
    border-color: var(--wm-shop-row-line);
}

.wm-hs__cost-icon {
    width: 36px;
    height: 36px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.wm-hs__cost-name {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 19px;
    overflow: hidden;
}

.wm-hs__cost-value {
    font-size: 19px;
    color: var(--wm-shop-up);
}

.wm-hs__cost--no .wm-hs__cost-value {
    color: var(--wm-shop-no);
}

.wm-hs__spring {
    flex-grow: 1;
}

.wm-hs__actions {
    flex-direction: column;
    flex-shrink: 0;
}

.wm-hs__action {
    min-height: 58px;
    margin-top: 8px;
    flex-direction: row;
    align-items: center;
    padding: 4px 26px 2px 26px;
}

.wm-hs__action-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --wm-slant: 14;
    --wm-slant-fill: rgb(35, 32, 44);
    --wm-slant-tile-opacity: 0;
}

.wm-hs__action--on .wm-hs__action-fill {
    --wm-slant-fill: var(--wm-shop-teal-dark);
    --wm-slant-tile: url("../../UI/Survival/Art/tile-count.png");
    --wm-slant-tile-size: 50;
    --wm-slant-tile-opacity: 0.11;
}

.wm-hs__action-name {
    font-size: 23px;
    flex-grow: 1;
}

.wm-hs__action--no .wm-hs__action-name {
    color: var(--wm-shop-faint);
}

.wm-hs__action-reason {
    font-size: 18px;
    color: var(--wm-shop-no);
    margin-left: 14px;
    white-space: normal;
    max-width: 380px;
    -unity-text-align: middle-right;
}

.wm-hs__pop {
    position: absolute;
    right: 48px;
    top: 96px;
    font-size: 28px;
    color: var(--wm-shop-value);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: var(--wm-shop-outline-color);
    padding: 0;
    translate: 0 0;
    opacity: 1;
    transition-property: translate, opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.wm-hs__pop--warning {
    color: var(--wm-shop-no);
}

.wm-hs__pop--exit {
    translate: 0 -20px;
    opacity: 0;
}

/* 방 꾸미기 */
.wm-hs-room__palette {
    left: 40px;
    top: 112px;
    width: 520px;
    height: 892px;
}

.wm-hs-room__palette-body {
    padding: 16px;
}

.wm-hs-room__palette-content {
    flex-direction: column;
}

.wm-hs-room__palette-empty {
    color: var(--wm-shop-faint);
    font-size: 20px;
    white-space: normal;
    -unity-text-align: upper-center;
    padding: 60px 20px;
}

.wm-hs-room__floor {
    left: 580px;
    top: 112px;
    width: 1300px;
    height: 892px;
}

.wm-hs-room__floor-body {
    padding: 18px 24px;
}

.wm-hs-room__comfort {
    flex-shrink: 0;
}

.wm-hs-room__comfort-text {
    font-size: 21px;
}

.wm-hs-room__comfort .wm-hs__bar {
    height: 14px;
    margin-top: 8px;
}

.wm-hs-room__plan-box {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 20px 0 14px 0;
    align-items: center;
    justify-content: center;
}

.wm-hs-room__shape--rug-round {
    border-radius: 50%;
}

.wm-hs-room__plan {
    -unity-background-image-tint-color: rgb(168, 126, 98);
    background-repeat: repeat;
    background-size: 220px 220px;
    border-top-width: 10px;
    border-left-width: 6px;
    border-right-width: 6px;
    border-bottom-width: 4px;
    border-color: rgb(224, 214, 204);
}

.wm-hs-room__door {
    position: absolute;
    left: 50%;
    bottom: -4px;
    width: 90px;
    height: 8px;
    margin-left: -45px;
    background-color: var(--wm-shop-value);
}

.wm-hs-room__piece {
    position: absolute;
    align-items: center;
    justify-content: center;
    background-color: rgba(52, 38, 52, 0.82);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.6);
}

.wm-hs-room__piece--rug {
    background-color: rgba(150, 92, 112, 0.6);
}

.wm-hs-room__piece--wall {
    background-color: rgba(60, 74, 104, 0.86);
}

.wm-hs-room__piece-icon {
    width: 56px;
    height: 56px;
    max-width: 92%;
    max-height: 92%;
    -unity-background-scale-mode: scale-to-fit;
}

/* 앞면 표시 */
.wm-hs-room__piece-front {
    position: absolute;
    left: 25%;
    right: 25%;
    bottom: 2px;
    height: 3px;
    background-color: var(--wm-shop-value);
    opacity: 0.8;
}

.wm-hs-room__piece--on {
    border-width: 3px;
    border-color: rgb(255, 255, 255);
}

.wm-hs-room__piece--held {
    border-width: 3px;
    border-color: var(--wm-shop-up);
    opacity: 0.92;
}

.wm-hs-room__piece--no {
    border-color: var(--wm-shop-no);
    background-color: rgba(118, 23, 48, 0.8);
}

.wm-hs-room__hint {
    height: 30px;
    font-size: 20px;
    color: var(--wm-shop-soft);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.wm-hs-room__buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 8px;
    flex-shrink: 0;
}

.wm-hs-room__button {
    width: 220px;
    height: 52px;
    margin: 0 6px;
    align-items: center;
    justify-content: center;
    padding-top: 3px;
}

.wm-hs-room__button .wm-hs__action-name {
    flex-grow: 0;
    font-size: 20px;
}

.wm-hs-room__button:hover .wm-hs__action-fill {
    --wm-slant-fill: var(--wm-shop-teal-dark);
}

/* 들에서 보는 알림 */
.wm-hs-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url("../../../Fonts/갈무리/Galmuri11-Bold.ttf");
    color: rgb(241, 241, 243);
}

.wm-hs-hud--none {
    display: none;
}

.wm-hs-hud--out {
    opacity: 0;
}

.wm-hs-hud Label {
    margin: 0;
    padding: 0;
}

.wm-hs-hud__feed {
    position: absolute;
    right: 24px;
    bottom: 150px;
    align-items: flex-end;
}

.wm-hs-hud__feed-row {
    flex-direction: row;
    align-items: center;
    height: 36px;
    margin-top: 4px;
    padding: 0 12px 0 6px;
    background-color: rgba(15, 12, 20, 0.78);
    border-left-width: 3px;
    border-color: rgb(84, 78, 99);
    transition-property: opacity;
    transition-duration: 0.25s;
}

.wm-hs-hud__feed-row--new {
    border-color: rgb(242, 226, 122);
    background-color: rgba(44, 36, 18, 0.88);
}

.wm-hs-hud__feed-icon {
    width: 32px;
    height: 32px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.wm-hs-hud__feed-name {
    font-size: 15px;
}

.wm-hs-hud__feed-new {
    font-size: 12px;
    margin-left: 8px;
    padding: 2px 5px 1px 5px;
    color: rgb(13, 13, 17);
    background-color: rgb(242, 226, 122);
}

.wm-hs-hud__feed-count {
    font-size: 16px;
    margin-left: 10px;
    color: rgb(242, 226, 122);
}

.wm-hs-hud__notices {
    position: absolute;
    left: 50%;
    top: 96px;
    width: 420px;
    margin-left: -210px;
    align-items: center;
}

.wm-hs-hud__notice {
    width: 420px;
    min-height: 72px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    padding: 8px 16px;
    background-color: rgba(23, 19, 29, 0.92);
    border-width: 2px;
    border-color: rgb(227, 227, 230);
    transition-property: opacity;
    transition-duration: 0.25s;
}

.wm-hs-hud__notice-icon {
    width: 56px;
    height: 56px;
    margin-right: 14px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.wm-hs-hud__notice-texts {
    flex-grow: 1;
    flex-shrink: 1;
}

.wm-hs-hud__notice-title {
    font-size: 19px;
    color: rgb(242, 226, 122);
}

.wm-hs-hud__notice-text {
    margin-top: 3px;
    font-size: 15px;
    white-space: normal;
}

.wm-hs-hud__digest {
    position: absolute;
    left: 24px;
    top: 220px;
}

.wm-hs-hud__digest-card {
    min-width: 300px;
    padding: 12px 18px 12px 14px;
    background-color: rgba(23, 19, 29, 0.9);
    border-width: 2px;
    border-color: rgb(84, 78, 99);
    transition-property: opacity;
    transition-duration: 0.25s;
}

.wm-hs-hud__digest-title {
    font-size: 17px;
    color: rgb(242, 226, 122);
    margin-bottom: 6px;
}

.wm-hs-hud__digest-row {
    flex-direction: row;
    align-items: center;
    height: 36px;
}

.wm-hs-hud__digest-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.wm-hs-hud__digest-text {
    font-size: 15px;
}

.wm-hs-hud__duel {
    position: absolute;
    left: 50%;
    bottom: 190px;
    width: 460px;
    margin-left: -230px;
    padding: 12px 18px 16px 18px;
    background-color: rgba(23, 19, 29, 0.9);
    border-width: 2px;
    border-color: rgb(84, 78, 99);
}

.wm-hs-hud__duel--surge {
    border-color: rgb(255, 141, 130);
}

.wm-hs-hud__duel-hint {
    font-size: 18px;
    -unity-text-align: middle-center;
    height: 28px;
}

.wm-hs-hud__duel-hint--bite {
    font-size: 24px;
    color: rgb(242, 226, 122);
}

.wm-hs-hud__duel-progress {
    height: 18px;
    margin-top: 12px;
    background-color: rgb(13, 11, 17);
    border-width: 2px;
    border-color: rgb(84, 78, 99);
}

.wm-hs-hud__duel-progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(95, 176, 212);
}

.wm-hs-hud__duel-icon {
    position: absolute;
    top: -14px;
    width: 40px;
    height: 40px;
    margin-left: -20px;
    -unity-background-scale-mode: scale-to-fit;
}

.wm-hs-hud__duel-tension {
    height: 22px;
    margin-top: 14px;
    background-color: rgb(13, 11, 17);
    border-width: 2px;
    border-color: rgb(84, 78, 99);
}

.wm-hs-hud__duel-sweet {
    position: absolute;
    top: 0;
    bottom: 0;
    background-color: rgba(154, 209, 98, 0.32);
}

.wm-hs-hud__duel-tension-fill {
    position: absolute;
    left: 0;
    top: 5px;
    bottom: 5px;
    background-color: rgb(180, 177, 192);
}

.wm-hs-hud__duel-tension-fill--sweet {
    background-color: rgb(154, 209, 98);
}

.wm-hs-hud__duel-tension-fill--danger {
    background-color: rgb(255, 141, 130);
}

.wm-hs-hud__mine {
    position: absolute;
    left: 24px;
    top: 220px;
    width: 280px;
    padding: 12px 16px;
    background-color: rgba(23, 19, 29, 0.9);
    border-width: 2px;
    border-color: rgb(84, 78, 99);
}

.wm-hs-hud__mine-depth {
    font-size: 19px;
    color: rgb(242, 226, 122);
}

.wm-hs-hud__mine-lantern {
    height: 24px;
    margin-top: 8px;
    background-color: rgb(13, 11, 17);
    border-width: 2px;
    border-color: rgb(84, 78, 99);
}

.wm-hs-hud__mine-lantern-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(204, 136, 52);
}

.wm-hs-hud__mine-lantern-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 14px;
    -unity-text-align: middle-center;
}

.wm-hs-hud__mine-hint {
    margin-top: 8px;
    font-size: 14px;
    color: rgb(180, 177, 192);
    white-space: normal;
}

.wm-hs-hud__goal {
    position: absolute;
    right: 24px;
    top: 84px;
    padding: 8px 12px 8px 10px;
    background-color: rgba(15, 12, 20, 0.62);
    border-right-width: 3px;
    border-color: rgb(242, 226, 122);
}

.wm-hs-hud__goal-title {
    font-size: 15px;
    color: rgb(242, 226, 122);
    -unity-text-align: middle-right;
    margin-bottom: 4px;
}

.wm-hs-hud__goal-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    height: 26px;
}

.wm-hs-hud__goal-icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.wm-hs-hud__goal-value {
    font-size: 14px;
    min-width: 70px;
    -unity-text-align: middle-right;
}

.wm-hs-hud__goal-value--done {
    color: rgb(154, 209, 98);
}

/* 건설 막대. 상점 판 문법: 판은 짙은 결 + 밝은 테두리 2px, 칸은 상점 칸 (검정 0.36) + 그림 상자 (slot-lit, 테두리 1px).
   루트에 wm-shop 클래스가 붙어 상점 색 이름을 씀 (VillageBuildHud). 그 클래스의 화면 가득 자리는 아래에서 되돌림 */
.wm-hs-build__root {
    position: absolute;
    left: 0;
    right: 0;
    top: auto;
    bottom: 18px;
    align-items: center;
}

.wm-hs-build__hint {
    font-size: 17px;
    padding: 5px 16px;
    margin-bottom: 8px;
    color: var(--wm-shop-ink);
    background-color: rgba(0, 0, 0, 0.88);
}

.wm-hs-build__hint--no {
    color: var(--wm-shop-no);
}

.wm-hs-build__bar {
    flex-direction: row;
    padding: 8px;
    background-color: rgb(23, 19, 29);
    border-width: 2px;
    border-color: var(--wm-shop-line);
}

.wm-hs-build__slot {
    width: 92px;
    height: 104px;
    margin: 3px;
    padding: 4px 2px 5px 2px;
    align-items: center;
    justify-content: flex-end;
    background-color: rgba(0, 0, 0, 0.36);
    /* 상점 칸은 테두리가 없음. 자리 (2px) 는 글자 넘침 시험이 재는 안쪽 폭 그대로 두려고 남기고 색만 지움 */
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.wm-hs-build__icon {
    width: 48px;
    height: 48px;
    min-height: 28px;
    flex-shrink: 1;
    margin-bottom: 3px;
    background-color: var(--wm-shop-slot-lit);
    border-width: 1px;
    border-color: var(--wm-shop-line-soft);
    -unity-background-scale-mode: scale-to-fit;
}

.wm-hs-build__slot:hover {
    background-color: rgba(255, 255, 255, 0.022);
}

.wm-hs-build__slot:hover .wm-hs-build__icon {
    border-color: var(--wm-shop-line);
}

.wm-hs-build__slot--held {
    background-color: rgba(255, 255, 255, 0.022);
}

.wm-hs-build__slot--held .wm-hs-build__icon {
    border-color: var(--wm-shop-value);
}

.wm-hs-build__slot--poor {
    opacity: 0.5;
}

.wm-hs-build__number {
    position: absolute;
    left: 6px;
    top: 3px;
    font-size: 14px;
    color: var(--wm-shop-value);
}

/* 칸 글자. 재료는 한 줄에 하나 (BuildSlotText). 줄이 늘면 그림이 줄어 자리를 내줌. 글자는 줄지 않음 */
.wm-hs-build__name {
    font-size: 15px;
    color: var(--wm-shop-ink);
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    white-space: normal;
    -unity-text-align: middle-center;
}

.wm-hs-build__cost {
    font-size: 12px;
    color: var(--wm-shop-soft);
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    white-space: normal;
    -unity-text-align: middle-center;
}

.wm-hs-build__tool {
    height: 104px;
    margin: 3px;
    padding: 0 14px;
    justify-content: center;
    font-size: 15px;
    color: var(--wm-shop-soft);
    background-color: rgba(0, 0, 0, 0.36);
    border-width: 1px;
    border-color: var(--wm-shop-line-soft);
}

.wm-hs-build__tool:hover {
    color: var(--wm-shop-ink);
    border-color: var(--wm-shop-line);
}

.wm-hs-build__tool:disabled {
    opacity: 0.4;
}

/* 건설 하는 일 버튼 줄. 손가락이 누르는 자리라 높이를 손끝에 맞춤. 키 글자는 KeyHint 가 손가락 모드에서 숨김 */
.wm-hs-build__tools {
    flex-direction: row;
    margin-bottom: 6px;
    padding: 4px;
    background-color: rgb(23, 19, 29);
    border-width: 2px;
    border-color: var(--wm-shop-line);
}

.wm-hs-build__tools .wm-hs-build__tool {
    height: 64px;
    min-width: 88px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.wm-hs-build__key {
    margin-left: 6px;
    font-size: 13px;
    color: var(--wm-shop-value);
}

/* 꾸미기. 손가락 전용 건설 입구. 왼쪽 스틱 위 빈자리 */
.wm-hs-hud__decorate {
    position: absolute;
    left: 36px;
    top: 38%;
    min-width: 96px;
    height: 64px;
    padding: 0 18px;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(245, 240, 250);
    background-color: rgba(15, 12, 20, 0.78);
    border-width: 2px;
    border-color: rgb(242, 226, 122);
    border-radius: 18px;
    -unity-text-align: middle-center;
}

/* 낚시 손가락 버튼. 누르는 동안 감김. 오른손 엄지 자리
   bottom 은 오른쪽 아래 기본 HUD (13/13, 냥 칸, 아래에서 약 98 까지) 위로. 낚시 중엔 평소 버튼이 숨어 이 자리가 빔 */
.wm-hs-fish__touch {
    position: absolute;
    right: 48px;
    bottom: 120px;
    align-items: flex-end;
}

.wm-hs-fish__reel {
    width: 168px;
    height: 168px;
    border-radius: 84px;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(245, 240, 250);
    background-color: rgba(15, 12, 20, 0.8);
    border-width: 3px;
    border-color: rgb(242, 226, 122);
}

.wm-hs-fish__reel--held {
    background-color: rgba(242, 226, 122, 0.42);
}

.wm-hs-fish__reel--bite {
    border-color: rgb(255, 141, 130);
    color: rgb(242, 226, 122);
}

.wm-hs-fish__stop {
    margin-bottom: 14px;
    min-width: 112px;
    height: 56px;
    padding: 0 16px;
    font-size: 18px;
    -unity-text-align: middle-center;
    color: rgb(245, 240, 250);
    background-color: rgba(15, 12, 20, 0.72);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    border-radius: 16px;
}
