  m_Script: {fileID: 11500000, guid: 882aa489341ccbb4986d8ade6774ca92, type: 3}
  m_Name: "MGE_1_\uD2B9\uC218\uC2DC\uACF5\uAC1C\uCC99"
  m_EditorClassIdentifier: WM.Domain::WitchMendokusai.MinigameEntrySO
  <ID>k__BackingField: 1
  <Name>k__BackingField: "\uD2B9\uC218\uC2DC\uACF5 \uAC1C\uCC99"
  <Description>k__BackingField: "\uD2B9\uC218\uC2DC\uACF5\uC740 \uD2F0\uBA54\uD1A0\uC758
    \uC5F0\uAD6C\uC18C\uAC00 \uB9CC\uB4E4\uC5B4\uB0B8 \uAC00\uC0C1 \uC2DC\uBBAC\uB808\uC774\uC158
    \uC138\uACC4\uB2E4.\n\n\uC790\uC6D0 \uB178\uB4DC \uC704\uC5D0 \uCC44\uC9D1 \uC778\uD615\uC744
    \uC138\uC6CC \uC218\uC785\uC744 \uB298\uB9AC\uACE0, \uAE38\uBAA9\uC5D0 \uD3EC\uD0D1
    \uC778\uD615\uC744 \uC138\uC6CC \uBAB0\uB824\uC624\uB294 \uB9C8\uC218\uB97C \uB9C9\uB294\uB2E4.
    \uB178\uB4DC\uAC00 \uBA40\uC218\uB85D \uBC8C\uC774\uB294 \uC88B\uC9C0\uB9CC \uC9C0\uCF1C\uC57C
    \uD560 \uBC29\uC5B4\uC120\uB3C4 \uAE38\uC5B4\uC9C4\uB2E4.\n\n\uB05D\uC740 \uC5C6\uB2E4.
    \uBA87 \uD30C\uAE4C\uC9C0 \uBC84\uD2F0\uB294\uC9C0\uAC00 \uACE7 \uAE30\uB85D\uC774\uB2E4."
  <Sprite>k__BackingField: {fileID: 0}
  <Sprites>k__BackingField: []
  <TargetGameMode>k__BackingField: 6
  <Tagline>k__BackingField: "\uD2F0\uBA54\uD1A0 \uC5F0\uAD6C\uC18C\uAC00 \uB9CC\uB4E0
    \uAC00\uC0C1 \uC2DC\uBBAC\uB808\uC774\uC158 \uC138\uACC4. \uAC1C\uCC99\uD558\uACE0,
    \uBC29\uC5B4\uD558\uB77C."
