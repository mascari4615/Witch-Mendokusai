/* 상호작용 표시 한 줄. 패널 높이 800 기준, 서브컬처 선택지 줄 실측 (1080 값의 0.74배). 2026-11-17 */
.wm-interact-prompt {
    position: absolute;
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding: 0 22px 0 8px;
    background-color: rgba(10, 12, 30, 0.72);
    border-radius: 3px;
    opacity: 0;
    -unity-font-definition: url("../Dungeon/DungeonEntrance/Fonts/NotoSansKR-Regular.ttf");
    transition-property: opacity, translate;
    transition-duration: 0.15s;
    translate: -8px 0;
}

.wm-interact-prompt--visible {
    opacity: 1;
    translate: 0 0;
}

.wm-interact-prompt__key {
    width: 28px;
    height: 28px;
    margin: 0;
    padding: 0;
    font-size: 15px;
    color: rgb(16, 18, 40);
    background-color: rgb(244, 244, 248);
    border-radius: 4px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.wm-interact-prompt__divider {
    width: 1px;
    height: 24px;
    margin: 0 12px;
    background-color: rgba(255, 255, 255, 0.35);
}

.wm-interact-prompt__name {
    margin: 0;
    padding: 0;
    font-size: 18px;
    color: rgb(242, 243, 251);
    -unity-text-align: middle-left;
}

.wm-interact-prompt__role {
    margin: 0 0 0 8px;
    padding: 0;
    font-size: 13px;
    color: rgb(170, 175, 210);
    -unity-text-align: middle-left;
}
