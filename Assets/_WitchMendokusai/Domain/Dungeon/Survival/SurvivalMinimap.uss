/* 생존 던전 작은 지도 (SurvivalMinimap)
   구조: .wm-minimap (자리. HUD 층, 오른쪽 위 시간과 목표 패널 아래)
           __frame (원형 바탕과 테두리, 밖으로 나간 점은 잘림)
             __dots (코드가 점을 그림. 점 색은 아래 --wm-minimap-* 값)
             __player (가운데 내 위치)
   자리: 시간과 목표 패널 ([Panel] DungeonRuntime 의 [Block] Infos) 이 오른쪽 46px, 위 58px 부터 높이 340px 차지. 그 아래 여백 두고 둠
   점 색은 전투 띠 (Fx/Banner/Banner.uss) 와 화면 밖 표시의 정예 주황, 보스 진홍, 승리 금색과 같은 값 */

.wm-minimap {
    position: absolute;
    right: 46px;
    top: 300px;
    width: 168px;
    height: 168px;
}

.wm-minimap__frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
    border-radius: 100px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.35);
    background-color: rgba(14, 10, 16, 0.55);
}

.wm-minimap__dots {
    --wm-minimap-monster: rgba(236, 228, 232, 0.75);
    --wm-minimap-elite: rgb(255, 168, 64);
    --wm-minimap-boss: rgb(232, 44, 74);
    --wm-minimap-item: rgb(255, 214, 92);
    --wm-minimap-chest: rgb(255, 236, 160);

    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* 지도 아래 이번 판 냥 (맵 오브젝트 비용으로 쓰는 돈). 글자는 MapObjectSettings.RunNyangHudFormat */
.wm-minimap__run-nyang {
    position: absolute;
    left: -20px;
    right: -20px;
    top: 100%;
    margin-top: 6px;
    padding: 0;
    -unity-font-definition: url("../../../Fonts/갈무리/Galmuri11-Bold.ttf");
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(255, 236, 160);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1.4px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.95);
}

/* 내 위치: 가운데 흰 점과 어두운 테두리 */
.wm-minimap__player {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 10px;
    margin-left: -5px;
    margin-top: -5px;
    border-radius: 5px;
    border-width: 2px;
    border-color: rgba(14, 10, 16, 0.9);
    background-color: rgb(120, 220, 255);
}

/* 큰 지도 (SurvivalMinimap.MinimapLargeView 를 누르는 동안, 폰은 작은 지도 터치)
   구조: .wm-minimap-large (화면 전체 자리, 클릭 통과, 판을 가운데에)
           __frame (원형 판. 안쪽 맨 뒤에 BlurPanel 이 뒤 화면을 흐림. 점 색과 내 위치는 작은 지도와 같은 클래스)
   반경은 SurvivalFeelConfig.MinimapLargeRadius */
.wm-minimap-large {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.wm-minimap-large__frame {
    --wm-blur-tint: rgba(14, 10, 16, 0.6);

    width: 640px;
    height: 640px;
    overflow: hidden;
    border-radius: 320px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.4);
}

.wm-minimap-large__frame .wm-blur {
    border-radius: 320px;
}
