/* 화면 밖 정예와 보스 방향 표시 (SurvivalOffscreenMarkers)
   구조: .wm-offscreen (HUD 층 전체)
           __marker (자리, 거리 크기와 진하기. 코드가 left, top, scale, opacity 를 씀)
             __pop (처음 나타날 때 튐. 코드가 --shown 을 켬, 새 배정 때 --instant 로 전환 없이 되돌림)
               __pivot (방향 회전. 오른쪽이 0도)
                 __dot (화살촉 뒤 작은 점), __arrow-shade (어두운 테두리), __arrow (꺾쇠 화살촉)
   색은 전투 띠 (Fx/Banner/Banner.uss) 의 정예 주황, 보스 진홍과 같은 값 */

.wm-offscreen {
    --wm-offscreen-accent: rgb(255, 168, 64);
    --wm-offscreen-shade: rgba(14, 10, 16, 0.78);

    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.wm-offscreen__marker {
    position: absolute;
    width: 44px;
    height: 44px;
    margin-left: -22px;
    margin-top: -22px;
}

.wm-offscreen__marker--elite {
    --wm-offscreen-accent: rgb(255, 168, 64);
}

.wm-offscreen__marker--boss {
    --wm-offscreen-accent: rgb(232, 44, 74);
    --wm-offscreen-shade: rgba(30, 4, 10, 0.82);
}

.wm-offscreen__pop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    scale: 0.2 0.2;
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.24s, 0.12s;
    transition-timing-function: ease-out-back, ease-out;
}

.wm-offscreen__pop--shown {
    scale: 1 1;
    opacity: 1;
}

/* 새 배정 때 잠깐. 전환 없이 작은 상태로 즉시 되돌림 */
.wm-offscreen__pop--instant {
    transition-duration: 0s, 0s;
}

.wm-offscreen__pivot {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* 점: 꺾쇠 뒤, 화면 가운데 쪽 */
.wm-offscreen__dot {
    position: absolute;
    left: 4px;
    top: 50%;
    width: 11px;
    height: 11px;
    margin-top: -5.5px;
    border-radius: 6px;
    border-width: 2px;
    border-color: var(--wm-offscreen-shade);
    background-color: var(--wm-offscreen-accent);
}

/* 꺾쇠: 정사각형의 위와 오른쪽 두 변을 45도 돌려 오른쪽을 가리킴 */
.wm-offscreen__arrow,
.wm-offscreen__arrow-shade {
    position: absolute;
    top: 50%;
    rotate: 45deg;
}

.wm-offscreen__arrow-shade {
    right: 7px;
    width: 16px;
    height: 16px;
    margin-top: -8px;
    border-top-width: 6px;
    border-right-width: 6px;
    border-color: var(--wm-offscreen-shade);
}

.wm-offscreen__arrow {
    right: 9px;
    width: 12px;
    height: 12px;
    margin-top: -6px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-color: var(--wm-offscreen-accent);
}
