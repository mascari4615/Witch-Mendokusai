/* 아래 가운데 스킬창 (RunEquipmentHud). 마을은 스킬 칸만, 던전은 스킬 칸 + 장비
   칸 모양은 예전 uGUI 스킬 칸 ([Block] SkillSlot.prefab, World 씬 [Block] SkillBar) 실측 그대로 (사용자 2026-11-18 "기존 마름모 디자인 처럼")
     예전 값 (1080 기준, 프리팹 칸 70): 마름모 바탕 60 을 45도, 바탕색 (0.055, 0.161, 0.192, 0.784)
     아이콘 50 을 -45도로 되돌림, 테두리 UI_OutLine 9칸 늘이기 흰색 0.196 을 바탕의 1.2 배, 쿨다운 회색 (0.519, 0.519, 0.519, 0.588) 이 마름모 안 아래에서 차오름
     칸 중심 간격 94 (격자 칸 100, 간격 -6). 실제 화면 실측으로 확인 (scratchpad equip diamond-old-fhd)
   여기 값은 패널 기준 세로 800 으로 옮긴 값 (1080 값 x 0.7407)
   구조: .wm-run-equipment (자리)
           __skills (스킬 칸: Shift 이동, 좌클릭, 우클릭)
           __slots (고유 장비 + 보유 장비 칸)
             __slot > __frame (45도 마름모, 넘친 것 자름) > __icon (-45도), __cooldown
                    > __outline (45도 테두리), __level (레벨 숫자, 마름모 아래 꼭지 안)
                    > __remain (남은 초, 가운데), __state (상시, 위 꼭지), __frame 안 __flash (준비 순간 번쩍임)
   대기 표시는 스킬 칸과 장비 칸이 같은 부품 (사용자 2026-11-21 "얻은 장비들 스킬 칸에서 쿨타임 표시가 없잖아요") */

.wm-run-equipment {
    --wm-run-equipment-frame: rgba(14, 41, 49, 0.784);
    --wm-run-equipment-outline: rgba(255, 255, 255, 0.196);
    --wm-run-equipment-signature: rgba(255, 214, 120, 0.85);
    --wm-run-equipment-cooldown: rgba(132, 132, 132, 0.588);
    --wm-run-equipment-charge: rgba(70, 120, 170, 0.6);
    --wm-run-equipment-always: rgba(150, 230, 200, 1);
    /* 이 주기 (초) 보다 짧은 대기는 숫자와 번쩍임 없이 덮개만 (코드가 읽음) */
    --wm-run-equipment-number-min-interval: 1.5;
    /* 번쩍임을 켜 둔 시간 (밀리초, 코드가 읽음). 사라지는 시간은 __flash 의 transition */
    --wm-run-equipment-flash-hold-milliseconds: 60;
    /* 1초 아래 남은 시간 서식 (코드가 읽음, .NET 숫자 서식) */
    --wm-run-equipment-subsecond-format: "0.0";

    position: absolute;
    left: 50%;
    bottom: 25px;
    translate: -50% 0;
    flex-direction: row;
    align-items: flex-end;
}

.wm-run-equipment__skills,
.wm-run-equipment__slots {
    flex-direction: row;
}

.wm-run-equipment__skills {
    margin-right: 0;
}

.wm-run-equipment__slot {
    width: 52px;
    height: 52px;
    margin-left: 8.8px;
    margin-right: 8.8px;
    scale: 1 1;
    transition-property: scale;
    transition-duration: 0.18s;
    transition-timing-function: ease-out-back;
}

.wm-run-equipment__frame {
    position: absolute;
    left: 3.8px;
    top: 3.8px;
    width: 44.4px;
    height: 44.4px;
    rotate: 45deg;
    overflow: hidden;
    background-color: var(--wm-run-equipment-frame);
    opacity: 0.45;
}

.wm-run-equipment__slot--filled .wm-run-equipment__frame {
    opacity: 1;
}

.wm-run-equipment__icon {
    position: absolute;
    left: 3.7px;
    top: 3.7px;
    width: 37px;
    height: 37px;
    rotate: -45deg;
    -unity-background-scale-mode: scale-to-fit;
}

/* 남은 재사용 시간. 높이 % 는 코드가 매김. 마름모 안 아래 변에서 차오름 */
.wm-run-equipment__cooldown {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: var(--wm-run-equipment-cooldown);
}

.wm-run-equipment__outline {
    position: absolute;
    left: -0.65px;
    top: -0.65px;
    width: 53.3px;
    height: 53.3px;
    rotate: 45deg;
    background-image: url("../../../Core/UI/Common/Sprites/UI_OutLine.png");
    -unity-background-image-tint-color: var(--wm-run-equipment-outline);
    -unity-slice-scale: 0.62px;
}

.wm-run-equipment__slot--signature .wm-run-equipment__outline {
    -unity-background-image-tint-color: var(--wm-run-equipment-signature);
}

/* 새 장비 등장. 커졌다가 전환이 끝나면 클래스가 빠져 원래 크기로 */
.wm-run-equipment__slot--pop {
    scale: 1.15 1.15;
}

.wm-run-equipment__slot--pop .wm-run-equipment__outline {
    -unity-background-image-tint-color: rgba(255, 236, 160, 1);
}

/* 레벨 숫자: 마름모 아래 꼭지 안, 어두운 바탕 */
.wm-run-equipment__level {
    position: absolute;
    left: 50%;
    bottom: -2px;
    translate: -50% 0;
    min-width: 12px;
    padding: 0 2px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0.85);
    -unity-text-align: middle-center;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
}

/* 빈 칸과 스킬 칸은 레벨 없음 */
.wm-run-equipment__level--empty {
    display: none;
}

/* 충전형 (걸어서 차는 수첩, 멈춰서 차는 베개) 은 푸른 덮개 */
.wm-run-equipment__cooldown--charge {
    background-color: var(--wm-run-equipment-charge);
}

/* 준비 순간 번쩍임. --on 이 붙는 순간 바로 켜지고, 빠지면 0.35초에 걸쳐 사라짐 */
.wm-run-equipment__flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(255, 255, 255);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}

.wm-run-equipment__flash--on {
    opacity: 0.85;
    transition-duration: 0s;
}

/* 남은 초. 마름모 가운데, 아이콘 위. HD 에서도 읽히게 굵은 글자와 검은 테 */
.wm-run-equipment__remain {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1.4px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.95);
}

.wm-run-equipment__remain--empty {
    display: none;
}

/* 상시 장비 (대기 없음). 위 꼭지, 레벨 숫자와 같은 꼴에 다른 색 */
.wm-run-equipment__state {
    position: absolute;
    left: 50%;
    top: -4px;
    translate: -50% 0;
    padding: 0 2px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0.85);
    -unity-text-align: middle-center;
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--wm-run-equipment-always);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
}

.wm-run-equipment__state--empty {
    display: none;
}
