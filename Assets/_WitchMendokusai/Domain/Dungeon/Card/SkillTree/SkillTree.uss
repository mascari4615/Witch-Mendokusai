.wm-skilltree {
    --wm-skilltree-edge: rgb(78, 76, 86);
    --wm-skilltree-edge-open: rgb(227, 227, 230);
    --wm-skilltree-edge-width: 2;
    position: absolute;
    flex-direction: column;
    transform-origin: 0 0;
    color: rgb(241, 241, 243);
    -unity-font-definition: url("../../../../Fonts/갈무리/Galmuri11-Bold.ttf");
}

.wm-skilltree__band {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    height: 48px;
    padding-left: 12px;
    padding-right: 14px;
    background-color: rgb(29, 85, 83);
    border-width: 0;
    border-bottom-width: 3px;
    border-color: rgb(118, 23, 48);
}

.wm-skilltree__band-icon {
    width: 34px;
    height: 34px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.wm-skilltree__band-name {
    flex-grow: 1;
    font-size: 24px;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.wm-skilltree__value {
    color: rgb(242, 226, 122);
    font-size: 20px;
    -unity-text-align: middle-right;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.wm-skilltree__graph {
    flex-grow: 1;
    position: relative;
}

.wm-skilltree__edges {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.wm-skilltree__node {
    position: absolute;
    align-items: center;
    justify-content: center;
    scale: 1 1;
    opacity: 1;
    transition-property: scale, opacity;
    transition-duration: 0.16s, 0.16s;
    transition-timing-function: ease-out-back, ease-out;
}

.wm-skilltree__node--hidden {
    scale: 0.5 0.5;
    opacity: 0;
}

.wm-skilltree__node--focused {
    scale: 1.12 1.12;
}

.wm-skilltree__diamond {
    position: absolute;
    left: 15%;
    top: 15%;
    width: 70%;
    height: 70%;
    rotate: 45deg;
    background-color: rgb(20, 19, 25);
    border-width: 2px;
    border-color: rgb(78, 76, 86);
    transition-property: background-color, border-color;
    transition-duration: 0.2s, 0.2s;
}

.wm-skilltree__diamond-line {
    position: absolute;
    left: 3px;
    top: 3px;
    right: 3px;
    bottom: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
}

.wm-skilltree__focus {
    position: absolute;
    left: 4%;
    top: 4%;
    width: 92%;
    height: 92%;
    rotate: 45deg;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.1s;
}

.wm-skilltree__node--focused .wm-skilltree__focus {
    opacity: 1;
}

.wm-skilltree__burst {
    position: absolute;
    left: 4%;
    top: 4%;
    width: 92%;
    height: 92%;
    rotate: 45deg;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    opacity: 0;
    scale: 1 1;
}

.wm-skilltree__burst--play {
    opacity: 0;
    scale: 1.55 1.55;
    transition-property: scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.wm-skilltree__node--focused .wm-skilltree__burst {
    opacity: 0.8;
}

.wm-skilltree__node--focused .wm-skilltree__burst--play {
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.3s, 0.3s;
}

.wm-skilltree__icon {
    width: 46px;
    height: 46px;
    -unity-background-scale-mode: scale-to-fit;
}

/* 마름모 오른쪽 아래 빈 모서리 기준, 오른쪽으로 자람. 오른쪽 기준이면 긴 숫자(10/100)가 아이콘을 덮음 */
.wm-skilltree__stack {
    position: absolute;
    left: 78%;
    bottom: -6%;
    padding: 0;
    margin: 0;
    font-size: 16px;
    color: rgb(242, 226, 122);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.wm-skilltree__node--locked .wm-skilltree__icon {
    opacity: 0.25;
}

.wm-skilltree__node--open .wm-skilltree__icon {
    opacity: 0.75;
}

.wm-skilltree__node--count.wm-skilltree__node--open .wm-skilltree__diamond { border-color: rgb(87, 184, 180); }
.wm-skilltree__node--damage.wm-skilltree__node--open .wm-skilltree__diamond { border-color: rgb(224, 86, 111); }
.wm-skilltree__node--speed.wm-skilltree__node--open .wm-skilltree__diamond { border-color: rgb(224, 154, 46); }
.wm-skilltree__node--size.wm-skilltree__node--open .wm-skilltree__diamond { border-color: rgb(154, 209, 98); }
.wm-skilltree__node--advanced.wm-skilltree__node--open .wm-skilltree__diamond { border-color: rgb(95, 212, 255); }

.wm-skilltree__node--count.wm-skilltree__node--owned .wm-skilltree__diamond { background-color: rgb(29, 85, 83); border-color: rgb(87, 184, 180); }
.wm-skilltree__node--damage.wm-skilltree__node--owned .wm-skilltree__diamond { background-color: rgb(118, 23, 48); border-color: rgb(224, 86, 111); }
.wm-skilltree__node--speed.wm-skilltree__node--owned .wm-skilltree__diamond { background-color: rgb(111, 71, 6); border-color: rgb(224, 154, 46); }
.wm-skilltree__node--size.wm-skilltree__node--owned .wm-skilltree__diamond { background-color: rgb(63, 94, 28); border-color: rgb(154, 209, 98); }
.wm-skilltree__node--advanced.wm-skilltree__node--owned .wm-skilltree__diamond { background-color: rgb(16, 74, 104); border-color: rgb(95, 212, 255); }

.wm-skilltree__node--count.wm-skilltree__node--maxed .wm-skilltree__diamond { background-color: rgb(29, 85, 83); border-color: rgb(242, 226, 122); }
.wm-skilltree__node--damage.wm-skilltree__node--maxed .wm-skilltree__diamond { background-color: rgb(118, 23, 48); border-color: rgb(242, 226, 122); }
.wm-skilltree__node--speed.wm-skilltree__node--maxed .wm-skilltree__diamond { background-color: rgb(111, 71, 6); border-color: rgb(242, 226, 122); }
.wm-skilltree__node--size.wm-skilltree__node--maxed .wm-skilltree__diamond { background-color: rgb(63, 94, 28); border-color: rgb(242, 226, 122); }
.wm-skilltree__node--advanced.wm-skilltree__node--maxed .wm-skilltree__diamond { background-color: rgb(16, 74, 104); border-color: rgb(242, 226, 122); }

.wm-skilltree__node--offered .wm-skilltree__diamond-line {
    border-width: 2px;
    border-color: rgb(242, 226, 122);
    transition-property: border-color;
    transition-duration: 0.45s;
}

.wm-skilltree__node--pulse .wm-skilltree__diamond-line {
    border-color: rgba(242, 226, 122, 0.25);
}

.wm-skilltree__info {
    flex-shrink: 0;
    height: 214px;
    padding: 12px 16px;
    background-color: rgba(10, 9, 13, 0.55);
    border-width: 2px;
    border-color: rgb(227, 227, 230);
}

.wm-skilltree__info-line {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
}

.wm-skilltree__info-head {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.wm-skilltree__info-name {
    font-size: 24px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.wm-skilltree__info-text {
    flex-shrink: 0;
    font-size: 17px;
    white-space: normal;
    color: rgb(169, 168, 178);
    margin-bottom: 4px;
}
