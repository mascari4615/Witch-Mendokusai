/* 전투 화면 띠 (BannerFx). 정예와 무리와 보스 예고, 보스 이름, 승패, 던전 입장, 난이도 알림
   구조: .wm-banner (화면 전체)
           __tint, __vignette (화면 물들임과 가장자리 어둡게. 보스, 패배만 보임)
           __group (자리 잡기와 떠오르는 퇴장)
             __arcs > __arc (보스만 보임)
             __streak (비스듬한 빛줄기. 승리만 보임)
             __label (작은 분류 글)
             __rule--top (__rule-line, __diamond)
             __band (__title > __side--left, __char, __side--right, __subtitle). __side 는 패배만 보임
             __rule--bottom
   움직임: BannerFx 가 뿌리에 --in, --out 을, 글자에 --shown 을 실제 시간으로 켬. 여기 transition 이 그 사이를 채움
   transition 길이는 에셋의 enterSeconds, exitSeconds 안에 끝나는 값으로
   결 (2차, 2026-11-18): 상자 없음. 가운데 짙고 양 끝이 투명한 띠 위에 큰 글자, 양 끝이 사라지는 가는 선과 마름모
   그라데이션은 Art/ 의 흰색 알파 그림 (Tools/combat-fx-art/make-banner-art.mjs) 에 색을 입혀 만듦 */

.wm-banner {
    /* 종류마다 아래 변수만 바꿈 */
    --wm-banner-accent: rgb(255, 168, 64);
    --wm-banner-title: rgb(255, 244, 228);
    --wm-banner-ink-soft: rgb(222, 214, 206);
    --wm-banner-band: rgba(14, 10, 16, 0.92);
    --wm-banner-outline: rgb(18, 12, 16);
    --wm-banner-shadow: rgba(0, 0, 0, 0.7);
    --wm-banner-wash: rgba(0, 0, 0, 0);
    --wm-banner-shade: rgba(0, 0, 0, 0);
    --wm-banner-arc: rgba(255, 255, 255, 0);
    --wm-banner-streak: rgba(255, 255, 255, 0);

    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
    color: var(--wm-banner-title);
    -unity-font-definition: url("../../../../Fonts/갈무리/Galmuri11-Bold.ttf");
}

.wm-banner--in {
    opacity: 1;
}

.wm-banner--in.wm-banner--out {
    opacity: 0;
    transition-duration: 0.26s;
    transition-timing-function: ease-in;
}

/* ===== 화면 물들임과 가장자리 어둡게 ===== */

.wm-banner__tint,
.wm-banner__vignette {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.wm-banner__tint {
    background-color: var(--wm-banner-wash);
}

.wm-banner__vignette {
    background-image: url("Art/banner-vignette.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--wm-banner-shade);
}

/* ===== 묶음: 자리와 퇴장 움직임 ===== */

.wm-banner__group {
    position: absolute;
    left: 0;
    right: 0;
    top: 12%;
    flex-direction: column;
    align-items: center;
    translate: 0 10px;
    transition-property: translate;
    transition-duration: 0.36s;
    transition-timing-function: ease-out-cubic;
}

.wm-banner--in .wm-banner__group {
    translate: 0 0;
}

.wm-banner--in.wm-banner--out .wm-banner__group {
    translate: 0 -22px;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-cubic;
}

/* ===== 원호: 띠 가운데를 중심으로 겹친 가는 원. 보스만 보임 ===== */

.wm-banner__arcs {
    display: none;
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
}

.wm-banner__arc {
    position: absolute;
    width: 520px;
    height: 520px;
    left: -260px;
    top: -260px;
    background-image: url("Art/banner-arc.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--wm-banner-arc);
    opacity: 0;
    rotate: -50deg;
    scale: 0.82 0.82;
    transition-property: opacity, rotate, scale;
    transition-duration: 0.5s, 1.6s, 0.9s;
    transition-timing-function: ease-out, ease-out-cubic, ease-out-cubic;
}

.wm-banner__arc--2 {
    width: 680px;
    height: 680px;
    left: -340px;
    top: -340px;
    rotate: 70deg;
    transition-delay: 0.08s;
}

.wm-banner__arc--3 {
    width: 860px;
    height: 860px;
    left: -430px;
    top: -430px;
    rotate: -100deg;
    transition-delay: 0.16s;
}

.wm-banner--in .wm-banner__arc {
    opacity: 1;
    rotate: 0deg;
    scale: 1 1;
}

.wm-banner--in .wm-banner__arc--2 {
    opacity: 0.7;
    rotate: 20deg;
}

.wm-banner--in .wm-banner__arc--3 {
    opacity: 0.45;
    rotate: -30deg;
}

/* ===== 빛줄기: 화면을 비스듬히 가로지르는 얇은 띠. 승리만 보임 ===== */

.wm-banner__streak {
    display: none;
    position: absolute;
    left: -10%;
    right: -10%;
    top: 50%;
    height: 10px;
    margin-top: -5px;
    background-image: url("Art/banner-band.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--wm-banner-streak);
    rotate: -8deg;
    opacity: 0;
    translate: -45% 0;
    scale: 0.4 1;
    transition-property: opacity, translate, scale;
    transition-duration: 0.2s, 0.5s, 0.5s;
    transition-timing-function: ease-out, ease-out-cubic, ease-out-cubic;
}

.wm-banner--in .wm-banner__streak {
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

/* ===== 제목 양옆 가는 선. 패배만 보임 ===== */

.wm-banner__side {
    display: none;
    width: 180px;
    height: 2px;
    background-image: url("Art/banner-line.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--wm-banner-accent);
    scale: 0 1;
    transition-property: scale;
    transition-duration: 0.7s;
    transition-delay: 0.2s;
    transition-timing-function: ease-out-cubic;
}

.wm-banner__side--left {
    margin-right: 24px;
    transform-origin: 100% 50%;
}

.wm-banner__side--right {
    margin-left: 24px;
    transform-origin: 0% 50%;
}

.wm-banner--in .wm-banner__side {
    scale: 1 1;
}

/* ===== 분류 글: 자간이 넓게 퍼진 상태에서 좁혀지며 나타남 ===== */

.wm-banner__label {
    margin: 0 0 4px 0;
    padding: 0;
    font-size: 24px;
    letter-spacing: 22px;
    color: var(--wm-banner-accent);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--wm-banner-outline);
    text-shadow: 0 1px 4px var(--wm-banner-shadow);
    opacity: 0;
    transition-property: opacity, letter-spacing;
    transition-duration: 0.3s, 0.55s;
    transition-delay: 0.05s, 0s;
    transition-timing-function: ease-out, ease-out-cubic;
}

.wm-banner--in .wm-banner__label {
    opacity: 1;
    letter-spacing: 9px;
}

.wm-banner__label--empty {
    display: none;
}

/* ===== 가는 선과 마름모. 선은 가운데에서 양옆으로 펼쳐지고 양 끝이 사라짐 ===== */

.wm-banner__rule {
    width: 62%;
    height: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.wm-banner__rule--top {
    margin-bottom: 2px;
}

.wm-banner__rule--bottom {
    margin-top: 2px;
}

.wm-banner__rule-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 4px;
    height: 2px;
    background-image: url("Art/banner-line.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--wm-banner-accent);
    scale: 0 1;
    transition-property: scale;
    transition-duration: 0.45s;
    transition-delay: 0.06s;
    transition-timing-function: ease-out-cubic;
}

.wm-banner__diamond {
    width: 7px;
    height: 7px;
    background-color: var(--wm-banner-accent);
    rotate: 45deg;
    scale: 0 0;
    transition-property: scale;
    transition-duration: 0.22s;
    transition-delay: 0.2s;
    transition-timing-function: ease-out-back;
}

.wm-banner--in .wm-banner__rule-line {
    scale: 1 1;
}

.wm-banner--in .wm-banner__diamond {
    scale: 1 1;
}

/* ===== 띠: 가운데 짙고 양 끝 투명한 가로 그라데이션. 가운데에서 양옆으로 펼쳐짐 ===== */

.wm-banner__band {
    width: 76%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 8px 0;
    background-image: url("Art/banner-band.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--wm-banner-band);
    scale: 0 1;
    transition-property: scale;
    transition-duration: 0.34s;
    transition-timing-function: ease-out-cubic;
}

.wm-banner--in .wm-banner__band {
    scale: 1 1;
}

.wm-banner__title {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

/* 제목 글자 하나. BannerFx 가 순서대로 --shown 을 켬. 넓은 간격에서 좁혀지며 나타남 */
.wm-banner__char {
    margin: 0 9px;
    padding: 0;
    font-size: 34px;
    color: var(--wm-banner-title);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--wm-banner-outline);
    text-shadow: 0 2px 6px var(--wm-banner-shadow);
    opacity: 0;
    translate: 0 0;
    scale: 1 1;
    transition-property: opacity, margin-left, margin-right, translate, scale;
    transition-duration: 0.14s, 0.32s, 0.32s, 0.24s, 0.24s;
    transition-timing-function: ease-out, ease-out-cubic, ease-out-cubic, ease-out-back, ease-out-back;
}

.wm-banner__char--space {
    width: 12px;
}

.wm-banner__char--shown {
    margin: 0 1px;
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

.wm-banner__subtitle {
    margin: 0 0 0 22px;
    padding: 0;
    font-size: 19px;
    letter-spacing: 2px;
    color: var(--wm-banner-ink-soft);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--wm-banner-outline);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.24s;
    transition-delay: 0.24s;
    transition-timing-function: ease-out;
}

.wm-banner--in .wm-banner__subtitle {
    opacity: 1;
}

.wm-banner__subtitle--empty {
    display: none;
}

/* 제목 아래에 부제를 두는 변형들 */
.wm-banner--boss .wm-banner__band,
.wm-banner--victory .wm-banner__band,
.wm-banner--defeat .wm-banner__band,
.wm-banner--intro .wm-banner__band {
    flex-direction: column;
}

.wm-banner--boss .wm-banner__subtitle,
.wm-banner--victory .wm-banner__subtitle,
.wm-banner--defeat .wm-banner__subtitle,
.wm-banner--intro .wm-banner__subtitle {
    margin: 2px 0 0 0;
    letter-spacing: 5px;
}

/* ===== 정예 예고: 화면 위쪽, 주황 ===== */
/* 기본값이 곧 이 변형. 색만 다시 적음 */

.wm-banner--warning {
    --wm-banner-accent: rgb(255, 168, 64);
    --wm-banner-title: rgb(255, 244, 228);
    --wm-banner-band: rgba(16, 10, 8, 0.92);
}

/* ===== 대규모 무리 예고: 같은 자리, 붉은 주황, 더 넓고 두꺼운 띠, 눌러 찍듯 등장 ===== */

.wm-banner--swarm {
    --wm-banner-accent: rgb(255, 98, 52);
    --wm-banner-title: rgb(255, 238, 226);
    --wm-banner-band: rgba(72, 14, 6, 0.92);
}

.wm-banner--swarm .wm-banner__group {
    top: 11%;
}

.wm-banner--swarm .wm-banner__rule {
    width: 76%;
}

.wm-banner--swarm .wm-banner__rule-line {
    top: 3px;
    height: 4px;
}

.wm-banner--swarm .wm-banner__diamond {
    width: 9px;
    height: 9px;
}

.wm-banner--swarm .wm-banner__band {
    width: 90%;
    padding: 10px 0;
}

.wm-banner--swarm .wm-banner__char {
    font-size: 42px;
    -unity-text-outline-width: 1.5px;
    scale: 1.7 1.7;
}

.wm-banner--swarm .wm-banner__char--space {
    width: 15px;
}

.wm-banner--swarm .wm-banner__char--shown {
    scale: 1 1;
}

.wm-banner--swarm .wm-banner__subtitle {
    font-size: 22px;
}

/* ===== 보스 예고: 같은 높이대, 진홍 반투명 띠, 위아래 선 대신 사선 줄무늬 띠 (경고 테이프 결) ===== */
/* 줄무늬는 Art/banner-stripe.png. 반복 대신 넓게 굽고 tint 로 색 입힘 */

.wm-banner--bosswarn {
    --wm-banner-accent: rgb(232, 44, 74);
    --wm-banner-title: rgb(255, 242, 242);
    --wm-banner-ink-soft: rgb(240, 196, 200);
    --wm-banner-band: rgba(128, 6, 28, 0.62);
    --wm-banner-outline: rgb(30, 4, 10);
}

.wm-banner--bosswarn .wm-banner__group {
    top: 11%;
}

.wm-banner--bosswarn .wm-banner__rule {
    width: 84%;
    height: 10px;
    background-image: url("Art/banner-stripe.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--wm-banner-accent);
    scale: 0 1;
    transition-property: scale;
    transition-duration: 0.45s;
    transition-delay: 0.06s;
    transition-timing-function: ease-out-cubic;
}

.wm-banner--bosswarn.wm-banner--in .wm-banner__rule {
    scale: 1 1;
}

.wm-banner--bosswarn .wm-banner__rule--top {
    margin-bottom: 4px;
}

.wm-banner--bosswarn .wm-banner__rule--bottom {
    margin-top: 4px;
}

.wm-banner--bosswarn .wm-banner__rule-line,
.wm-banner--bosswarn .wm-banner__diamond {
    display: none;
}

.wm-banner--bosswarn .wm-banner__band {
    width: 92%;
    padding: 10px 0;
}

.wm-banner--bosswarn .wm-banner__char {
    margin: 0 12px;
    font-size: 50px;
    -unity-text-outline-width: 1.5px;
    scale: 1.5 1.5;
}

.wm-banner--bosswarn .wm-banner__char--space {
    width: 18px;
}

.wm-banner--bosswarn .wm-banner__char--shown {
    margin: 0 2px;
    scale: 1 1;
}

.wm-banner--bosswarn .wm-banner__subtitle {
    font-size: 22px;
}

/* ===== 보스 이름: 화면 가운데, 화면 전체 진홍으로 물들이고 가장자리 어둡게, 가장 큰 이름과 뒤의 원호 ===== */

.wm-banner--boss {
    --wm-banner-accent: rgb(232, 44, 74);
    --wm-banner-title: rgb(255, 246, 246);
    --wm-banner-ink-soft: rgb(240, 196, 200);
    --wm-banner-band: rgba(36, 2, 10, 0.92);
    --wm-banner-outline: rgb(30, 4, 10);
    --wm-banner-wash: rgba(140, 0, 28, 0.14);
    --wm-banner-shade: rgba(22, 0, 6, 0.82);
    --wm-banner-arc: rgba(255, 92, 112, 0.42);
}

.wm-banner--boss .wm-banner__tint,
.wm-banner--boss .wm-banner__vignette,
.wm-banner--boss .wm-banner__arcs {
    display: flex;
}

.wm-banner--boss .wm-banner__group {
    top: 17%;
    translate: 0 16px;
    transition-duration: 0.6s;
}

.wm-banner--boss.wm-banner--in .wm-banner__group {
    translate: 0 0;
}

.wm-banner--boss.wm-banner--in.wm-banner--out .wm-banner__group {
    translate: 0 -24px;
    transition-duration: 0.4s;
}

.wm-banner--boss .wm-banner__label {
    font-size: 28px;
    color: var(--wm-banner-ink-soft);
    letter-spacing: 30px;
}

.wm-banner--boss.wm-banner--in .wm-banner__label {
    letter-spacing: 14px;
}

.wm-banner--boss .wm-banner__rule {
    width: 70%;
}

.wm-banner--boss .wm-banner__rule-line {
    transition-duration: 0.7s;
    transition-delay: 0.12s;
}

.wm-banner--boss .wm-banner__band {
    width: 100%;
    padding: 12px 0 14px 0;
    transition-duration: 0.5s;
}

.wm-banner--boss .wm-banner__char {
    margin: 0 16px;
    font-size: 66px;
    -unity-text-outline-width: 2px;
    text-shadow: 0 3px 10px var(--wm-banner-shadow);
    translate: 0 14px;
    transition-duration: 0.2s, 0.5s, 0.5s, 0.4s, 0.4s;
}

.wm-banner--boss .wm-banner__char--space {
    width: 24px;
}

.wm-banner--boss .wm-banner__char--shown {
    margin: 0 3px;
    translate: 0 0;
}

.wm-banner--boss .wm-banner__subtitle {
    font-size: 22px;
}

/* ===== 승리: 굵게 기운 금색 큰 낱말이 한 번 번쩍, 뒤로 노란 빛줄기 ===== */

.wm-banner--victory {
    --wm-banner-accent: rgb(255, 214, 102);
    --wm-banner-title: rgb(255, 222, 120);
    --wm-banner-ink-soft: rgb(255, 240, 206);
    --wm-banner-band: rgba(30, 20, 6, 0.92);
    --wm-banner-outline: rgb(48, 24, 2);
    --wm-banner-shadow: rgba(255, 196, 64, 0.55);
    --wm-banner-streak: rgba(255, 220, 72, 0.42);
}

.wm-banner--victory .wm-banner__streak {
    display: flex;
    left: 14%;
    right: 14%;
}

/* 기울임 글꼴이 없어 묶음째 조금 돌려 기울어진 결을 냄 */
.wm-banner--victory .wm-banner__title {
    rotate: -4deg;
}

.wm-banner--victory .wm-banner__group {
    top: 13%;
}

.wm-banner--victory .wm-banner__rule {
    width: 66%;
}

.wm-banner--victory .wm-banner__band {
    width: 92%;
    padding: 8px 0 12px 0;
}

.wm-banner--victory .wm-banner__char {
    margin: 0 12px;
    font-size: 88px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px;
    text-shadow: 0 0 18px var(--wm-banner-shadow);
    scale: 1.9 1.9;
    transition-property: opacity, margin-left, margin-right, translate, scale, color;
    transition-duration: 0.1s, 0.3s, 0.3s, 0.3s, 0.32s, 0.6s;
    transition-timing-function: ease-out, ease-out-cubic, ease-out-cubic, ease-out-cubic, ease-out-back, ease-out;
}

.wm-banner--victory .wm-banner__char--space {
    width: 30px;
}

/* 흰색으로 번쩍 뜬 뒤 금색으로 가라앉음 */
.wm-banner--victory .wm-banner__char--shown {
    margin: 0 -4px;
    color: var(--wm-banner-title);
    scale: 1 1;
}

.wm-banner--victory .wm-banner__subtitle {
    font-size: 24px;
}

/* ===== 패배: 은회색 글자, 채도 낮은 붉은 물들임, 글자 양옆 붉은 선, 천천히 가라앉듯 ===== */

.wm-banner--defeat {
    --wm-banner-accent: rgb(176, 84, 84);
    --wm-banner-title: rgb(204, 206, 212);
    --wm-banner-ink-soft: rgb(170, 164, 166);
    --wm-banner-band: rgba(12, 8, 10, 0.92);
    --wm-banner-outline: rgb(12, 8, 10);
    --wm-banner-wash: rgba(72, 22, 26, 0.18);
    --wm-banner-shade: rgba(0, 0, 0, 0.72);
    transition-duration: 0.4s;
}

.wm-banner--defeat .wm-banner__tint,
.wm-banner--defeat .wm-banner__vignette,
.wm-banner--defeat .wm-banner__side {
    display: flex;
}

.wm-banner--defeat .wm-banner__group {
    top: 18%;
    translate: 0 -14px;
    transition-duration: 0.8s;
}

.wm-banner--defeat.wm-banner--in .wm-banner__group {
    translate: 0 0;
}

.wm-banner--defeat.wm-banner--in.wm-banner--out .wm-banner__group {
    translate: 0 -16px;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-cubic;
}

.wm-banner--defeat .wm-banner__rule {
    width: 56%;
}

.wm-banner--defeat .wm-banner__rule-line {
    transition-duration: 0.8s;
}

.wm-banner--defeat .wm-banner__band {
    width: 88%;
    padding: 8px 0 12px 0;
    transition-duration: 0.6s;
}

.wm-banner--defeat .wm-banner__char {
    margin: 0 14px;
    font-size: 74px;
    translate: 0 -10px;
    transition-duration: 0.3s, 0.6s, 0.6s, 0.5s, 0.5s;
    transition-timing-function: ease-out, ease-out-cubic, ease-out-cubic, ease-out-cubic, ease-out-cubic;
}

.wm-banner--defeat .wm-banner__char--space {
    width: 28px;
}

.wm-banner--defeat .wm-banner__char--shown {
    margin: 0 -3px;
    translate: 0 0;
}

.wm-banner--defeat .wm-banner__subtitle {
    font-size: 22px;
}

/* ===== 던전 입장: 차분한 청록빛 흰색, 스테이지 이름 ===== */

.wm-banner--intro {
    --wm-banner-accent: rgb(150, 226, 220);
    --wm-banner-title: rgb(246, 252, 252);
    --wm-banner-ink-soft: rgb(196, 230, 228);
    --wm-banner-band: rgba(6, 18, 22, 0.92);
    --wm-banner-outline: rgb(6, 16, 20);
}

.wm-banner--intro .wm-banner__group {
    top: 18%;
    transition-duration: 0.5s;
}

.wm-banner--intro .wm-banner__rule {
    width: 58%;
}

.wm-banner--intro .wm-banner__rule-line {
    transition-duration: 0.6s;
}

.wm-banner--intro .wm-banner__band {
    width: 84%;
    padding: 8px 0 10px 0;
    transition-duration: 0.45s;
}

.wm-banner--intro .wm-banner__char {
    margin: 0 12px;
    font-size: 50px;
}

.wm-banner--intro .wm-banner__char--space {
    width: 18px;
}

.wm-banner--intro .wm-banner__char--shown {
    margin: 0 2px;
}

.wm-banner--intro .wm-banner__subtitle {
    font-size: 19px;
}

/* ===== 난이도 알림: 청록, 작게. 위쪽 경고 띠와 겹치지 않는 자리 ===== */

.wm-banner--notice {
    --wm-banner-accent: rgb(84, 214, 204);
    --wm-banner-title: rgb(232, 252, 250);
    --wm-banner-ink-soft: rgb(170, 232, 226);
    --wm-banner-band: rgba(4, 20, 22, 0.92);
    --wm-banner-outline: rgb(4, 16, 18);
}

.wm-banner--notice .wm-banner__group {
    top: 24%;
}

.wm-banner--notice .wm-banner__label {
    font-size: 18px;
    letter-spacing: 14px;
}

.wm-banner--notice.wm-banner--in .wm-banner__label {
    letter-spacing: 6px;
}

.wm-banner--notice .wm-banner__rule {
    width: 36%;
    height: 8px;
}

.wm-banner--notice .wm-banner__rule-line {
    top: 3px;
}

.wm-banner--notice .wm-banner__diamond {
    width: 5px;
    height: 5px;
}

.wm-banner--notice .wm-banner__band {
    width: 46%;
    padding: 5px 0;
}

.wm-banner--notice .wm-banner__char {
    margin: 0 6px;
    font-size: 24px;
}

.wm-banner--notice .wm-banner__char--space {
    width: 9px;
}

.wm-banner--notice .wm-banner__char--shown {
    margin: 0 1px;
}

.wm-banner--notice .wm-banner__subtitle {
    margin-left: 16px;
    font-size: 17px;
}
