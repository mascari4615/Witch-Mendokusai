@import url("DungeonEntranceGosu.uss");
@import url("DungeonEntranceNight.uss");
@import url("DungeonEntranceCut.uss");

/* 던전 입장 전체 화면 공통 구조. 색과 글꼴과 그림은 테마 USS. 패널 높이 800 기준, 시안 1080 값의 0.74배 */
.wm-dungeon-entrance {
    padding: 0;
    -unity-font-definition: url("Fonts/NotoSansKR-Regular.ttf");
    -unity-background-scale-mode: scale-and-crop;
}

.wm-dungeon-entrance__backdrop-text,
.wm-dungeon-entrance__deco,
.wm-dungeon-entrance__number,
.wm-dungeon-entrance__mist,
.wm-dungeon-entrance__row-plate,
.wm-dungeon-entrance__row-pointer,
.wm-dungeon-entrance__row-number,
.wm-dungeon-entrance__enter-glow,
.wm-dungeon-entrance__enter-ring,
.wm-dungeon-entrance__enter-arrow {
    display: none;
}

.wm-dungeon-entrance__hero,
.wm-dungeon-entrance__mist,
.wm-dungeon-entrance__deco,
.wm-dungeon-entrance__backdrop-text,
.wm-dungeon-entrance__number {
    position: absolute;
}

.wm-dungeon-entrance__hero {
    -unity-background-scale-mode: scale-to-fit;
}

.wm-dungeon-entrance__deco {
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: stretch-to-fill;
}

.wm-dungeon-entrance__top {
    position: absolute;
    flex-direction: row;
    align-items: center;
}

.wm-dungeon-entrance__round {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.wm-dungeon-entrance__close {
    position: absolute;
}

.wm-dungeon-entrance__list {
    position: absolute;
}

.wm-dungeon-entrance__row {
    flex-direction: row;
    align-items: center;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
}

.wm-dungeon-entrance__row-plate {
    position: absolute;
}

.wm-dungeon-entrance__row-seal {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.wm-dungeon-entrance__row-icon {
    -unity-background-scale-mode: scale-to-fit;
}

.wm-dungeon-entrance__row-pointer {
    position: absolute;
}

.wm-dungeon-entrance__detail {
    position: absolute;
}

.wm-dungeon-entrance__card {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

.wm-dungeon-entrance__name,
.wm-dungeon-entrance__description {
    white-space: normal;
}

.wm-dungeon-entrance__name,
.wm-dungeon-entrance__description,
.wm-dungeon-entrance__header-text {
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
}

.wm-dungeon-entrance__header {
    flex-direction: row;
    align-items: center;
}

.wm-dungeon-entrance__header-line {
    flex-grow: 1;
    height: 1px;
}

.wm-dungeon-entrance__tiles {
    flex-direction: row;
    align-items: center;
}

.wm-dungeon-entrance .wm-rewards {
    flex-direction: row;
    flex-wrap: wrap;
}

.wm-dungeon-entrance .wm-slot__name {
    display: none;
}

.wm-dungeon-entrance .wm-rewards__stat {
    flex-direction: column-reverse;
    align-items: center;
    justify-content: center;
}

/* 냥과 경험치는 숫자 아래 재화 아이콘 (이름 글자 대신) */
.wm-dungeon-entrance .wm-rewards__stat .wm-slot__icon {
    display: flex;
    position: relative;
    left: auto;
    top: auto;
    right: auto;
    bottom: auto;
    width: 22px;
    height: 22px;
    margin: 2px 0 0 0;
    -unity-background-scale-mode: scale-to-fit;
}

.wm-dungeon-entrance .wm-rewards__stat .wm-slot__name {
    display: none;
}

.wm-dungeon-entrance .wm-rewards__stat .wm-slot__amount {
    position: relative;
    left: auto;
    right: auto;
    bottom: auto;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.wm-dungeon-entrance__monster-image {
    flex-grow: 1;
}

/* 제약 칸: 머리줄과 칩 줄이 버튼 하나. 누르면 설정 팝업 */
.wm-dungeon-constraint {
    flex-direction: column;
    margin: 0 -4px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    -unity-text-align: upper-left;
}

.wm-dungeon-constraint__risk {
    margin: 0 0 0 9px;
    padding: 0;
}

.wm-dungeon-constraint__chips {
    flex-direction: row;
    align-items: center;
}

.wm-dungeon-constraint__chip {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.wm-dungeon-constraint__chip-icon {
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.wm-dungeon-constraint__chip-value,
.wm-dungeon-constraint__edit {
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

.wm-dungeon-constraint__edit {
    position: absolute;
    right: 0;
    bottom: 0;
}

/* 제약 설정 팝업. 입장 창 틀 전체를 덮고 가운데 창 */
.wm-constraint-popup {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.wm-constraint-popup__head {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

.wm-constraint-popup__total {
    flex-direction: row;
    align-items: flex-end;
}

.wm-constraint-popup__grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.wm-constraint-popup__tile {
    align-items: center;
    margin: 0;
    padding: 0;
}

.wm-constraint-popup__tile-icon {
    -unity-background-scale-mode: scale-to-fit;
}

.wm-constraint-popup__tile-risk,
.wm-constraint-popup__tile-check {
    position: absolute;
}

.wm-constraint-popup__tile-check {
    display: none;
    background-image: url("/Assets/_WitchMendokusai/Domain/Item/Assets/_Common/Sprite/game-icons.net/check-mark.png");
    -unity-background-scale-mode: scale-to-fit;
}

.wm-constraint-popup__tile--on .wm-constraint-popup__tile-check {
    display: flex;
}

.wm-constraint-popup__title,
.wm-constraint-popup__total-label,
.wm-constraint-popup__total-value,
.wm-constraint-popup__tile-risk,
.wm-constraint-popup__tile-name,
.wm-constraint-popup__detail-name,
.wm-constraint-popup__detail-state,
.wm-constraint-popup__detail-text,
.wm-constraint-popup__summary {
    margin: 0;
    padding: 0;
}

.wm-constraint-popup__tile-name {
    white-space: nowrap;
    -unity-text-align: upper-center;
}

.wm-constraint-popup__detail-text {
    white-space: normal;
}

.wm-constraint-popup__foot {
    flex-direction: row;
    align-items: center;
}

.wm-constraint-popup__summary {
    flex-grow: 1;
}



.wm-dungeon-entrance__enter {
    position: absolute;
    flex-direction: row;
    align-items: center;
    margin: 0;
    padding: 0;
}

.wm-dungeon-entrance__enter-glow,
.wm-dungeon-entrance__enter-ring {
    position: absolute;
}

.wm-dungeon-entrance__enter-text,
.wm-dungeon-entrance__enter-arrow {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

/* 진행 방식 섹션: 모드 둘은 나란히 반씩, 위협 단계는 좌우 화살표와 효과 글. 색은 테마 USS */
.wm-dungeon-entrance__mode {
    flex-direction: row;
}

.wm-dungeon-entrance__mode-button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.wm-dungeon-entrance__threat {
    flex-direction: row;
    align-items: center;
}

.wm-dungeon-entrance__threat-steps {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.wm-dungeon-entrance__threat-step {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.wm-dungeon-entrance__threat-step--locked {
    opacity: 0.3;
}

.wm-dungeon-entrance__threat-level {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.wm-dungeon-entrance__threat-effect {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    white-space: normal;
}

/* 던전 대표 그림: 테마 캐릭터 자리 대신 화면 전체, 글 가독용 어둡게 */
.wm-dungeon-entrance__hero-scrim {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.wm-dungeon-entrance .wm-dungeon-entrance__hero--key-art {
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.wm-dungeon-entrance .wm-dungeon-entrance__hero-scrim.wm-dungeon-entrance__hero--key-art {
    display: flex;
}

.wm-dungeon-entrance .wm-dungeon-entrance__enter:focus,
.wm-dungeon-entrance .wm-dungeon-entrance__mode-button:focus,
.wm-dungeon-entrance .wm-dungeon-entrance__threat-step:focus,
.wm-dungeon-entrance .wm-dungeon-entrance__round:focus {
    border-width: 4px;
    border-color: rgb(255, 255, 255);
}

/* 오른쪽 정보 띠와 아래 여백 칸. 밤 테마만 씀 */
.wm-dungeon-entrance__band {
    display: none;
    position: absolute;
}

.wm-dungeon-entrance__spacer {
    flex-grow: 0;
}

/* 출현 적 줄 구조. 색과 크기는 테마 USS */
.wm-dungeon-foes {
    flex-direction: row;
}

.wm-dungeon-foes__foe {
    align-items: center;
}

.wm-dungeon-foes__pic {
    align-items: center;
    justify-content: center;
}

.wm-dungeon-foes__tag {
    position: absolute;
    left: 0;
    top: 0;
    margin: 0;
    -unity-text-align: middle-center;
}

.wm-dungeon-foes__name,
.wm-dungeon-foes__time {
    margin: 0;
    padding: 0;
    -unity-text-align: upper-center;
}
/* 제약 칸 칩과 설정 팝업 모양 (2026-11-18 사용자 "아이콘이랑 제약 수치 간단히, 누르면 설정 팝업"). 세 테마 공통, 밤 테마 색 기준. 꺼진 제약은 흐림 */
.wm-dungeon-entrance .wm-dungeon-constraint:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.wm-dungeon-entrance .wm-dungeon-constraint__risk {
    font-size: 12px;
    color: rgb(247, 227, 155);
}

.wm-dungeon-entrance .wm-dungeon-constraint__chip {
    height: 30px;
    margin-right: 8px;
    padding: 0 9px 0 5px;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 0 0 2px 0;
    border-color: rgb(247, 227, 155);
}

.wm-dungeon-entrance .wm-dungeon-constraint__chip--off {
    opacity: 0.35;
    border-color: rgba(0, 0, 0, 0);
}

.wm-dungeon-entrance .wm-dungeon-constraint__chip-icon {
    width: 22px;
    height: 22px;
    margin-right: 5px;
    -unity-background-image-tint-color: rgb(242, 243, 251);
}

.wm-dungeon-entrance .wm-dungeon-constraint__chip-value {
    font-size: 13px;
    color: rgb(242, 243, 251);
    -unity-font-style: bold;
}

.wm-dungeon-entrance .wm-dungeon-constraint__edit {
    bottom: 7px;
    font-size: 11px;
    color: rgb(150, 156, 200);
}

/* 제약 설정 팝업. 뒤 입장 창이 비치게 어두운 막만 (BlurPanel 은 게임 화면을 흐려 입장 창을 가림) */
.wm-dungeon-entrance .wm-constraint-popup {
    background-color: rgba(5, 6, 20, 0.72);
}

.wm-dungeon-entrance .wm-constraint-popup__dialog {
    width: 760px;
    padding: 28px;
    background-color: rgb(16, 18, 48);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
}

.wm-dungeon-entrance .wm-constraint-popup__dialog > .wm-constraint-popup__head {
    margin-bottom: 22px;
}

.wm-dungeon-entrance .wm-constraint-popup__title {
    font-size: 24px;
    color: rgb(255, 255, 255);
}

.wm-dungeon-entrance .wm-constraint-popup__total-label {
    margin-bottom: 7px;
    font-size: 13px;
    color: rgb(185, 189, 220);
}

.wm-dungeon-entrance .wm-constraint-popup__total-value {
    margin-left: 10px;
    font-size: 40px;
    color: rgb(247, 227, 155);
    -unity-font-style: bold;
}

.wm-dungeon-entrance .wm-constraint-popup__grid {
    margin: -8px;
}

.wm-dungeon-entrance .wm-constraint-popup__tile {
    width: 112px;
    height: 124px;
    margin: 8px;
    padding-top: 16px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 0;
}

.wm-dungeon-entrance .wm-constraint-popup__tile:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.wm-dungeon-entrance .wm-constraint-popup__tile--on,
.wm-dungeon-entrance .wm-constraint-popup__tile--on:hover {
    background-color: rgba(247, 227, 155, 0.18);
    border-color: rgb(247, 227, 155);
}

.wm-dungeon-entrance .wm-constraint-popup__tile-icon {
    width: 60px;
    height: 60px;
    -unity-background-image-tint-color: rgb(205, 211, 246);
}

.wm-dungeon-entrance .wm-constraint-popup__tile--on .wm-constraint-popup__tile-icon {
    -unity-background-image-tint-color: rgb(247, 227, 155);
}

.wm-dungeon-entrance .wm-constraint-popup__tile-risk {
    left: 0;
    top: 0;
    padding: 1px 6px;
    font-size: 12px;
    color: rgb(21, 23, 46);
    background-color: rgb(247, 227, 155);
    -unity-font-style: bold;
}

.wm-dungeon-entrance .wm-constraint-popup__tile-check {
    right: 6px;
    top: 6px;
    width: 18px;
    height: 18px;
    -unity-background-image-tint-color: rgb(247, 227, 155);
}

.wm-dungeon-entrance .wm-constraint-popup__tile-name {
    margin-top: 10px;
    font-size: 13px;
    color: rgb(228, 231, 255);
}

.wm-dungeon-entrance .wm-constraint-popup__detail {
    margin-top: 22px;
    min-height: 84px;
    padding: 12px 16px;
    background-color: rgba(255, 255, 255, 0.05);
}

.wm-dungeon-entrance .wm-constraint-popup__detail-name {
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.wm-dungeon-entrance .wm-constraint-popup__detail-state {
    font-size: 13px;
    color: rgb(247, 227, 155);
}

.wm-dungeon-entrance .wm-constraint-popup__detail-text {
    margin-top: 6px;
    font-size: 14px;
    color: rgb(196, 201, 236);
}

.wm-dungeon-entrance .wm-constraint-popup__foot {
    margin-top: 22px;
}

.wm-dungeon-entrance .wm-constraint-popup__summary {
    font-size: 14px;
    color: rgb(185, 189, 220);
}

.wm-dungeon-entrance .wm-constraint-popup__button {
    width: 128px;
    height: 42px;
    margin: 0 0 0 12px;
    font-size: 15px;
    color: rgb(242, 243, 251);
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    border-radius: 0;
}

.wm-dungeon-entrance .wm-constraint-popup__button:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.wm-dungeon-entrance .wm-constraint-popup__button--main {
    color: rgb(21, 23, 46);
    background-color: rgb(244, 244, 248);
    -unity-font-style: bold;
}

.wm-dungeon-entrance .wm-constraint-popup__button--main:hover {
    background-color: rgb(255, 255, 255);
}

/* 초점 테두리. 다른 입장 창 버튼과 같은 흰 테두리, 두께는 늘 잡아 두어 초점에 내용이 밀리지 않음 */
.wm-dungeon-entrance .wm-dungeon-constraint:focus,
.wm-dungeon-entrance .wm-constraint-popup__tile:focus,
.wm-dungeon-entrance .wm-constraint-popup__button:focus {
    border-color: rgb(255, 255, 255);
}
