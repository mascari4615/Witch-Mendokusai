@import url("DungeonEntranceGosu.uss");
@import url("DungeonEntranceNight.uss");
@import url("DungeonEntranceCut.uss");

/* 던전 입장 전체 화면 공통 구조. 색과 글꼴과 그림은 테마 USS. 패널 높이 800 기준, 시안 1080 값의 0.74배 */
.wm-dungeon-entrance {
    padding: 0;
    -unity-font-definition: url("Fonts/NotoSansKR-Regular.ttf");
    -unity-background-scale-mode: scale-and-crop;
}

.wm-dungeon-entrance__backdrop-text,
.wm-dungeon-entrance__deco,
.wm-dungeon-entrance__number,
.wm-dungeon-entrance__mist,
.wm-dungeon-entrance__row-plate,
.wm-dungeon-entrance__row-pointer,
.wm-dungeon-entrance__row-number,
.wm-dungeon-entrance__enter-glow,
.wm-dungeon-entrance__enter-ring,
.wm-dungeon-entrance__enter-arrow {
    display: none;
}

.wm-dungeon-entrance__hero,
.wm-dungeon-entrance__mist,
.wm-dungeon-entrance__deco,
.wm-dungeon-entrance__backdrop-text,
.wm-dungeon-entrance__number {
    position: absolute;
}

.wm-dungeon-entrance__hero {
    -unity-background-scale-mode: scale-to-fit;
}

.wm-dungeon-entrance__deco {
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: stretch-to-fill;
}

.wm-dungeon-entrance__top {
    position: absolute;
    flex-direction: row;
    align-items: center;
}

.wm-dungeon-entrance__round {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.wm-dungeon-entrance__close {
    position: absolute;
}

.wm-dungeon-entrance__list {
    position: absolute;
}

.wm-dungeon-entrance__row {
    flex-direction: row;
    align-items: center;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
}

.wm-dungeon-entrance__row-plate {
    position: absolute;
}

.wm-dungeon-entrance__row-seal {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

/* 목록 칸 최고 기록 배지. 이름 한 줄 아래 오른쪽 구석. 이름이 두 줄로 넘치면 겹칠 수 있음 (현재 이름은 한 줄) */
.wm-dungeon-entrance__row-record {
    position: absolute;
    right: 10px;
    bottom: 3px;
    margin: 0;
    padding: 0;
    font-size: 11px;
    opacity: 0.8;
}

.wm-dungeon-entrance__row-icon {
    -unity-background-scale-mode: scale-to-fit;
}

.wm-dungeon-entrance__row-pointer {
    position: absolute;
}

.wm-dungeon-entrance__detail {
    position: absolute;
}

.wm-dungeon-entrance__card {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

.wm-dungeon-entrance__name,
.wm-dungeon-entrance__description {
    white-space: normal;
}

.wm-dungeon-entrance__name,
.wm-dungeon-entrance__description,
.wm-dungeon-entrance__header-text {
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
}

.wm-dungeon-entrance__header {
    flex-direction: row;
    align-items: center;
}

.wm-dungeon-entrance__header-line {
    flex-grow: 1;
    height: 1px;
}

.wm-dungeon-entrance__tiles {
    flex-direction: row;
    align-items: center;
}

.wm-dungeon-entrance .wm-rewards {
    flex-direction: row;
    flex-wrap: wrap;
}

.wm-dungeon-entrance .wm-slot__name {
    display: none;
}

.wm-dungeon-entrance .wm-rewards__stat {
    flex-direction: column-reverse;
    align-items: center;
    justify-content: center;
}

/* 냥과 경험치는 숫자 아래 재화 아이콘 (이름 글자 대신) */
.wm-dungeon-entrance .wm-rewards__stat .wm-slot__icon {
    display: flex;
    position: relative;
    left: auto;
    top: auto;
    right: auto;
    bottom: auto;
    width: 22px;
    height: 22px;
    margin: 2px 0 0 0;
    -unity-background-scale-mode: scale-to-fit;
}

.wm-dungeon-entrance .wm-rewards__stat .wm-slot__name {
    display: none;
}

.wm-dungeon-entrance .wm-rewards__stat .wm-slot__amount {
    position: relative;
    left: auto;
    right: auto;
    bottom: auto;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.wm-dungeon-entrance__monster-image {
    flex-grow: 1;
}

/* 제약 칸: 머리줄과 칩 줄이 버튼 하나. 누르면 설정 팝업 */
.wm-dungeon-constraint {
    flex-direction: column;
    margin: 0 -4px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    -unity-text-align: upper-left;
}

.wm-dungeon-constraint__risk {
    margin: 0 0 0 9px;
    padding: 0;
}

.wm-dungeon-constraint__chips {
    flex-direction: row;
    align-items: center;
}

.wm-dungeon-constraint__chip {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.wm-dungeon-constraint__chip-icon {
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.wm-dungeon-constraint__chip-value,
.wm-dungeon-constraint__more,
.wm-dungeon-constraint__edit {
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

.wm-dungeon-constraint__edit {
    position: absolute;
    right: 0;
    bottom: 0;
}

.wm-dungeon-entrance__enter {
    position: absolute;
    flex-direction: row;
    align-items: center;
    margin: 0;
    padding: 0;
}

.wm-dungeon-entrance__enter-glow,
.wm-dungeon-entrance__enter-ring {
    position: absolute;
}

.wm-dungeon-entrance__enter-text,
.wm-dungeon-entrance__enter-arrow {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

/* 진행 방식 섹션: 모드 둘은 나란히 반씩, 위협 단계는 좌우 화살표와 효과 글. 색은 테마 USS */
.wm-dungeon-entrance__mode {
    flex-direction: row;
}

.wm-dungeon-entrance__mode-button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.wm-dungeon-entrance__threat {
    flex-direction: row;
    align-items: center;
}

.wm-dungeon-entrance__threat-steps {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.wm-dungeon-entrance__threat-step {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.wm-dungeon-entrance__threat-step--locked {
    opacity: 0.3;
}

.wm-dungeon-entrance__threat-level {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.wm-dungeon-entrance__threat-effect {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    white-space: normal;
}

/* 던전 대표 그림: 테마 캐릭터 자리 대신 화면 전체, 글 가독용 어둡게 */
.wm-dungeon-entrance__hero-scrim {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.wm-dungeon-entrance .wm-dungeon-entrance__hero--key-art {
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.wm-dungeon-entrance .wm-dungeon-entrance__hero-scrim.wm-dungeon-entrance__hero--key-art {
    display: flex;
}

.wm-dungeon-entrance .wm-dungeon-entrance__enter:focus,
.wm-dungeon-entrance .wm-dungeon-entrance__mode-button:focus,
.wm-dungeon-entrance .wm-dungeon-entrance__threat-step:focus,
.wm-dungeon-entrance .wm-dungeon-entrance__round:focus {
    border-width: 4px;
    border-color: rgb(255, 255, 255);
}

/* 오른쪽 정보 띠와 아래 여백 칸. 밤 테마만 씀 */
.wm-dungeon-entrance__band {
    display: none;
    position: absolute;
}

.wm-dungeon-entrance__spacer {
    flex-grow: 0;
}

/* 출현 적 줄 구조. 색과 크기는 테마 USS */
.wm-dungeon-foes {
    flex-direction: row;
}

.wm-dungeon-foes__foe {
    align-items: center;
}

.wm-dungeon-foes__pic {
    align-items: center;
    justify-content: center;
}

.wm-dungeon-foes__tag {
    position: absolute;
    left: 0;
    top: 0;
    margin: 0;
    -unity-text-align: middle-center;
}

.wm-dungeon-foes__name,
.wm-dungeon-foes__time {
    margin: 0;
    padding: 0;
    -unity-text-align: upper-center;
}
/* 제약 칸 칩과 설정 팝업 모양 (2026-11-18 사용자 "아이콘이랑 제약 수치 간단히, 누르면 설정 팝업"). 세 테마 공통, 밤 테마 색 기준. 꺼진 제약은 흐림 */
.wm-dungeon-entrance .wm-dungeon-constraint:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

/* 첫 클리어 전 잠김. 칩은 꺼진 모양, 눌러도 안 열려 강조 없음 */
.wm-dungeon-entrance .wm-dungeon-constraint--locked:hover {
    background-color: rgba(0, 0, 0, 0);
}

.wm-dungeon-entrance .wm-dungeon-constraint__risk {
    font-size: 12px;
    color: rgb(247, 227, 155);
}

.wm-dungeon-entrance .wm-dungeon-constraint__chip {
    height: 30px;
    margin-right: 8px;
    padding: 0 9px 0 5px;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 0 0 2px 0;
    border-color: rgb(247, 227, 155);
}

/* 칩 줄에 못 담은 켠 묶음 수 */
.wm-dungeon-entrance .wm-dungeon-constraint__more {
    font-size: 13px;
    color: rgb(247, 227, 155);
    -unity-font-style: bold;
}

.wm-dungeon-entrance .wm-dungeon-constraint__chip--off {
    opacity: 0.35;
    border-color: rgba(0, 0, 0, 0);
}

.wm-dungeon-entrance .wm-dungeon-constraint__chip-icon {
    width: 22px;
    height: 22px;
    margin-right: 5px;
    -unity-background-image-tint-color: rgb(242, 243, 251);
}

.wm-dungeon-entrance .wm-dungeon-constraint__chip-value {
    font-size: 13px;
    color: rgb(242, 243, 251);
    -unity-font-style: bold;
}

.wm-dungeon-entrance .wm-dungeon-constraint__edit {
    bottom: 7px;
    font-size: 11px;
    color: rgb(150, 156, 200);
}

/* 초점 테두리. 다른 입장 창 버튼과 같은 흰 테두리, 두께는 늘 잡아 두어 초점에 내용이 밀리지 않음 */
.wm-dungeon-entrance .wm-dungeon-constraint:focus {
    border-color: rgb(255, 255, 255);
}

/* 제약 설정 창 (2026-11-18 재설계). 바탕 불투명 (선형 색 공간에서 반투명 막은 뒤 글자가 비침). 화면 전체 메뉴 칸 (wm-space-menu, 가장자리 4vh), 왼쪽 정보 기둥 + 오른쪽 제약 표.
   정보 위계는 레퍼런스 실측 (memo wm/design/constraint-refs-20261118): 큰 위험도 숫자와 눈금, 단계별 줄 표, 켠 효과 목록, 아래 오른쪽 저장 */
.wm-dungeon-entrance .wm-constraint-popup {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(8, 9, 24);
}

.wm-dungeon-entrance .wm-constraint-popup__safe {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 창은 내용 폭 (기둥 300 + 사이 + 표 760) 에 맞추고 가운데 */
.wm-dungeon-entrance .wm-constraint-popup__body {
    flex-direction: row;
    justify-content: center;
}

.wm-dungeon-entrance .wm-constraint-popup__side {
    width: 300px;
    flex-shrink: 0;
    padding-right: 32px;
    border-width: 0 1px 0 0;
    border-color: rgba(255, 255, 255, 0.1);
}

.wm-dungeon-entrance .wm-constraint-popup__title,
.wm-dungeon-entrance .wm-constraint-popup__dungeon,
.wm-dungeon-entrance .wm-constraint-popup__risk-label,
.wm-dungeon-entrance .wm-constraint-popup__risk-value,
.wm-dungeon-entrance .wm-constraint-popup__side-header,
.wm-dungeon-entrance .wm-constraint-popup__reward-empty,
.wm-dungeon-entrance .wm-constraint-popup__reward-risk,
.wm-dungeon-entrance .wm-constraint-popup__reward-state,
.wm-dungeon-entrance .wm-constraint-popup__best,
.wm-dungeon-entrance .wm-constraint-popup__header,
.wm-dungeon-entrance .wm-constraint-popup__hint,
.wm-dungeon-entrance .wm-constraint-popup__row-head-label,
.wm-dungeon-entrance .wm-constraint-popup__row-head-value,
.wm-dungeon-entrance .wm-constraint-popup__tile-name,
.wm-dungeon-entrance .wm-constraint-popup__tile-block,
.wm-dungeon-entrance .wm-constraint-popup__detail-name,
.wm-dungeon-entrance .wm-constraint-popup__level-badge,
.wm-dungeon-entrance .wm-constraint-popup__detail-state,
.wm-dungeon-entrance .wm-constraint-popup__detail-text,
.wm-dungeon-entrance .wm-constraint-popup__effect-text,
.wm-dungeon-entrance .wm-constraint-popup__effect-empty {
    margin: 0;
    padding: 0;
}

.wm-dungeon-entrance .wm-constraint-popup__title {
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.wm-dungeon-entrance .wm-constraint-popup__dungeon {
    margin-top: 4px;
    font-size: 15px;
    color: rgb(185, 189, 220);
}

.wm-dungeon-entrance .wm-constraint-popup__risk {
    margin-top: 48px;
}

.wm-dungeon-entrance .wm-constraint-popup__risk-label {
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(185, 189, 220);
}

.wm-dungeon-entrance .wm-constraint-popup__risk-value {
    font-size: 96px;
    color: rgb(247, 227, 155);
    -unity-font-style: bold;
}

.wm-dungeon-entrance .wm-constraint-popup__risk-meter {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.wm-dungeon-entrance .wm-constraint-popup__risk-pip {
    width: 18px;
    height: 10px;
    margin: 0 4px 4px 0;
    background-color: rgba(255, 255, 255, 0.15);
}

.wm-dungeon-entrance .wm-constraint-popup__risk-pip--on {
    background-color: rgb(247, 227, 155);
}

.wm-dungeon-entrance .wm-constraint-popup__best {
    margin-top: 6px;
    font-size: 13px;
    color: rgb(185, 189, 220);
}

.wm-dungeon-entrance .wm-constraint-popup__side-header {
    margin-top: 40px;
    padding-bottom: 6px;
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(185, 189, 220);
    border-width: 0 0 1px 0;
    border-color: rgba(255, 255, 255, 0.12);
}

.wm-dungeon-entrance .wm-constraint-popup__rewards {
    flex-grow: 1;
    flex-shrink: 1;
    margin-top: 10px;
}

.wm-dungeon-entrance .wm-constraint-popup__reward-empty {
    margin-bottom: 10px;
    font-size: 13px;
    color: rgb(150, 156, 200);
    white-space: normal;
}

.wm-dungeon-entrance .wm-constraint-popup__reward {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    opacity: 0.5;
}

.wm-dungeon-entrance .wm-constraint-popup__reward--reached {
    opacity: 1;
}

/* 이미 받은 구간. 못 받는 구간보다 진하고 이번에 받을 구간보다 흐림 */
.wm-dungeon-entrance .wm-constraint-popup__reward--claimed {
    opacity: 0.75;
}

.wm-dungeon-entrance .wm-constraint-popup__reward-head {
    width: 84px;
    flex-shrink: 0;
}

.wm-dungeon-entrance .wm-constraint-popup__reward-risk {
    font-size: 13px;
    color: rgb(247, 227, 155);
}

.wm-dungeon-entrance .wm-constraint-popup__reward-state {
    font-size: 11px;
    color: rgb(185, 189, 220);
}

.wm-dungeon-entrance .wm-constraint-popup__reward--reached .wm-constraint-popup__reward-state {
    color: rgb(247, 227, 155);
}

/* 폭 760 은 표 6 열 (단계 머리 64 + 칸 110 x 6 + 안쪽 28) 과 짝. 바꾸면 UIDungeonConstraintPopup.MIN_COLUMNS 도 */
.wm-dungeon-entrance .wm-constraint-popup__main {
    width: 760px;
    flex-shrink: 0;
    margin-left: var(--wm-space-panel-gap);
}

.wm-dungeon-entrance .wm-constraint-popup__head {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 10px;
    padding-bottom: 6px;
    border-width: 0 0 1px 0;
    border-color: rgba(255, 255, 255, 0.12);
}

.wm-dungeon-entrance .wm-constraint-popup__header {
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(228, 231, 255);
    -unity-font-style: bold;
}

.wm-dungeon-entrance .wm-constraint-popup__hint {
    font-size: 12px;
    color: rgb(150, 156, 200);
}

/* 표 가로 스크롤 틀. 묶음 6 열 이하면 스크롤 막대 없음 */
.wm-dungeon-entrance .wm-constraint-popup__table-scroll {
    flex-shrink: 0;
}

.wm-dungeon-entrance .wm-constraint-popup__table {
    padding: 14px 14px 4px 14px;
    background-color: rgba(255, 255, 255, 0.04);
}

.wm-dungeon-entrance .wm-constraint-popup__row {
    flex-direction: row;
    margin-bottom: 10px;
}

.wm-dungeon-entrance .wm-constraint-popup__row-head {
    width: 64px;
    height: 106px;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.08);
}

.wm-dungeon-entrance .wm-constraint-popup__row-head-label {
    font-size: 11px;
    color: rgb(185, 189, 220);
}

.wm-dungeon-entrance .wm-constraint-popup__row-head-value {
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.wm-dungeon-entrance .wm-constraint-popup__tile,
.wm-dungeon-entrance .wm-constraint-popup__cell-empty {
    width: 100px;
    height: 106px;
    margin: 0 0 0 10px;
}

/* 빈 칸: 표 격자 모양 유지 */
.wm-dungeon-entrance .wm-constraint-popup__cell-empty {
    background-color: rgba(255, 255, 255, 0.025);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.wm-dungeon-entrance .wm-constraint-popup__tile {
    align-items: center;
    padding: 2px 4px 0 4px;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}

.wm-dungeon-entrance .wm-constraint-popup__tile:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.wm-dungeon-entrance .wm-constraint-popup__tile--on,
.wm-dungeon-entrance .wm-constraint-popup__tile--on:hover {
    background-color: rgb(247, 227, 155);
}

.wm-dungeon-entrance .wm-constraint-popup__tile--blocked {
    opacity: 0.4;
}

/* 아이콘은 칸 폭의 60% 이상 */
.wm-dungeon-entrance .wm-constraint-popup__tile-icon {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(220, 224, 250);
}

.wm-dungeon-entrance .wm-constraint-popup__tile--on .wm-constraint-popup__tile-icon {
    -unity-background-image-tint-color: rgb(21, 23, 46);
}

.wm-dungeon-entrance .wm-constraint-popup__tile-name {
    margin-top: 0;
    font-size: 12px;
    color: rgb(228, 231, 255);
    white-space: normal;
    -unity-text-align: upper-center;
}

.wm-dungeon-entrance .wm-constraint-popup__tile--on .wm-constraint-popup__tile-name {
    color: rgb(21, 23, 46);
    -unity-font-style: bold;
}

.wm-dungeon-entrance .wm-constraint-popup__tile-check {
    display: none;
    position: absolute;
    right: 4px;
    top: 4px;
    width: 20px;
    height: 20px;
    background-image: url("/Assets/_WitchMendokusai/Domain/Item/Assets/_Common/Sprite/game-icons.net/check-mark.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(21, 23, 46);
}

.wm-dungeon-entrance .wm-constraint-popup__tile--on .wm-constraint-popup__tile-check {
    display: flex;
}

.wm-dungeon-entrance .wm-constraint-popup__tile-block {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    font-size: 12px;
    color: rgb(255, 170, 170);
    background-color: rgba(60, 10, 20, 0.85);
    -unity-text-align: middle-center;
}

.wm-dungeon-entrance .wm-constraint-popup__tile--blocked .wm-constraint-popup__tile-block {
    display: flex;
}

.wm-dungeon-entrance .wm-constraint-popup__detail {
    margin-top: 14px;
    min-height: 76px;
    padding: 10px 16px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 0 0 0 3px;
    border-color: rgb(247, 227, 155);
}

.wm-dungeon-entrance .wm-constraint-popup__detail-head,
.wm-dungeon-entrance .wm-constraint-popup__effect {
    flex-direction: row;
    align-items: center;
}

.wm-dungeon-entrance .wm-constraint-popup__detail-name {
    flex-grow: 1;
    font-size: 17px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.wm-dungeon-entrance .wm-constraint-popup__level-badge {
    width: 22px;
    height: 20px;
    margin: 0 10px 0 10px;
    font-size: 13px;
    color: rgb(21, 23, 46);
    background-color: rgb(247, 227, 155);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.wm-dungeon-entrance .wm-constraint-popup__detail-state {
    font-size: 13px;
    color: rgb(247, 227, 155);
}

.wm-dungeon-entrance .wm-constraint-popup__detail-text {
    margin-top: 6px;
    font-size: 14px;
    color: rgb(196, 201, 236);
    white-space: normal;
}

.wm-dungeon-entrance .wm-constraint-popup__head--effects {
    margin-top: 18px;
}

.wm-dungeon-entrance .wm-constraint-popup__effects {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    align-items: flex-start;
}

.wm-dungeon-entrance .wm-constraint-popup__effect {
    width: 50%;
    height: 34px;
    margin-bottom: 6px;
}

.wm-dungeon-entrance .wm-constraint-popup__effect-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(220, 224, 250);
}

.wm-dungeon-entrance .wm-constraint-popup__effect-texts {
    flex-shrink: 1;
}

.wm-dungeon-entrance .wm-constraint-popup__effect-head {
    flex-direction: row;
    align-items: center;
}

.wm-dungeon-entrance .wm-constraint-popup__effect-name,
.wm-dungeon-entrance .wm-constraint-popup__effect-value {
    margin: 0;
    padding: 0;
    font-size: 15px;
    white-space: nowrap;
}

.wm-dungeon-entrance .wm-constraint-popup__effect-name {
    color: rgb(242, 243, 251);
}

.wm-dungeon-entrance .wm-constraint-popup__effect-value {
    margin-left: 10px;
    color: rgb(247, 227, 155);
    -unity-font-style: bold;
}

.wm-dungeon-entrance .wm-constraint-popup__effect .wm-constraint-popup__level-badge {
    margin-left: 0;
}

.wm-dungeon-entrance .wm-constraint-popup__effect-text {
    flex-shrink: 1;
    font-size: 14px;
    color: rgb(228, 231, 255);
    white-space: normal;
}

.wm-dungeon-entrance .wm-constraint-popup__effect-empty {
    font-size: 14px;
    color: rgb(150, 156, 200);
}

.wm-dungeon-entrance .wm-constraint-popup__foot {
    flex-direction: row;
    justify-content: flex-end;
}

.wm-dungeon-entrance .wm-constraint-popup__button {
    width: 140px;
    height: 46px;
    margin: 0 0 0 12px;
    font-size: 16px;
    color: rgb(242, 243, 251);
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    border-radius: 0;
}

.wm-dungeon-entrance .wm-constraint-popup__button:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.wm-dungeon-entrance .wm-constraint-popup__button--main {
    color: rgb(21, 23, 46);
    background-color: rgb(244, 244, 248);
    -unity-font-style: bold;
}

.wm-dungeon-entrance .wm-constraint-popup__button--main:hover {
    background-color: rgb(255, 255, 255);
}

/* 설정 창 초점은 파랑. 흰 주 버튼과 금색 켠 칸 위에서도 보이게 */
.wm-dungeon-entrance .wm-constraint-popup__tile:focus,
.wm-dungeon-entrance .wm-constraint-popup__button:focus {
    border-color: rgb(110, 180, 255);
}
