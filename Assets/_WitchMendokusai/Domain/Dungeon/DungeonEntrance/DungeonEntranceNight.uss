/* B 밤유리: 어두운 남색 화면, 비치는 판, 흰 선택, 노란 알약 */
.wm-dungeon-entrance--night {
    background-color: rgb(9, 10, 30);
    background-image: url("Art/dungeon-entry-night-bg.png");
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__hero {
    left: 2.4%;
    top: -5.19%;
    width: 90%;
    height: 144.44%;
    background-image: url("Art/dungeon-entry-hero-yawn.png");
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__top {
    left: 33px;
    top: 21.5px;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__title {
    margin-left: 13px;
    font-size: 22px;
    color: rgb(255, 255, 255);
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__round {
    width: 38px;
    height: 38px;
    font-size: 16px;
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.016);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.13);
    border-radius: 19px;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__round:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__close {
    right: 33px;
    top: 25px;
    font-size: 34px;
    color: rgb(223, 226, 255);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__list {
    left: 33px;
    top: 126px;
    width: 244px;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__row {
    width: 244px;
    height: 62px;
    margin-bottom: 9px;
    padding: 0 13px;
    background-color: rgba(255, 255, 255, 0.014);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
    border-radius: 4px;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__row:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__row--selected,
.wm-dungeon-entrance--night .wm-dungeon-entrance__row--selected:hover {
    background-color: rgb(244, 244, 251);
    border-color: rgb(255, 255, 255);
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__row--selected .wm-dungeon-entrance__row-plate {
    display: flex;
    left: -44px;
    right: -44px;
    top: -44px;
    bottom: -44px;
    background-image: url("Art/dungeon-entry-night-row-plate.png");
    -unity-slice-left: 80;
    -unity-slice-right: 80;
    -unity-slice-scale: 0.74px;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.55);
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__row--selected .wm-dungeon-entrance__row-pointer {
    display: flex;
    left: -13px;
    top: 25px;
    width: 12px;
    height: 10px;
    background-image: url("Art/dungeon-entry-night-pointer.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__row-seal {
    width: 33px;
    height: 33px;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__row-icon {
    width: 33px;
    height: 33px;
    -unity-background-image-tint-color: rgb(205, 211, 246);
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__row--selected .wm-dungeon-entrance__row-icon {
    -unity-background-image-tint-color: rgb(58, 63, 134);
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__row-name {
    margin-left: 12px;
    font-size: 16px;
    color: rgb(228, 231, 255);
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__row--selected .wm-dungeon-entrance__row-name {
    color: rgb(22, 26, 62);
    -unity-font-style: bold;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__detail {
    right: 47px;
    top: 96px;
    bottom: 43px;
    width: 370px;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__card {
    display: none;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__summary {
    align-items: flex-end;
    margin-top: -17px;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__name {
    font-size: 46px;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 6px rgba(120, 120, 255, 0.35);
    -unity-text-align: upper-right;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__tag {
    margin-top: 1px;
    padding: 1px 10px;
    font-size: 12px;
    color: rgb(223, 227, 255);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 10px;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__description {
    margin-top: 8px;
    font-size: 15px;
    color: rgb(196, 201, 236);
    -unity-text-align: upper-right;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__section {
    position: absolute;
    left: 0;
    right: 0;
    padding: 8px 18px 15px 18px;
    background-color: rgba(18, 20, 60, 0.82);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
    border-radius: 4px;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__section--rewards {
    top: 206px;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__section--constraints {
    top: 333px;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__header {
    margin-bottom: 3px;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__header-text {
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(174, 180, 224);
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__header-line {
    display: none;
}

.wm-dungeon-entrance--night .wm-slot {
    width: 62px;
    height: 62px;
    margin: 0 10px 0 0;
    background-color: rgba(255, 255, 255, 0.018);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
    border-radius: 4px;
}

.wm-dungeon-entrance--night .wm-rewards__stat {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    background-image: url("Art/dungeon-entry-night-tile.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.wm-dungeon-entrance--night .wm-rewards__stat .wm-slot__amount {
    font-size: 19px;
    color: rgb(238, 240, 255);
    -unity-font-style: bold;
}

.wm-dungeon-entrance--night .wm-rewards__stat .wm-slot__name {
    font-size: 10px;
    color: rgb(238, 240, 255);
}

.wm-dungeon-entrance--night .wm-slot__icon {
    width: 54%;
    height: 54%;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__monster {
    width: 62px;
    height: 62px;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.018);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
    border-radius: 4px;
}

.wm-dungeon-entrance--night .wm-dungeon-constraint__row {
    height: 33px;
}

.wm-dungeon-entrance--night .wm-dungeon-constraint__row:hover {
    background-color: rgba(255, 255, 255, 0.02);
}

.wm-dungeon-entrance--night .wm-dungeon-constraint__check {
    width: 33px;
    height: 18px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 9px;
}

.wm-dungeon-entrance--night .wm-dungeon-constraint__knob {
    display: flex;
    left: 2px;
    top: 2px;
    width: 14px;
    height: 14px;
    background-color: rgb(255, 255, 255);
    border-radius: 7px;
}

.wm-dungeon-entrance--night .wm-dungeon-constraint__row--selected .wm-dungeon-constraint__check {
    background-color: rgb(247, 227, 155);
}

.wm-dungeon-entrance--night .wm-dungeon-constraint__row--selected .wm-dungeon-constraint__knob {
    left: 17px;
    background-color: rgb(42, 42, 110);
}

.wm-dungeon-entrance--night .wm-dungeon-constraint__text {
    font-size: 13px;
    color: rgb(215, 219, 247);
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__enter {
    left: 0;
    right: 0;
    bottom: 0;
    height: 58px;
    justify-content: center;
    background-color: rgb(247, 227, 155);
    border-width: 0;
    border-radius: 29px;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__enter:hover {
    background-color: rgb(252, 236, 176);
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__enter-glow {
    display: flex;
    left: -52px;
    right: -52px;
    top: -52px;
    bottom: -52px;
    background-image: url("Art/dungeon-entry-night-enter-glow.png");
    -unity-slice-left: 110;
    -unity-slice-right: 110;
    -unity-slice-scale: 0.74px;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.55);
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__enter-arrow {
    display: flex;
    width: 30px;
    height: 30px;
    margin-right: 12px;
    font-size: 15px;
    color: rgb(247, 227, 155);
    background-color: rgb(27, 28, 72);
    border-radius: 15px;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__enter-text {
    font-size: 21px;
    color: rgb(27, 28, 72);
    -unity-font-style: bold;
}
