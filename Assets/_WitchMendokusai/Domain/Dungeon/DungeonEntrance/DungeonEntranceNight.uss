    height: 32px;
    padding: 2px;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 4px;
}

.wm-dungeon-entrance--night .wm-dungeon-entrance__mode-button {
    font-size: 14px;
    color: rgb(215, 219, 247);
