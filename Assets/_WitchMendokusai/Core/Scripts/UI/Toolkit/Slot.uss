.wm-item-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-start;
    padding: 4px;
    background-color: rgba(15, 15, 18, 0.6);
    /* 6 columns × (48 slot + 4 margin) = 312, +8 padding = 320 */
    width: 320px;
    align-self: flex-start;
}

.wm-holding-overlay {
    position: absolute;
    /* 마우스 따라 이동, 본인은 클릭 무시 */
}

.wm-window {
    position: absolute;
    background-color: rgba(20, 20, 25, 0.95);
    border-color: rgba(80, 80, 95, 1);
    border-width: 1px;
    border-radius: 4px;
    min-width: 200px;
    min-height: 100px;
}

.wm-window__header {
    flex-direction: row;
    align-items: center;
    height: 28px;
    flex-shrink: 0;
    background-color: rgba(40, 40, 55, 1);
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 80, 95, 1);
    padding-left: 8px;
    padding-right: 4px;
}

.wm-window__title {
    flex-grow: 1;
    color: rgba(230, 230, 235, 1);
    font-size: 13px;
    -unity-font-style: bold;
}

.wm-window__close {
    width: 22px;
    height: 22px;
    background-color: rgba(150, 50, 50, 1);
    color: rgba(255, 255, 255, 1);
    border-width: 0;
    border-radius: 2px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.wm-window__close:hover {
    background-color: rgba(200, 70, 70, 1);
}

.wm-window__content {
    flex-grow: 1;
    padding: 6px;
}

.wm-hotbar {
    position: absolute;
    bottom: 16px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    background-color: rgba(20, 20, 25, 0.85);
    border-color: rgba(80, 80, 95, 1);
    border-width: 1px;
    border-radius: 4px;
    padding: 4px;
}

/* 핫바 안의 그리드는 한 줄로 — 너비 제한 해제 */
.wm-hotbar .wm-item-grid {
    width: auto;
    background-color: transparent;
    padding: 0;
}

.wm-filter-bar {
    flex-direction: row;
    margin-bottom: 4px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 80, 95, 1);
}

.wm-filter-bar__button {
    background-color: rgba(40, 40, 55, 1);
    color: rgba(180, 180, 190, 1);
    border-color: rgba(80, 80, 95, 1);
    border-width: 1px;
    border-radius: 2px;
    padding: 2px 8px;
    margin-right: 4px;
    font-size: 11px;
    -unity-font-style: bold;
}

.wm-filter-bar__button:hover {
    background-color: rgba(55, 55, 70, 1);
    color: rgba(230, 230, 235, 1);
}

.wm-filter-bar__button--active {
    background-color: rgba(255, 220, 100, 1);
    color: rgba(20, 20, 25, 1);
    border-color: rgba(255, 220, 100, 1);
}

.wm-slot {
    width: 48px;
    height: 48px;
    background-color: rgba(20, 20, 25, 0.85);
    border-color: rgba(80, 80, 95, 1);
    border-width: 1px;
    border-radius: 2px;
    margin: 2px;
    align-items: center;
    justify-content: center;
    position: relative;
}

.wm-slot:hover {
    border-color: rgba(180, 180, 200, 1);
}

.wm-slot--selected {
    border-color: rgba(255, 220, 100, 1);
    border-width: 2px;
}

.wm-slot--empty .wm-slot__icon {
    background-image: none;
}

.wm-slot__icon {
    width: 80%;
    height: 80%;
    -unity-background-scale-mode: scale-to-fit;
}

.wm-slot__amount {
    position: absolute;
    bottom: 2px;
    right: 4px;
    color: rgba(255, 255, 255, 1);
    font-size: 11px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 1);
    -unity-font-style: bold;
}

/* ===== Tooltip ===== */

.wm-tooltip {
    position: absolute;
    background-color: rgba(20, 20, 25, 0.95);
    border-color: rgba(80, 80, 95, 1);
    border-width: 1px;
    border-radius: 4px;
    padding: 6px 8px;
    min-width: 160px;
    max-width: 280px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.08s;
    transition-timing-function: ease-out-cubic;
}

.wm-tooltip--visible {
    opacity: 1;
}

.wm-tooltip__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.wm-tooltip__icon {
    width: 32px;
    height: 32px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.wm-tooltip__name {
    flex-grow: 1;
    color: rgba(255, 220, 100, 1);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

.wm-tooltip__description {
    color: rgba(210, 210, 215, 1);
    font-size: 11px;
    white-space: normal;
}

.wm-tooltip__grade {
    color: rgba(150, 200, 255, 1);
    font-size: 10px;
    margin-top: 4px;
    -unity-font-style: italic;
}

/* ===== Dev Window ===== */

.wm-dev-window {
    flex-grow: 1;
    flex-direction: column;
}

.wm-dev-window__body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 200px;
}

.wm-dev-window__sidebar {
    width: 120px;
    background-color: rgba(15, 15, 20, 0.95);
    border-right-width: 1px;
    border-right-color: rgba(80, 80, 95, 1);
    padding: 4px;
}

.wm-dev-window__sidebar-button {
    background-color: rgba(40, 40, 55, 1);
    color: rgba(200, 200, 210, 1);
    border-color: rgba(80, 80, 95, 1);
    border-width: 1px;
    border-radius: 2px;
    padding: 4px 8px;
    margin-bottom: 4px;
    -unity-text-align: middle-left;
    font-size: 12px;
}

.wm-dev-window__sidebar-button:hover {
    background-color: rgba(55, 55, 70, 1);
    color: rgba(230, 230, 235, 1);
}

.wm-dev-window__sidebar-button--active {
    background-color: rgba(255, 220, 100, 1);
    color: rgba(20, 20, 25, 1);
    border-color: rgba(255, 220, 100, 1);
    -unity-font-style: bold;
}

.wm-dev-window__content {
    flex-grow: 1;
    padding: 6px;
    background-color: rgba(25, 25, 30, 0.95);
}

.wm-dev-mode-console__info {
    color: rgba(180, 180, 190, 1);
    font-size: 12px;
    -unity-font-style: italic;
}

.wm-dev-console {
    height: 160px;
    flex-shrink: 0;
    background-color: rgba(10, 10, 14, 0.95);
    border-top-width: 1px;
    border-top-color: rgba(80, 80, 95, 1);
    padding: 4px;
}

.wm-dev-console__line {
    font-size: 11px;
    -unity-font-style: normal;
    white-space: normal;
}

.wm-dev-log-info {
    color: rgba(220, 220, 225, 1);
}

.wm-dev-log-success {
    color: rgba(120, 220, 140, 1);
}

.wm-dev-log-warn {
    color: rgba(255, 200, 90, 1);
}

.wm-dev-log-error {
    color: rgba(255, 110, 110, 1);
}

.wm-dev-commandline {
    flex-direction: row;
    align-items: center;
    height: 28px;
    flex-shrink: 0;
    background-color: rgba(15, 15, 20, 0.95);
    border-top-width: 1px;
    border-top-color: rgba(80, 80, 95, 1);
    padding: 0 6px;
}

.wm-dev-commandline__prompt {
    color: rgba(120, 220, 140, 1);
    font-size: 13px;
    -unity-font-style: bold;
    margin-right: 4px;
}

.wm-dev-commandline__input {
    flex-grow: 1;
    margin: 0;
    --unity-cursor-color: rgba(230, 230, 235, 1);
}

/* UI Toolkit 버전에 따라 클래스명이 다름 — 둘 다 커버 */
.wm-dev-commandline__input .unity-text-field__input,
.wm-dev-commandline__input .unity-base-text-field__input,
.wm-dev-commandline__input > TextElement {
    background-color: rgba(15, 15, 20, 1);
    border-width: 0;
    border-radius: 0;
    color: rgba(230, 230, 235, 1);
    font-size: 12px;
    padding: 4px 6px;
    --unity-cursor-color: rgba(230, 230, 235, 1);
    --unity-selection-color: rgba(80, 130, 200, 0.5);
}

.wm-dev-autocomplete {
    background-color: rgba(20, 20, 28, 0.98);
    border-color: rgba(80, 80, 95, 1);
    border-width: 1px;
    border-radius: 2px;
    padding: 4px 0;
    max-height: 220px;
}

.wm-dev-autocomplete__item {
    color: rgba(200, 200, 210, 1);
    font-size: 12px;
    padding: 2px 8px;
}

.wm-dev-autocomplete__item--selected {
    background-color: rgba(80, 130, 200, 0.5);
    color: rgba(255, 255, 255, 1);
    -unity-font-style: bold;
}

/* ===== Dev Items Mode ===== */

.wm-dev-mode-items {
    flex-grow: 1;
    flex-direction: column;
}

.wm-dev-mode-items__search {
    margin-top: 4px;
    margin-bottom: 4px;
}

.wm-dev-mode-items__search > .unity-text-field__input,
.wm-dev-mode-items__search .unity-text-field__input,
.wm-dev-mode-items__search .unity-base-text-field__input {
    background-color: rgba(15, 15, 20, 1);
    color: rgba(230, 230, 235, 1);
    border-color: rgba(80, 80, 95, 1);
    border-width: 1px;
    padding: 3px 6px;
    font-size: 12px;
}

.wm-dev-mode-items__hint {
    color: rgba(160, 160, 170, 1);
    font-size: 10px;
    -unity-font-style: italic;
    margin-bottom: 4px;
}

.wm-dev-mode-items__grid-scroll {
    flex-grow: 1;
    flex-basis: 0;
    background-color: rgba(15, 15, 20, 0.6);
}

.wm-dev-mode-items__grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-start;
    padding: 4px;
}

.wm-dev-item-slot {
    /* base .wm-slot 스타일 상속 (48px, dark) — 추가 발신점 없음 */
}

/* ===== Dev List Mode (Mobs/Stages/Quests) ===== */

.wm-dev-mode-list {
    flex-grow: 1;
    flex-direction: column;
}

.wm-dev-mode-list__hint {
    color: rgba(160, 160, 170, 1);
    font-size: 10px;
    -unity-font-style: italic;
    margin-bottom: 4px;
}

.wm-dev-mode-list__search {
    margin-top: 4px;
    margin-bottom: 4px;
}

.wm-dev-mode-list__search > .unity-text-field__input,
.wm-dev-mode-list__search .unity-text-field__input,
.wm-dev-mode-list__search .unity-base-text-field__input {
    background-color: rgba(15, 15, 20, 1);
    color: rgba(230, 230, 235, 1);
    border-color: rgba(80, 80, 95, 1);
    border-width: 1px;
    padding: 3px 6px;
    font-size: 12px;
}

.wm-dev-mode-list__scroll {
    flex-grow: 1;
    flex-basis: 0;
    background-color: rgba(15, 15, 20, 0.6);
}

.wm-dev-mode-list__item {
    background-color: rgba(40, 40, 55, 1);
    color: rgba(220, 220, 230, 1);
    border-color: rgba(80, 80, 95, 1);
    border-width: 1px;
    border-radius: 2px;
    padding: 4px 8px;
    margin: 2px 4px;
    -unity-text-align: middle-left;
    font-size: 12px;
}

.wm-dev-mode-list__item:hover {
    background-color: rgba(55, 55, 70, 1);
    color: rgba(255, 255, 255, 1);
    border-color: rgba(255, 220, 100, 1);
}

/* ===== Setting View ===== */

.wm-setting-view {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 10, 15, 0.95);
    flex-direction: row;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    display: none;
}

.wm-setting-view--active {
    opacity: 1;
    display: flex;
}

.wm-setting-sidebar {
    width: 240px;
    background-color: rgba(15, 15, 20, 0.95);
    border-right-width: 1px;
    border-right-color: rgba(80, 80, 95, 1);
    padding: 32px 16px;
    flex-shrink: 0;
}

.wm-setting-title {
    color: rgba(230, 230, 235, 1);
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 32px;
}

.wm-setting-tab {
    background-color: transparent;
    color: rgba(180, 180, 190, 1);
    border-width: 0;
    font-size: 16px;
    -unity-text-align: middle-left;
    padding: 12px 16px;
    margin-bottom: 8px;
    border-radius: 4px;
    transition-property: background-color, color;
    transition-duration: 0.1s;
}

.wm-setting-tab:hover {
    background-color: rgba(40, 40, 55, 1);
    color: rgba(230, 230, 235, 1);
}

.wm-setting-tab--active {
    background-color: rgba(255, 220, 100, 1);
    color: rgba(20, 20, 25, 1);
    -unity-font-style: bold;
}

.wm-setting-content {
    flex-grow: 1;
    padding: 48px;
    flex-direction: column;
}

.wm-setting-header {
    color: rgba(255, 220, 100, 1);
    font-size: 18px;
    -unity-font-style: bold;
    margin-top: 24px;
    margin-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 80, 95, 1);
    padding-bottom: 8px;
}

.wm-setting-slider {
    margin-bottom: 16px;
    color: rgba(230, 230, 235, 1);
    font-size: 14px;
}

.wm-setting-slider > Label {
    width: 200px;
}

.wm-setting-toggle {
    margin-bottom: 16px;
    color: rgba(230, 230, 235, 1);
    font-size: 14px;
}

.wm-setting-buttons {
    flex-direction: row;
    margin-top: auto;
    justify-content: flex-end;
}

.wm-setting-btn {
    background-color: rgba(40, 40, 55, 1);
    color: rgba(230, 230, 235, 1);
    border-color: rgba(80, 80, 95, 1);
    border-width: 1px;
    border-radius: 4px;
    padding: 12px 24px;
    margin-left: 16px;
    font-size: 14px;
    -unity-font-style: bold;
}

.wm-setting-btn:hover {
    background-color: rgba(55, 55, 70, 1);
    border-color: rgba(180, 180, 200, 1);
}

.wm-setting-btn--danger {
    color: rgba(255, 110, 110, 1);
    border-color: rgba(150, 50, 50, 1);
}

.wm-setting-btn--danger:hover {
    background-color: rgba(150, 50, 50, 1);
    color: rgba(255, 255, 255, 1);
}

.wm-setting-close {
    position: absolute;
    top: 32px;
    right: 32px;
    background-color: transparent;
    color: rgba(180, 180, 190, 1);
    border-width: 1px;
    border-color: rgba(80, 80, 95, 1);
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 14px;
}

.wm-setting-close:hover {
    background-color: rgba(40, 40, 55, 1);
    color: rgba(230, 230, 235, 1);
}

/* WMWindow Content 내 Label 기본 텍스트 색 — 어두운 창 배경 위 가독성 */
.wm-window__content Label {
    color: rgba(220, 220, 225, 1);
    font-size: 12px;
}

/* === Keybind Help === */
.wm-keybind-help {
    flex-grow: 1;
}

.wm-keybind-help__category {
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 80, 95, 0.6);
    padding-bottom: 4px;
}

.wm-keybind-help__category-label {
    color: rgba(180, 200, 230, 1);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.wm-keybind-help__row {
    flex-direction: row;
    justify-content: space-between;
    padding: 2px 4px;
}

.wm-keybind-help__display-name {
    flex-grow: 1;
}

.wm-keybind-help__key {
    color: rgba(255, 220, 130, 1);
    -unity-font-style: bold;
    min-width: 80px;
    -unity-text-align: middle-right;
}

/* === Quest Window === */
.wm-quest-grid {
    flex-grow: 1;
    flex-direction: column;
}

.wm-quest-grid__list {
    flex-grow: 1;
}

.wm-quest-entry {
    padding: 4px 6px;
    margin-bottom: 2px;
    border-left-width: 2px;
    border-left-color: rgba(80, 80, 95, 0.6);
}

.wm-quest-entry:hover {
    background-color: rgba(60, 60, 80, 0.4);
}

.wm-quest-entry--selected {
    background-color: rgba(70, 100, 140, 0.5);
    border-left-color: rgba(180, 200, 230, 1);
}

.wm-quest-entry__name {
    -unity-font-style: bold;
}

.wm-quest-entry__type {
    color: rgba(160, 180, 200, 1);
    font-size: 10px;
    margin-right: 8px;
}

.wm-quest-entry__state {
    color: rgba(255, 220, 130, 1);
    font-size: 10px;
}

.wm-quest-entry__progress {
    height: 3px;
    background-color: rgba(40, 40, 50, 1);
    margin-top: 2px;
}

.wm-quest-entry__progress-fill {
    height: 100%;
    background-color: rgba(120, 200, 140, 1);
}

.wm-quest-filter-bar {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px;
}

.wm-quest-filter-bar__button {
    margin: 2px;
    padding: 2px 6px;
    font-size: 11px;
}

.wm-quest-filter-bar__button--active {
    background-color: rgba(70, 100, 140, 0.8);
    color: rgba(255, 255, 255, 1);
}

.wm-quest-detail {
    padding: 8px;
}

.wm-quest-detail__name {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.wm-quest-detail__desc {
    color: rgba(180, 180, 190, 1);
    margin-bottom: 6px;
}

.wm-quest-detail__criteria {
    margin-top: 6px;
    margin-bottom: 6px;
}

/* === Doll Window === */
.wm-doll-list {
    flex-grow: 1;
    flex-direction: column;
    padding: 4px;
}

.wm-doll-list__scroll {
    flex-grow: 1;
}

.wm-doll-entry {
    flex-direction: row;
    padding: 4px;
    margin-bottom: 2px;
    border-left-width: 2px;
    border-left-color: rgba(80, 80, 95, 0.6);
}

.wm-doll-entry:hover {
    background-color: rgba(60, 60, 80, 0.4);
}

.wm-doll-entry--selected {
    background-color: rgba(70, 100, 140, 0.5);
    border-left-color: rgba(180, 200, 230, 1);
}

.wm-doll-entry__icon {
    width: 32px;
    height: 32px;
    margin-right: 6px;
    background-color: rgba(15, 15, 18, 0.6);
    -unity-background-scale-mode: scale-to-fit;
}

.wm-doll-entry__name {
    -unity-font-style: bold;
}

.wm-doll-entry__level {
    color: rgba(160, 180, 200, 1);
    font-size: 10px;
}

.wm-doll-detail {
    padding: 8px;
    flex-grow: 1;
}

.wm-doll-detail__name {
    font-size: 14px;
    -unity-font-style: bold;
}

.wm-doll-detail__level {
    color: rgba(160, 180, 200, 1);
    margin-bottom: 6px;
}

.wm-doll-detail__section {
    margin-top: 6px;
}

.wm-doll-detail__section-label {
    color: rgba(180, 200, 230, 1);
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.wm-doll-detail__signature {
    width: 48px;
    height: 48px;
}

/* === Status Window === */
.wm-stat-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(60, 60, 75, 0.4);
}

.wm-stat-row__icon {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    background-color: rgba(15, 15, 18, 0.6);
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.wm-stat-row__name {
    flex-grow: 1;
}

.wm-stat-row__value {
    color: rgba(255, 220, 130, 1);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    min-width: 60px;
}

/* === Popup Card === */
.wm-popup-card {
    position: absolute;
    top: 60px;
    left: 50%;
    translate: -50% -10px;
    flex-direction: row;
    align-items: center;
    padding: 10px 16px;
    background-color: rgba(20, 20, 28, 0.92);
    border-color: rgba(255, 220, 130, 1);
    border-width: 1px;
    border-radius: 6px;
    opacity: 0;
    scale: 0.85 0.85;
    transition-property: opacity, scale, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-cubic;
}

.wm-popup-card--active {
    opacity: 1;
    scale: 1 1;
    translate: -50% 0;
}

.wm-popup-card__icon {
    width: 40px;
    height: 40px;
    margin-right: 12px;
    background-color: rgba(15, 15, 18, 0.6);
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.wm-popup-card__name {
    color: rgba(255, 235, 180, 1);
    font-size: 14px;
    -unity-font-style: bold;
}

.wm-popup-card__desc {
    color: rgba(180, 180, 190, 1);
    font-size: 11px;
    margin-top: 2px;
    white-space: normal;
}

/* Stage 변형: 더 큰 배너 + 가운데 */
.wm-popup-card--stage {
    top: 35%;
    padding: 24px 32px;
    border-width: 2px;
    border-color: rgba(255, 200, 100, 1);
    flex-direction: column;
    align-items: center;
}

.wm-popup-card--stage .wm-popup-card__icon {
    width: 64px;
    height: 64px;
    margin-right: 0;
    margin-bottom: 8px;
}

.wm-popup-card--stage .wm-popup-card__name {
    font-size: 22px;
    -unity-text-align: middle-center;
}

.wm-popup-card--stage .wm-popup-card__desc {
    font-size: 13px;
    -unity-text-align: middle-center;
}

/* === Speech Bubble === */
.wm-speech-bubble {
    position: absolute;
    translate: -50% -100%;
    padding: 6px 10px;
    background-color: rgba(20, 20, 28, 0.85);
    border-color: rgba(255, 235, 180, 0.6);
    border-width: 1px;
    border-radius: 8px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.wm-speech-bubble--active {
    opacity: 1;
    transition-duration: 0.2s;
}

.wm-speech-bubble__text {
    color: rgba(245, 245, 250, 1);
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.wm-speech-bubble__emoji {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}

/* === Floating Text === */
.wm-floating-text {
    position: absolute;
    translate: -50% -50%;
    opacity: 0;
    scale: 0.6 0.6;
    transition-property: opacity, scale, translate;
    transition-duration: 0.18s;
    transition-timing-function: ease-out-cubic;
}

.wm-floating-text--active {
    opacity: 1;
    scale: 1 1;
    translate: -50% -120%;
}

.wm-floating-text Label {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 22px;
}

.wm-floating-text--normal Label {
    color: rgba(255, 255, 255, 1);
}

.wm-floating-text--critical Label {
    color: rgba(255, 110, 86, 1);
    font-size: 26px;
}

.wm-floating-text--heal Label {
    color: rgba(120, 220, 130, 1);
}

.wm-floating-text--exp Label {
    color: rgba(180, 200, 230, 1);
    font-size: 16px;
}

.wm-floating-text--warning Label {
    color: rgba(255, 230, 80, 1);
}

/* === Transition === */
.wm-transition {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 1);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-in-out;
}

.wm-transition--active {
    opacity: 1;
}
