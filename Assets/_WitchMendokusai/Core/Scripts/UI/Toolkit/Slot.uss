.wm-item-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-start;
    padding: 4px;
    background-color: rgba(15, 15, 18, 0.6);
    /* 6 columns × (48 slot + 4 margin) = 312, +8 padding = 320 */
    width: 320px;
    align-self: flex-start;
}

.wm-holding-overlay {
    position: absolute;
    /* 마우스 따라 이동, 본인은 클릭 무시 */
}

.wm-window {
    position: absolute;
    background-color: rgba(20, 20, 25, 0.95);
    border-color: rgba(80, 80, 95, 1);
    border-width: 1px;
    border-radius: 4px;
    min-width: 200px;
    min-height: 100px;
}

.wm-window__header {
    flex-direction: row;
    align-items: center;
    height: 28px;
    background-color: rgba(40, 40, 55, 1);
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 80, 95, 1);
    padding-left: 8px;
    padding-right: 4px;
}

.wm-window__title {
    flex-grow: 1;
    color: rgba(230, 230, 235, 1);
    font-size: 13px;
    -unity-font-style: bold;
}

.wm-window__close {
    width: 22px;
    height: 22px;
    background-color: rgba(150, 50, 50, 1);
    color: rgba(255, 255, 255, 1);
    border-width: 0;
    border-radius: 2px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.wm-window__close:hover {
    background-color: rgba(200, 70, 70, 1);
}

.wm-window__content {
    padding: 6px;
}

.wm-hotbar {
    position: absolute;
    bottom: 16px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    background-color: rgba(20, 20, 25, 0.85);
    border-color: rgba(80, 80, 95, 1);
    border-width: 1px;
    border-radius: 4px;
    padding: 4px;
}

/* 핫바 안의 그리드는 한 줄로 — 너비 제한 해제 */
.wm-hotbar .wm-item-grid {
    width: auto;
    background-color: transparent;
    padding: 0;
}

.wm-filter-bar {
    flex-direction: row;
    margin-bottom: 4px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 80, 95, 1);
}

.wm-filter-bar__button {
    background-color: rgba(40, 40, 55, 1);
    color: rgba(180, 180, 190, 1);
    border-color: rgba(80, 80, 95, 1);
    border-width: 1px;
    border-radius: 2px;
    padding: 2px 8px;
    margin-right: 4px;
    font-size: 11px;
    -unity-font-style: bold;
}

.wm-filter-bar__button:hover {
    background-color: rgba(55, 55, 70, 1);
    color: rgba(230, 230, 235, 1);
}

.wm-filter-bar__button--active {
    background-color: rgba(255, 220, 100, 1);
    color: rgba(20, 20, 25, 1);
    border-color: rgba(255, 220, 100, 1);
}

.wm-slot {
    width: 48px;
    height: 48px;
    background-color: rgba(20, 20, 25, 0.85);
    border-color: rgba(80, 80, 95, 1);
    border-width: 1px;
    border-radius: 2px;
    margin: 2px;
    align-items: center;
    justify-content: center;
    position: relative;
}

.wm-slot:hover {
    border-color: rgba(180, 180, 200, 1);
}

.wm-slot--selected {
    border-color: rgba(255, 220, 100, 1);
    border-width: 2px;
}

.wm-slot--empty .wm-slot__icon {
    background-image: none;
}

.wm-slot__icon {
    width: 80%;
    height: 80%;
    -unity-background-scale-mode: scale-to-fit;
}

.wm-slot__amount {
    position: absolute;
    bottom: 2px;
    right: 4px;
    color: rgba(255, 255, 255, 1);
    font-size: 11px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 1);
    -unity-font-style: bold;
}

/* ===== Tooltip ===== */

.wm-tooltip {
    position: absolute;
    background-color: rgba(20, 20, 25, 0.95);
    border-color: rgba(80, 80, 95, 1);
    border-width: 1px;
    border-radius: 4px;
    padding: 6px 8px;
    min-width: 160px;
    max-width: 280px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.08s;
    transition-timing-function: ease-out-cubic;
}

.wm-tooltip--visible {
    opacity: 1;
}

.wm-tooltip__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.wm-tooltip__icon {
    width: 32px;
    height: 32px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.wm-tooltip__name {
    flex-grow: 1;
    color: rgba(255, 220, 100, 1);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

.wm-tooltip__description {
    color: rgba(210, 210, 215, 1);
    font-size: 11px;
    white-space: normal;
}

.wm-tooltip__grade {
    color: rgba(150, 200, 255, 1);
    font-size: 10px;
    margin-top: 4px;
    -unity-font-style: italic;
}

/* ===== Dev Window ===== */

.wm-dev-window {
    flex-grow: 1;
    flex-direction: column;
}

.wm-dev-window__body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 200px;
}

.wm-dev-window__sidebar {
    width: 120px;
    background-color: rgba(15, 15, 20, 0.95);
    border-right-width: 1px;
    border-right-color: rgba(80, 80, 95, 1);
    padding: 4px;
}

.wm-dev-window__sidebar-button {
    background-color: rgba(40, 40, 55, 1);
    color: rgba(200, 200, 210, 1);
    border-color: rgba(80, 80, 95, 1);
    border-width: 1px;
    border-radius: 2px;
    padding: 4px 8px;
    margin-bottom: 4px;
    -unity-text-align: middle-left;
    font-size: 12px;
}

.wm-dev-window__sidebar-button:hover {
    background-color: rgba(55, 55, 70, 1);
    color: rgba(230, 230, 235, 1);
}

.wm-dev-window__sidebar-button--active {
    background-color: rgba(255, 220, 100, 1);
    color: rgba(20, 20, 25, 1);
    border-color: rgba(255, 220, 100, 1);
    -unity-font-style: bold;
}

.wm-dev-window__content {
    flex-grow: 1;
    padding: 6px;
    background-color: rgba(25, 25, 30, 0.95);
}

.wm-dev-mode-console__info {
    color: rgba(180, 180, 190, 1);
    font-size: 12px;
    -unity-font-style: italic;
}

.wm-dev-console {
    height: 160px;
    background-color: rgba(10, 10, 14, 0.95);
    border-top-width: 1px;
    border-top-color: rgba(80, 80, 95, 1);
    padding: 4px;
}

.wm-dev-console__line {
    font-size: 11px;
    -unity-font-style: normal;
    white-space: normal;
}

.wm-dev-log-info {
    color: rgba(220, 220, 225, 1);
}

.wm-dev-log-success {
    color: rgba(120, 220, 140, 1);
}

.wm-dev-log-warn {
    color: rgba(255, 200, 90, 1);
}

.wm-dev-log-error {
    color: rgba(255, 110, 110, 1);
}

.wm-dev-commandline {
    flex-direction: row;
    align-items: center;
    height: 28px;
    background-color: rgba(15, 15, 20, 0.95);
    border-top-width: 1px;
    border-top-color: rgba(80, 80, 95, 1);
    padding: 0 6px;
}

.wm-dev-commandline__prompt {
    color: rgba(120, 220, 140, 1);
    font-size: 13px;
    -unity-font-style: bold;
    margin-right: 4px;
}

.wm-dev-commandline__input {
    flex-grow: 1;
    margin: 0;
    --unity-cursor-color: rgba(230, 230, 235, 1);
}

/* UI Toolkit 버전에 따라 클래스명이 다름 — 둘 다 커버 */
.wm-dev-commandline__input .unity-text-field__input,
.wm-dev-commandline__input .unity-base-text-field__input,
.wm-dev-commandline__input > TextElement {
    background-color: rgba(15, 15, 20, 1);
    border-width: 0;
    border-radius: 0;
    color: rgba(230, 230, 235, 1);
    font-size: 12px;
    padding: 4px 6px;
    --unity-cursor-color: rgba(230, 230, 235, 1);
    --unity-selection-color: rgba(80, 130, 200, 0.5);
}
