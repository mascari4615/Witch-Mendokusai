/* WM 도감. 2 계층 + 3 모드.
   Root(큰 주제 버튼) → Category(뒤로 + 카드 그리드) → Detail(뒤로 + BuildDetail).
   세부 분류 사이드바는 후속 TASK — 골격은 hide. */

.wm-codex {
    background-color: rgb(20, 22, 28);
}

/* === Root 모드: 큰 주제 버튼 === */
.wm-codex__root {
    background-color: rgb(20, 22, 28);
}

.wm-codex__root-button {
    width: 200px;
    height: 150px;
    margin: 16px;
    background-color: rgb(35, 38, 48);
    border-width: 2px;
    border-color: rgb(60, 64, 78);
    color: rgb(215, 220, 230);
    font-size: 18px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    transition-property: scale, border-color, background-color;
    transition-duration: 0.15s;
}

.wm-codex__root-button:hover {
    scale: 1.05 1.05;
    border-color: rgb(120, 170, 230);
    background-color: rgb(45, 50, 65);
    color: rgb(220, 235, 255);
}

/* === Category 모드: 뒤로 + DataExplorerView (좌 사이드바 + 우 그리드) === */
.wm-codex__category {
    padding: 12px;
}

/* === DataExplorerView 베이스 — Codex/DataSOWindow 공유 (TASK-WM-038 단계 A) === */
.wm-data-explorer {
    background-color: rgba(0, 0, 0, 0.15);
}

.wm-data-explorer__sidebar {
    background-color: rgb(15, 16, 22);
    border-right-width: 1px;
    border-right-color: rgb(45, 48, 58);
    padding: 8px 6px;
}

.wm-data-explorer__sidebar-button {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(170, 175, 190);
    border-width: 0;
    margin: 2px 0;
    padding: 8px 12px;
    -unity-text-align: middle-left;
    transition-property: background-color, color;
    transition-duration: 0.1s;
}

.wm-data-explorer__sidebar-button:hover {
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(220, 225, 240);
}

.wm-data-explorer__sidebar-button--active {
    background-color: rgba(80, 140, 220, 0.18);
    color: rgb(160, 200, 255);
}

.wm-data-explorer__grid-content {
    padding: 8px;
}

/* === Detail 모드: 뒤로 + 디테일 === */
.wm-codex__detail {
    padding: 12px;
}

.wm-codex__back-button {
    align-self: flex-start;
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(200, 205, 220);
    border-width: 0;
    padding: 6px 14px;
    margin-bottom: 12px;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.wm-codex__back-button:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.wm-codex__detail-content {
    background-color: rgba(0, 0, 0, 0.25);
    padding: 16px;
    flex-grow: 1;
}

/* === 디테일 패널 (CodexDetailPanel) — 좌 일러스트 + 우 정보 === */
.wm-codex-detail {
    flex-direction: row;
    flex-grow: 1;
}

.wm-codex-detail__illustration {
    width: 240px;
    height: 240px;
    margin-right: 16px;
    background-color: rgb(28, 30, 38);
    border-width: 1px;
    border-color: rgb(60, 64, 78);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.wm-codex-detail__illustration--fallback {
    background-color: rgb(45, 48, 60);
}

.wm-codex-detail__illustration-image {
    width: 200px;
    height: 200px;
}

.wm-codex-detail__info {
    padding: 4px 8px;
}

.wm-codex-detail__name {
    color: rgb(230, 235, 245);
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.wm-codex-detail__meta {
    color: rgb(150, 155, 170);
    font-size: 11px;
    margin-bottom: 16px;
}

.wm-codex-detail__meta--grade-common {
    color: rgb(170, 175, 190);
}

.wm-codex-detail__meta--grade-uncommon {
    color: rgb(140, 220, 140);
}

.wm-codex-detail__meta--grade-rare {
    color: rgb(130, 180, 250);
}

.wm-codex-detail__meta--grade-legendary {
    color: rgb(250, 190, 110);
}

.wm-codex-detail__body {
    background-color: rgba(0, 0, 0, 0.2);
    padding: 12px 14px;
    flex-grow: 1;
}

.wm-codex-detail__body Label {
    color: rgb(210, 215, 230);
    font-size: 12px;
    margin-bottom: 6px;
    white-space: normal;
}

/* === 카드 (Category 모드 안 그리드) === */
.wm-codex-card {
    width: 110px;
    height: 140px;
    margin: 6px;
    background-color: rgb(35, 38, 48);
    border-width: 2px;
    border-color: rgb(60, 64, 78);
    align-items: center;
    justify-content: flex-start;
    padding: 8px 6px;
    transition-property: scale, border-color, background-color;
    transition-duration: 0.12s;
}

.wm-codex-card__icon {
    width: 80px;
    height: 80px;
    margin-bottom: 8px;
    background-color: rgba(0, 0, 0, 0.25);
    flex-shrink: 0;
}

.wm-codex-card__name {
    color: rgb(215, 220, 230);
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-shrink: 1;
}

/* hover/active — 코드에서 동적 class 부여 */
.wm-codex-card--hover {
    scale: 1.05 1.05;
    border-color: rgb(120, 170, 230);
    background-color: rgb(45, 50, 65);
}

.wm-codex-card--active {
    border-color: rgb(160, 210, 255);
    background-color: rgb(50, 60, 80);
}

/* grade 테두리 색 — ItemData 만 채워짐 */
.wm-codex-card--grade-common {
    border-color: rgb(125, 130, 145);
}

.wm-codex-card--grade-uncommon {
    border-color: rgb(110, 200, 110);
}

.wm-codex-card--grade-rare {
    border-color: rgb(100, 160, 240);
}

.wm-codex-card--grade-legendary {
    border-color: rgb(240, 170, 80);
}

/* 잠금 — UIToolkit USS 가 blur 미지원 → opacity + 회색 톤으로 대체 */
.wm-codex-card--locked {
    opacity: 0.45;
    background-color: rgb(28, 30, 36);
    border-color: rgb(50, 52, 60);
}

.wm-codex-card--locked .wm-codex-card__icon {
    -unity-background-image-tint-color: rgb(60, 60, 68);
}
