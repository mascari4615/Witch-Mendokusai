/*
 * V2 작전 화면. 정본 memo/wm/design/idle/layout.md (2026-08-30).
 *
 * 전투 창 1200 + 관리 열 720. 1920×1080 캔버스, PanelSettings 가 화면에 맞춰 스케일.
 * 전투 창 위의 HUD 는 어두운 상자(전술 단말기 문법). 관리 열도 어둡게 (축 74. 실물 보고 확정).
 * 이름과 문구는 임시.
 */

.idle-root {
	flex-grow: 1;
	flex-direction: row;
}

/* ── 전투 창 ── */
.idle-battle {
	width: 1200px;
	flex-shrink: 0;
	position: relative;
}

.idle-battle--full {
	width: 100%;
}

.idle-scene-cover {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	background-color: rgb(24, 20, 14);
	align-items: center;
	justify-content: center;
}

.idle-scene-cover-label {
	font-size: 28px;
	color: rgb(160, 138, 106);
	letter-spacing: 6px;
	margin-bottom: 20px;
}

.idle-box {
	background-color: rgba(16, 16, 16, 0.84);
	border-width: 1px;
	border-color: rgba(255, 255, 255, 0.14);
	border-radius: 0;
	color: rgb(255, 255, 255);
}

.idle-cap {
	font-size: 11px;
	color: rgb(138, 138, 130);
	letter-spacing: 2px;
}

/* 좌상. 작전 코드 */
.idle-op {
	position: absolute;
	left: 20px;
	top: 18px;
	min-width: 330px;
	padding: 10px 14px;
}

.idle-op-row {
	flex-direction: row;
	align-items: center;
}

.idle-op-code {
	font-size: 34px;
	-unity-font-style: bold;
	color: rgb(255, 255, 255);
	margin-right: 12px;
}

.idle-op-name {
	font-size: 16px;
	color: rgb(180, 180, 172);
}

.idle-wave {
	flex-direction: row;
	align-items: center;
	margin-right: 8px;
}

.idle-wave-dot {
	width: 34px;
	height: 8px;
	margin-right: 4px;
	background-color: rgb(58, 58, 58);
	border-width: 1px;
	border-color: rgb(0, 0, 0);
}

.idle-wave-dot--done {
	background-color: rgb(255, 255, 255);
}

.idle-wave-dot--boss {
	width: 14px;
	height: 14px;
	background-color: rgb(196, 82, 106);
	rotate: 45deg;
	margin-left: 4px;
}

/* 좌상 둘째 줄. 스테퍼 + 반복 */
.idle-step-row {
	position: absolute;
	left: 20px;
	top: 112px;
	flex-direction: row;
}

.idle-stepper {
	flex-direction: row;
	align-items: center;
	height: 46px;
	margin-right: 8px;
}

.idle-step-button {
	width: 46px;
	height: 44px;
	background-color: rgba(0, 0, 0, 0);
	border-width: 0;
	color: rgb(255, 255, 255);
	font-size: 18px;
	margin: 0;
}

.idle-step-button:disabled {
	opacity: 0.3;
}

.idle-step-label {
	font-size: 22px;
	-unity-font-style: bold;
	color: rgb(255, 255, 255);
	padding: 0 12px;
}

.idle-toggle {
	height: 46px;
	padding: 0 16px;
	font-size: 18px;
	-unity-font-style: bold;
	margin: 0;
}

.idle-toggle--on {
	color: rgb(245, 175, 16);
}

/* 우상. 재화 + 분할 */
.idle-chips {
	position: absolute;
	right: 20px;
	top: 18px;
	flex-direction: row;
}

.idle-chip {
	height: 42px;
	padding: 0 12px;
	margin-left: 8px;
	font-size: 20px;
	-unity-font-style: bold;
	-unity-text-align: middle-left;
}

.idle-icon-button {
	height: 42px;
	padding: 0 12px;
	margin-left: 8px;
	font-size: 14px;
	color: rgb(220, 220, 214);
}

.idle-icon-button:hover {
	background-color: rgba(255, 255, 255, 0.12);
}

.idle-icon-button:disabled {
	opacity: 0.45;
}

.idle-speed-row {
	position: absolute;
	right: 20px;
	top: 74px;
	flex-direction: row;
}

/* 우측. 로그 */
.idle-log {
	position: absolute;
	right: 20px;
	top: 136px;
	width: 320px;
	padding: 8px 12px;
	background-color: rgba(16, 16, 16, 0.55);
}

.idle-log-line {
	font-size: 14px;
	color: rgb(200, 200, 192);
	white-space: normal;
	margin-top: 3px;
}

.idle-log-line--note {
	color: rgb(245, 175, 16);
	-unity-font-style: bold;
}

/* 상단 중앙. 보스 바 */
.idle-enemy {
	position: absolute;
	left: 50%;
	top: 112px;
	translate: -50% 0;
	align-items: center;
	padding: 8px 16px;
}

.idle-enemy-label {
	font-size: 16px;
	-unity-font-style: bold;
	color: rgb(255, 255, 255);
}

.idle-enemy-gauge {
	width: 420px;
	height: 12px;
	margin-top: 6px;
	background-color: rgb(24, 24, 24);
	border-width: 1px;
	border-color: rgb(0, 0, 0);
}

.idle-enemy-fill {
	height: 100%;
	background-color: rgb(196, 82, 106);
}

/* 중앙. 실패 배너 */
.idle-fail {
	position: absolute;
	left: 50%;
	top: 22%;
	translate: -50% 0;
	align-items: center;
	padding: 16px 28px;
}

.idle-fail-label {
	font-size: 16px;
	-unity-font-style: bold;
	color: rgb(255, 220, 190);
	white-space: normal;
	margin-bottom: 10px;
}

/* 하단 중앙. 손패 + 코스트 */
.idle-hand {
	position: absolute;
	left: 50%;
	bottom: 30px;
	translate: -50% 0;
	flex-direction: column;
	align-items: center;
}

#cards {
	flex-direction: row;
	align-items: flex-end;
}

.idle-card {
	width: 124px;
	height: 166px;
	margin-right: 10px;
	font-size: 15px;
	-unity-font-style: bold;
	white-space: normal;
	background-color: rgb(20, 20, 20);
	color: rgb(255, 255, 255);
	border-width: 2px;
	border-color: rgb(255, 255, 255);
	border-radius: 0;
	-unity-text-align: lower-left;
	padding: 8px;
}

.idle-card:active {
	scale: 0.96 0.96;
}

.idle-card:disabled {
	opacity: 0.5;
}

.idle-card--ready {
	border-color: rgb(245, 175, 16);
}

.idle-icon-button--on {
	border-color: rgb(245, 175, 16);
	color: rgb(245, 175, 16);
}

.idle-hero-row {
	flex-direction: row;
	align-items: center;
}

.idle-hero-level {
	width: 132px;
	margin-left: 8px;
	font-size: 14px;
	background-color: rgb(28, 28, 28);
	color: rgb(255, 255, 255);
	border-width: 1px;
	border-color: rgb(120, 120, 120);
	border-radius: 0;
	padding: 6px;
}

.idle-hero-level:disabled {
	opacity: 0.4;
}

.idle-queue {
	flex-direction: row;
	align-items: center;
	margin-top: 6px;
}

.idle-queue-cap {
	font-size: 11px;
	color: rgb(150, 150, 150);
	margin-right: 6px;
	letter-spacing: 1px;
}

.idle-queue-chip {
	font-size: 12px;
	color: rgb(190, 190, 190);
	background-color: rgb(28, 28, 28);
	border-width: 1px;
	border-color: rgb(70, 70, 70);
	padding: 2px 8px;
	margin-right: 5px;
}

.idle-queue-chip--next {
	color: rgb(245, 175, 16);
	border-color: rgb(245, 175, 16);
}

.idle-cost {
	width: 412px;
	margin-top: 8px;
	flex-direction: row;
	align-items: center;
}

.idle-cost-label {
	width: 72px;
	font-size: 18px;
	-unity-font-style: bold;
	color: rgb(255, 255, 255);
}

.idle-cost-gauge {
	flex-grow: 1;
	height: 10px;
	background-color: rgb(20, 20, 20);
	border-width: 1px;
	border-color: rgb(0, 0, 0);
	margin: 0 8px;
}

.idle-cost-fill {
	height: 100%;
	background-color: rgb(245, 175, 16);
}

/* 우하. 풀화면일 때 탭 */
.idle-floating-tabs {
	position: absolute;
	right: 20px;
	bottom: 14px;
	flex-direction: row;
}

.idle-debug {
	position: absolute;
	left: 20px;
	bottom: 14px;
	color: rgb(181, 131, 18);
}

/* 맵 팝업 */
.idle-map {
	position: absolute;
	left: 150px;
	top: 140px;
	width: 700px;
	padding: 12px 18px;
	background-color: rgba(26, 26, 26, 0.98);
}

/* ── 관리 열 ── */
.idle-side {
	width: 720px;
	flex-shrink: 0;
	background-color: rgb(26, 26, 26);
	border-left-width: 2px;
	border-left-color: rgb(0, 0, 0);
}

.idle-side--drawer {
	position: absolute;
	right: 0;
	top: 0;
	bottom: 0;
}

.idle-tabs {
	flex-direction: row;
	padding: 8px 8px 0 8px;
	background-color: rgb(21, 21, 21);
	border-bottom-width: 1px;
	border-bottom-color: rgb(58, 58, 58);
}

.idle-tab {
	flex-grow: 1;
	flex-basis: 0;
	min-width: 0;
	height: 72px;
	margin: 0 1px;
	padding: 0 2px;
	background-color: rgb(30, 30, 30);
	color: rgb(200, 200, 192);
	border-width: 0;
	border-radius: 0;
	font-size: 13px;
	white-space: normal;
	overflow: hidden;
}

.idle-tab:hover {
	background-color: rgb(42, 42, 42);
}

.idle-tab--on {
	background-color: rgb(236, 236, 232);
	color: rgb(17, 17, 17);
	-unity-font-style: bold;
}

.idle-tab--badge {
	border-top-width: 4px;
	border-top-color: rgb(181, 20, 14);
}

.idle-tab--close {
	flex-grow: 0;
	width: 52px;
	font-size: 26px;
	-unity-font-style: bold;
}

.idle-panel-head {
	flex-direction: row;
	align-items: center;
	padding: 12px 18px;
	border-bottom-width: 2px;
	border-bottom-color: rgb(58, 58, 58);
}

.idle-panel-title {
	font-size: 28px;
	-unity-font-style: bold;
	color: rgb(255, 255, 255);
	margin-right: 12px;
}

.idle-panel-body {
	flex-grow: 1;
}

.idle-page {
	padding: 16px 18px;
}

.idle-row-head {
	font-size: 15px;
	color: rgb(200, 200, 192);
	margin: 8px 0 4px 0;
	white-space: normal;
}

.idle-row-title {
	font-size: 15px;
	color: rgb(240, 240, 236);
	margin-top: 6px;
	white-space: normal;
}

.idle-row-title--dim {
	color: rgb(110, 110, 104);
}

.idle-row-note {
	font-size: 13px;
	color: rgb(138, 138, 130);
	margin: 4px 0;
	white-space: normal;
}

.idle-row-button {
	height: 36px;
	font-size: 15px;
	margin: 3px 0;
	background-color: rgb(40, 40, 40);
	color: rgb(240, 240, 236);
	border-width: 1px;
	border-color: rgb(58, 58, 58);
	border-radius: 0;
	-unity-text-align: middle-left;
	padding: 0 12px;
	white-space: normal;
}

.idle-row-button:hover {
	background-color: rgb(56, 56, 56);
}

.idle-row-button:disabled {
	opacity: 0.45;
}

.idle-row-button--strong {
	background-color: rgb(245, 196, 0);
	color: rgb(17, 17, 17);
	-unity-font-style: bold;
	-unity-text-align: middle-center;
}

.idle-row-button--tall {
	height: 56px;
	font-size: 18px;
}

.idle-party {
	flex-direction: row;
	margin: 6px 0 4px 0;
}

.idle-party-seat {
	flex-grow: 1;
	height: 96px;
	margin: 0 3px;
	font-size: 13px;
	white-space: normal;
	background-color: rgb(40, 40, 40);
	color: rgb(240, 240, 236);
	border-width: 2px;
	border-color: rgb(58, 58, 58);
	border-radius: 0;
}

.idle-party-seat--sub {
	border-color: rgb(79, 179, 166);
}

.idle-party-seat--picking {
	background-color: rgb(245, 175, 16);
	color: rgb(17, 17, 17);
}

.idle-worn {
	flex-direction: row;
	margin: 6px 0 10px 0;
}

.idle-worn-cell {
	width: 110px;
	height: 110px;
	margin-right: 10px;
	background-color: rgb(40, 40, 40);
	border-width: 1px;
	border-color: rgb(58, 58, 58);
	color: rgb(240, 240, 236);
	font-size: 15px;
	-unity-text-align: middle-center;
	white-space: normal;
}

.idle-worn-cell--empty {
	color: rgb(110, 110, 104);
}

.idle-bag {
	flex-direction: row;
	flex-wrap: wrap;
	margin: 6px 0;
}

.idle-bag-cell {
	width: 76px;
	height: 76px;
	margin: 3px;
	font-size: 13px;
	white-space: normal;
	background-color: rgb(40, 40, 40);
	color: rgb(240, 240, 236);
	border-width: 1px;
	border-color: rgb(58, 58, 58);
	border-radius: 0;
}

.idle-bag-cell:disabled {
	opacity: 0.3;
}

.idle-warn {
	color: rgb(220, 100, 100);
	-unity-font-style: bold;
}

.idle-banner {
	height: 220px;
	background-color: rgb(38, 30, 16);
	border-width: 2px;
	border-color: rgb(17, 17, 17);
	padding: 18px;
	margin-bottom: 12px;
}

.idle-banner-title {
	font-size: 40px;
	-unity-font-style: bold;
	color: rgb(255, 255, 255);
}

.idle-button {
	height: 44px;
	font-size: 15px;
	background-color: rgb(40, 40, 40);
	color: rgb(240, 240, 236);
	border-width: 1px;
	border-color: rgb(90, 90, 90);
	border-radius: 0;
	margin: 3px 0;
	padding: 0 16px;
}

.idle-button:hover {
	background-color: rgb(56, 56, 56);
}

.idle-button--strong {
	background-color: rgb(245, 175, 16);
	color: rgb(17, 17, 17);
	-unity-font-style: bold;
}

.idle-button,
.idle-row-button,
.idle-icon-button,
.idle-tab,
.idle-subtab {
	transition-property: background-color, scale, color;
	transition-duration: 0.12s;
}

.idle-button:hover,
.idle-row-button:hover,
.idle-icon-button:hover,
.idle-tab:hover,
.idle-subtab:hover {
	background-color: rgba(245, 175, 16, 0.18);
	color: rgb(255, 236, 174);
}

.idle-button:active,
.idle-row-button:active,
.idle-icon-button:active,
.idle-tab:active,
.idle-subtab:active {
	scale: 0.97 0.97;
}

/* 단계 고유색. 울티마식 (1 회색, 2 초록, 3 파랑, 4 보라, 5 주황, 6 빨강, 7 금, 8 하늘) */
.idle-tier-1 { border-color: rgb(150, 150, 150); border-width: 2px; }
.idle-tier-2 { border-color: rgb(96, 190, 96); border-width: 2px; }
.idle-tier-3 { border-color: rgb(80, 150, 240); border-width: 2px; }
.idle-tier-4 { border-color: rgb(170, 100, 230); border-width: 2px; }
.idle-tier-5 { border-color: rgb(240, 150, 40); border-width: 2px; }
.idle-tier-6 { border-color: rgb(230, 70, 70); border-width: 2px; }
.idle-tier-7 { border-color: rgb(245, 200, 40); border-width: 2px; }
.idle-tier-8 { border-color: rgb(120, 230, 240); border-width: 2px; }

.idle-merge-row {
	flex-direction: row;
	align-items: center;
	margin: 3px 0;
}

.idle-merge-label {
	flex-grow: 1;
	font-size: 15px;
	color: rgb(240, 240, 236);
	border-left-width: 4px;
	padding-left: 10px;
	margin-right: 8px;
}

.idle-merge-button {
	width: 190px;
	margin: 0;
}

/* 툴팁. 마우스 옆 */
.idle-tooltip {
	position: absolute;
	width: 300px;
	padding: 10px 12px;
	background-color: rgb(17, 17, 17);
	border-width: 1px;
	border-color: rgb(90, 90, 90);
	color: rgb(255, 255, 255);
	font-size: 14px;
	white-space: normal;
}

/* 아이템 서브탭 */
.idle-subtabs {
	flex-direction: row;
	margin-bottom: 10px;
}

.idle-subtab {
	height: 40px;
	padding: 0 22px;
	margin-right: 4px;
	background-color: rgb(30, 30, 30);
	color: rgb(180, 180, 172);
	border-width: 1px;
	border-color: rgb(58, 58, 58);
	border-radius: 0;
	font-size: 16px;
}

.idle-subtab--on {
	background-color: rgb(236, 236, 232);
	color: rgb(17, 17, 17);
	-unity-font-style: bold;
}

/* 공방 */
.idle-forge-kinds {
	flex-direction: row;
	flex-wrap: wrap;
	margin-bottom: 12px;
}

.idle-forge-kind {
	height: 36px;
	padding: 0 12px;
	margin: 0 6px 6px 0;
	background-color: rgb(40, 40, 40);
	color: rgb(240, 240, 236);
	border-width: 2px;
	border-color: rgb(58, 58, 58);
	border-radius: 0;
	font-size: 14px;
}

.idle-forge-kind--on {
	background-color: rgb(236, 236, 232);
	color: rgb(17, 17, 17);
	-unity-font-style: bold;
}

.idle-forge-bench {
	flex-direction: row;
	align-items: center;
	margin: 6px 0 10px 0;
}

.idle-forge-grid {
	flex-direction: row;
	flex-wrap: wrap;
	width: 306px;
}

.idle-forge-cell {
	width: 96px;
	height: 96px;
	margin: 3px;
	background-color: rgb(40, 40, 40);
	border-width: 2px;
	border-color: rgb(58, 58, 58);
	color: rgb(240, 240, 236);
	font-size: 14px;
	-unity-text-align: middle-center;
	white-space: normal;
}

.idle-forge-outcome {
	flex-direction: row;
	align-items: center;
	margin-left: 20px;
}

.idle-forge-arrow {
	font-size: 40px;
	color: rgb(138, 138, 130);
	margin-right: 16px;
}

.idle-forge-cell--result {
	width: 120px;
	height: 120px;
	font-size: 16px;
}

.idle-forge-cell--ready {
	background-color: rgb(60, 50, 20);
}

.idle-gear-popup {
	position: absolute;
	left: 24px;
	right: 24px;
	top: 120px;
	max-height: 640px;
	padding: 12px 18px;
	background-color: rgba(26, 26, 26, 0.98);
}

.idle-gear-row {
	width: 100%;
	padding: 10px 12px;
	margin-bottom: 6px;
	-unity-text-align: middle-left;
}

.idle-party-seat--geared {
	border-color: rgb(226, 186, 96);
}
