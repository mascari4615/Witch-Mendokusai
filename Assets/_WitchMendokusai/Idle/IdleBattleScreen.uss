/*
 * V2 작전 화면 HUD (concept-v2).
 *
 * ★ 바탕은 투명 — 3D 무대가 화면의 주인이고 HUD 는 그 위의 얇은 층이다.
 *   칩은 반투명 흰색(블아 문법의 밝은 HUD), 글자는 진한 남색.
 */

.v2-root {
	flex-grow: 1;
	justify-content: space-between;
}

.v2-topbar {
	flex-direction: row;
	align-items: center;
	padding: 12px 16px 4px 16px;
}

.v2-chip {
	background-color: rgba(255, 255, 255, 0.9);
	color: rgb(43, 58, 74);
	font-size: 14px;
	padding: 5px 14px;
	margin-right: 8px;
	border-radius: 7px;
}

.v2-chip--strong {
	font-size: 16px;
	-unity-font-style: bold;
}

.v2-guide {
	font-size: 13px;
	color: rgb(43, 58, 74);
	background-color: rgba(255, 255, 255, 0.75);
	border-radius: 6px;
	margin: 4px 16px;
	padding: 3px 12px;
	align-self: flex-start;
}

.v2-note {
	font-size: 14px;
	-unity-font-style: bold;
	color: rgb(232, 135, 31);
	background-color: rgba(255, 255, 255, 0.85);
	border-radius: 6px;
	margin: 2px 16px;
	padding: 3px 12px;
	align-self: flex-start;
	min-height: 16px;
}

/* 적 — 화면 위 가운데. 판의 주인공이라 여기 있다. */
.v2-enemy {
	align-self: center;
	align-items: center;
	margin-top: 2px;
}

.v2-enemy-label {
	font-size: 14px;
	-unity-font-style: bold;
	color: rgb(43, 58, 74);
	background-color: rgba(255, 255, 255, 0.88);
	border-radius: 6px;
	padding: 2px 12px;
}

.v2-enemy-label--boss {
	color: rgb(255, 255, 255);
	background-color: rgba(92, 84, 112, 0.94);
}

.v2-enemy-gauge {
	width: 420px;
	height: 14px;
	margin-top: 4px;
	background-color: rgba(255, 255, 255, 0.8);
	border-radius: 7px;
	overflow: hidden;
}

.v2-enemy-fill {
	height: 100%;
	background-color: rgb(232, 92, 92);
}

.v2-wave {
	flex-direction: row;
	margin-top: 5px;
}

.v2-wave-dot {
	width: 10px;
	height: 10px;
	border-radius: 5px;
	margin: 0 3px;
	background-color: rgba(255, 255, 255, 0.85);
}

.v2-wave-dot--boss {
	width: 14px;
	height: 14px;
	border-radius: 7px;
	margin-top: -2px;
	background-color: rgba(92, 84, 112, 0.9);
}

.v2-wave-dot--done {
	background-color: rgba(43, 58, 74, 0.45);
}

/* 실패 배너 — 반복 중일 때만 */
.v2-fail {
	align-self: center;
	align-items: center;
	margin-top: 14px;
	padding: 12px 26px;
	background-color: rgba(43, 58, 74, 0.92);
	border-radius: 12px;
}

.v2-fail-label {
	font-size: 15px;
	-unity-font-style: bold;
	color: rgb(255, 220, 190);
	white-space: normal;
}

.v2-button--next {
	margin-top: 8px;
	background-color: rgb(232, 135, 31);
	color: rgb(255, 255, 255);
	-unity-font-style: bold;
}

/* 우리 자리 — 체력·부활 */
.v2-left {
	align-items: flex-start;
}

.v2-seats {
	margin-bottom: 6px;
}

.v2-seat {
	width: 150px;
	margin: 2px 0;
	background-color: rgba(255, 255, 255, 0.88);
	border-radius: 7px;
	padding: 3px 8px;
}

.v2-seat-name {
	font-size: 11px;
	color: rgb(43, 58, 74);
}

.v2-seat-gauge {
	height: 7px;
	margin-top: 2px;
	background-color: rgb(216, 228, 236);
	border-radius: 4px;
	overflow: hidden;
}

.v2-seat-fill {
	height: 100%;
	background-color: rgb(92, 168, 108);
}

.v2-seat-fill--down {
	background-color: rgb(150, 150, 160);
}

/* 장 — 열고 닫는다 */
.v2-sheet {
	position: absolute;
	right: 0;
	top: 0;
	bottom: 0;
	width: 46%;
	background-color: rgba(247, 250, 252, 0.97);
	padding: 14px 18px;
}

.v2-sheet-head {
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 8px;
}

.v2-sheet-title {
	font-size: 19px;
	-unity-font-style: bold;
	color: rgb(43, 58, 74);
}

.v2-sheet-body {
	flex-grow: 1;
}

.v2-page {
	padding-bottom: 10px;
}

.v2-row-head {
	font-size: 13px;
	-unity-font-style: bold;
	color: rgb(122, 138, 154);
	margin-top: 12px;
	margin-bottom: 2px;
}

.v2-row-title {
	font-size: 14px;
	color: rgb(43, 58, 74);
	margin-top: 6px;
	white-space: normal;
}

.v2-row-note {
	font-size: 12px;
	color: rgb(122, 138, 154);
	margin: 2px 0;
	white-space: normal;
}

.v2-row-button {
	height: 30px;
	font-size: 13px;
	margin: 2px 0;
	background-color: rgb(232, 238, 244);
	color: rgb(43, 58, 74);
	border-width: 0;
	border-radius: 6px;
}

.v2-row-button:hover {
	background-color: rgb(216, 228, 236);
}

.v2-row-button:disabled {
	opacity: 0.45;
}

.v2-row-button--strong {
	background-color: rgb(74, 157, 232);
	color: rgb(255, 255, 255);
	-unity-font-style: bold;
}

.v2-bag {
	flex-direction: row;
	flex-wrap: wrap;
	margin: 4px 0;
}

.v2-bag-cell {
	width: 34px;
	height: 34px;
	margin: 2px;
	font-size: 10px;
	white-space: normal;
	background-color: rgb(232, 238, 244);
	color: rgb(43, 58, 74);
	border-width: 0;
	border-radius: 5px;
}

.v2-bag-cell:disabled {
	opacity: 0.3;
}

.v2-party {
	flex-direction: row;
}

.v2-party-seat {
	flex-grow: 1;
	height: 42px;
	margin: 0 3px;
	font-size: 12px;
	background-color: rgb(232, 238, 244);
	color: rgb(43, 58, 74);
	border-width: 0;
	border-radius: 7px;
}

.v2-party-seat--picking {
	background-color: rgb(74, 157, 232);
	color: rgb(255, 255, 255);
}

.v2-warn {
	color: rgb(200, 72, 72);
	-unity-font-style: bold;
}

.v2-bottom {
	flex-direction: row;
	justify-content: space-between;
	align-items: flex-end;
	padding: 0 16px 14px 16px;
}

.v2-verbs {
	flex-direction: column;
	align-items: flex-start;
}

.v2-button {
	height: 32px;
	font-size: 13px;
	background-color: rgba(255, 255, 255, 0.9);
	color: rgb(43, 58, 74);
	border-width: 0;
	border-radius: 8px;
	margin: 3px 0;
	padding: 0 14px;
}

.v2-button:hover {
	background-color: rgb(255, 255, 255);
}

.v2-button:active {
	scale: 0.97 0.97;
}

.v2-button:disabled {
	opacity: 0.45;
}

.v2-button--ready {
	border-left-width: 4px;
	border-left-color: rgb(74, 157, 232);
}

.v2-button--fold {
	color: rgb(181, 131, 18);
}

.v2-hand {
	align-items: flex-end;
}

.v2-card-row {
	flex-direction: row;
}

.v2-card {
	width: 92px;
	height: 96px;
	margin-left: 10px;
	font-size: 13px;
	-unity-font-style: bold;
	white-space: normal;
	background-color: rgba(255, 255, 255, 0.94);
	color: rgb(43, 58, 74);
	border-width: 0;
	border-radius: 12px;
	border-bottom-width: 5px;
	border-bottom-color: rgb(180, 190, 200);
}

.v2-card:active {
	scale: 0.95 0.95;
}

.v2-card:disabled {
	opacity: 0.45;
}

.v2-card--ready {
	border-bottom-color: rgb(232, 165, 31);
}

.v2-cost-row {
	flex-direction: row;
	align-items: center;
	margin-top: 8px;
	background-color: rgba(255, 255, 255, 0.9);
	border-radius: 7px;
	padding: 5px 12px;
}

.v2-cost-label {
	font-size: 13px;
	-unity-font-style: bold;
	color: rgb(43, 58, 74);
	margin-right: 8px;
}

.v2-cost-gauge {
	width: 220px;
	height: 12px;
	background-color: rgb(216, 228, 236);
	border-radius: 6px;
	overflow: hidden;
}

.v2-cost-fill {
	height: 100%;
	background-color: rgb(74, 157, 232);
}
