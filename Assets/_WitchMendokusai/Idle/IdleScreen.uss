/*
 * 방치형 화면 (TASK-WM-406).
 *
 * 사용자 방향: 세계관 정하기 전이라 <기하학적 모양>으로 간다.
 * 값이 아니라 뜻으로 이름 짓는다 — 팔레트가 한 자리에 산다.
 *
 * ★ 해상도 대응 — 고정 픽셀 크기를 최소로 쓰고 flex 로 늘린다.
 *   좁은 창에서는 두 칸이 한 칸으로 접힌다(.idle-body 의 wrap).
 */

.idle-root {
	flex-grow: 1;
	background-color: rgb(14, 15, 20);
	color: rgb(226, 228, 236);
}

/* 판 뒤 은은한 바닥 — 밋밋한 검정은 「꺼진 화면」처럼 보인다 */
.idle-arena {
	background-color: rgb(17, 19, 25);
}

/* ── 위 요약 띠 ─────────────────────────────────────────────── */

.idle-topbar {
	flex-direction: row;
	align-items: center;
	padding: 10px 16px;
	background-color: rgb(20, 22, 29);
	border-bottom-width: 1px;
	border-bottom-color: rgb(38, 41, 52);
	flex-wrap: wrap;
}

.idle-top-stage {
	font-size: 15px;
	-unity-font-style: bold;
	color: rgb(150, 176, 208);
	margin-right: 18px;
}

.idle-top-resource {
	font-size: 20px;
	-unity-font-style: bold;
	flex-grow: 1;
}

.idle-top-note {
	font-size: 12px;
	color: rgb(128, 132, 146);
}

/* ── 아래 두 칸 ─────────────────────────────────────────────── */

.idle-body {
	flex-grow: 1;
	flex-direction: row;
	flex-wrap: wrap;
}

.idle-arena {
	flex-grow: 1.4;
	flex-basis: 300px;
	min-height: 240px;
	padding: 16px;
	align-items: center;
	justify-content: center;
}

.idle-panel {
	flex-basis: 260px;
	flex-grow: 1;
	padding: 14px 16px;
	background-color: rgb(18, 20, 26);
	border-left-width: 1px;
	border-left-color: rgb(38, 41, 52);
}

/* ── 판 ─────────────────────────────────────────────────────── */

.idle-stage-box {
	width: 200px;
	height: 200px;
	align-items: center;
	justify-content: center;
}

.idle-shape {
	position: absolute;
	width: 100%;
	height: 100%;
}

.idle-ally-row {
	flex-direction: row;
	margin-top: 14px;
}

.idle-ally {
	width: 26px;
	height: 26px;
	margin: 0 5px;
}

.idle-arena-caption {
	font-size: 12px;
	color: rgb(128, 132, 146);
	margin-top: 12px;
}

.idle-health {
	width: 200px;
	height: 8px;
	margin-top: 14px;
}

.idle-kills-dots {
	flex-direction: row;
	margin-top: 8px;
}

.idle-dot {
	width: 8px;
	height: 8px;
	margin: 0 2px;
	border-radius: 4px;
	background-color: rgb(48, 52, 64);
}

.idle-dot--done {
	background-color: rgb(150, 176, 208);
}

/* ── 탭 ─────────────────────────────────────────────────────── */

.idle-tabs {
	flex-direction: row;
	margin-bottom: 12px;
}

.idle-tab {
	flex-grow: 1;
	height: 30px;
	font-size: 13px;
	background-color: rgb(24, 26, 34);
	border-width: 0;
	color: rgb(140, 144, 158);
}

.idle-tab--on {
	background-color: rgb(38, 44, 58);
	color: rgb(226, 228, 236);
	-unity-font-style: bold;
}

/* ── 올리기 ─────────────────────────────────────────────────── */

.idle-row-title {
	font-size: 13px;
	color: rgb(196, 200, 212);
	margin-top: 12px;
}

.idle-row-value {
	font-size: 11px;
	color: rgb(128, 132, 146);
	margin-bottom: 4px;
}

.idle-button {
	height: 34px;
	font-size: 13px;
	background-color: rgb(38, 44, 58);
	border-width: 0;
	color: rgb(226, 228, 236);
	margin: 2px 0;
}

.idle-button:hover {
	background-color: rgb(48, 56, 74);
}

/* 누르면 살짝 들어간다 — 눌린 게 손에 남는다 */
.idle-button:active {
	background-color: rgb(70, 84, 110);
	scale: 0.97 0.97;
}

.idle-button:disabled {
	opacity: 0.35;
}

.idle-button--strong {
	background-color: rgb(58, 78, 112);
}

.idle-note {
	font-size: 11px;
	color: rgb(196, 176, 120);
	margin-top: 6px;
	min-height: 16px;
	white-space: normal;
}

.idle-divider {
	height: 1px;
	background-color: rgb(38, 41, 52);
	margin: 14px 0 6px 0;
}

.idle-hidden {
	display: none;
}

/* 목록 줄 — 왼쪽 도형 + 오른쪽 버튼 */
.idle-shape-row {
	flex-direction: row;
	align-items: center;
	margin: 2px 0;
}

.idle-row-shape {
	width: 22px;
	height: 22px;
	margin-right: 8px;
	flex-shrink: 0;
}

.idle-row-button {
	flex-grow: 1;
	margin: 0;
	height: 30px;
	font-size: 12px;
}

/* 세 칸 */
.idle-column {
	flex-basis: 240px;
	flex-grow: 1;
	padding: 12px 14px;
	background-color: rgb(18, 20, 26);
	border-left-width: 1px;
	border-left-color: rgb(38, 41, 52);
}

.idle-column-title {
	font-size: 11px;
	color: rgb(120, 126, 142);
	-unity-font-style: bold;
	margin-bottom: 8px;
}

/* 튀는 숫자 */
.float-text {
	position: absolute;
	font-size: 15px;
	-unity-font-style: bold;
}

/* 살 수 있게 된 것은 테두리로 알린다 — 「지금 이거」가 보인다 */
.idle-button--ready {
	border-left-width: 3px;
	border-left-color: rgb(122, 168, 232);
}

/* 판 바닥 — 도형 뒤에 깔린다 */
.idle-backdrop {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}
