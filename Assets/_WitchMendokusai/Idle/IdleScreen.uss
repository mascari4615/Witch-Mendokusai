/*
 * 방치형 화면 (TASK-WM-406).
 *
 * 사용자 방향: 세계관 정하기 전이라 <기하학적 모양>으로 간다.
 * 값이 아니라 뜻으로 이름 짓는다 — 팔레트가 한 자리에 산다.
 *
 * ★ 큰 짜임 = 3칸 (기지 · 전투 · 창고). 전투 칸에는 때리기만.
 *
 * ★ 해상도 — 고정 픽셀 크기를 최소로 쓰고 flex 로 늘린다.
 *   좁은 창에서는 실황 셋이 아래로 접힌다(.idle-stages 의 wrap).
 */

.idle-root {
	flex-grow: 1;
	position: relative;
	background-color: rgb(14, 15, 20);
	color: rgb(226, 228, 236);
}

.idle-topbar {
	flex-direction: row;
	align-items: center;
	padding: 10px 16px;
	background-color: rgb(20, 22, 29);
	border-bottom-width: 1px;
	border-bottom-color: rgb(38, 41, 52);
	flex-wrap: wrap;
}

.idle-top-stage {
	font-size: 15px;
	-unity-font-style: bold;
	color: rgb(150, 176, 208);
	margin-right: 18px;
}

.idle-top-resource {
	font-size: 20px;
	-unity-font-style: bold;
	flex-grow: 1;
}

.idle-top-note {
	font-size: 12px;
	color: rgb(128, 132, 146);
}

.idle-stages {
	flex-grow: 1;
	flex-direction: row;
	flex-wrap: wrap;
	min-height: 240px;
}

.idle-live {
	flex-basis: 220px;
	flex-grow: 1;
	min-height: 200px;
	padding: 10px 12px;
	background-color: rgb(17, 19, 25);
	border-left-width: 1px;
	border-left-color: rgb(30, 33, 42);
	overflow: hidden;
}

.idle-shop {
	flex-grow: 1;
	min-height: 72px;
	margin-top: 8px;
}

.idle-prestige {
	margin-left: 12px;
	height: 28px;
	padding: 0 10px;
	font-size: 12px;
	background-color: rgb(58, 46, 20);
	color: rgb(240, 193, 75);
	border-width: 0;
}

.idle-hero-sheet {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background-color: rgb(11, 12, 16);
	padding: 14px 18px;
}

.idle-hero-sheet-head {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 8px;
}

.idle-hover-tip {
	position: absolute;
	background-color: rgb(18, 20, 28);
	border-width: 1px;
	border-color: rgb(90, 110, 140);
	padding: 6px 8px;
	font-size: 12px;
	color: rgb(226, 228, 236);
	white-space: normal;
	max-width: 220px;
}

.idle-arena {
	position: relative;
	flex-grow: 2;
	flex-basis: 320px;
	align-items: stretch;
}

.idle-worn-strip {
	flex-direction: row;
	margin: 6px 0 4px 0;
}

.idle-worn-cell {
	flex-grow: 1;
	align-items: center;
	margin: 0 3px;
}

.idle-worn-pip {
	width: 22px;
	height: 22px;
}

.idle-worn-name {
	font-size: 10px;
	color: rgb(150, 176, 208);
	margin-top: 2px;
}

.idle-live-title {
	font-size: 11px;
	color: rgb(120, 126, 142);
	-unity-font-style: bold;
	margin-bottom: 6px;
}

.idle-live-note {
	font-size: 11px;
	color: rgb(150, 176, 208);
	margin-left: 8px;
}

.idle-spacer {
	flex-grow: 1;
}

.idle-vault-head {
	flex-direction: row;
	align-items: center;
}

.idle-vault-mark {
	width: 22px;
	height: 22px;
}

.idle-producer-strip {
	flex-direction: row;
	justify-content: space-between;
	margin-top: 8px;
}

.idle-strip-shape {
	flex-grow: 1;
	height: 26px;
	margin: 0 1px;
}

.idle-field {
	flex-grow: 1;
	min-height: 120px;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	width: 100%;
}

.idle-hero-row {
	flex-direction: row;
	align-items: center;
}

.idle-hero {
	width: 30px;
	height: 30px;
	margin: 0 3px;
}

.idle-stage-box {
	width: 140px;
	height: 140px;
	align-items: center;
	justify-content: center;
}

.idle-shape {
	position: absolute;
	width: 100%;
	height: 100%;
}

.idle-arena-caption {
	font-size: 11px;
	color: rgb(128, 132, 146);
	margin-top: 8px;
}

.idle-health {
	width: 90%;
	height: 8px;
	margin-top: 10px;
}

.idle-kills-dots {
	flex-direction: row;
	margin-top: 6px;
}

.idle-dot {
	width: 8px;
	height: 8px;
	margin: 0 2px;
	border-radius: 4px;
	background-color: rgb(48, 52, 64);
}

.idle-dot--done {
	background-color: rgb(150, 176, 208);
}

.idle-vault-grid {
	flex-direction: row;
	flex-wrap: wrap;
	margin-top: 8px;
}

.idle-vault-cell {
	width: 18px;
	height: 18px;
	margin: 2px;
}

.idle-page {
	padding-bottom: 6px;
}

.idle-row-title {
	font-size: 13px;
	color: rgb(196, 200, 212);
	margin-top: 10px;
}

.idle-row-value {
	font-size: 11px;
	color: rgb(128, 132, 146);
	margin-bottom: 4px;
}

.idle-button {
	height: 32px;
	font-size: 13px;
	background-color: rgb(38, 44, 58);
	border-width: 0;
	color: rgb(226, 228, 236);
	margin: 2px 0;
}

.idle-button:hover {
	background-color: rgb(48, 56, 74);
}

.idle-button:active {
	background-color: rgb(70, 84, 110);
	scale: 0.97 0.97;
}

.idle-button:disabled {
	opacity: 0.45;
}

.idle-button--strong {
	background-color: rgb(58, 78, 112);
}

.idle-button--ready {
	border-left-width: 3px;
	border-left-color: rgb(122, 168, 232);
}

.idle-button--locked {
	background-color: rgb(26, 29, 38);
	color: rgb(128, 132, 146);
	border-left-width: 3px;
	border-left-color: rgb(52, 57, 70);
}

.idle-note {
	font-size: 11px;
	color: rgb(196, 176, 120);
	margin-top: 6px;
	min-height: 16px;
	white-space: normal;
}

.idle-divider {
	height: 1px;
	background-color: rgb(38, 41, 52);
	margin: 12px 0 6px 0;
}

.idle-shape-row {
	flex-direction: row;
	align-items: center;
	margin: 2px 0;
}

.idle-row-shape {
	width: 22px;
	height: 22px;
	margin-right: 8px;
	flex-shrink: 0;
}

.idle-row-button {
	flex-grow: 1;
	margin: 0;
	height: 30px;
	font-size: 12px;
}

.float-text {
	position: absolute;
	font-size: 15px;
	-unity-font-style: bold;
}

.idle-backdrop {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.idle-party-row {
	flex-direction: row;
	margin: 4px 0 2px 0;
	flex-shrink: 0;
}

.idle-seat {
	flex-grow: 1;
	flex-basis: 0;
	align-items: center;
	margin: 0 3px;
}

.idle-seat-shape {
	width: 34px;
	height: 34px;
	margin-bottom: 2px;
}

.idle-seat-button {
	width: 100%;
	height: 30px;
	font-size: 11px;
	margin: 0;
	white-space: normal;
}

.idle-visitor {
	position: absolute;
	top: 22%;
	width: 40px;
	height: 40px;
}

.idle-surge {
	font-size: 15px;
	-unity-font-style: bold;
	color: rgb(250, 214, 97);
	margin-top: 4px;
}

.idle-guide {
	font-size: 12px;
	color: rgb(196, 176, 120);
	padding: 4px 16px 6px 16px;
	background-color: rgb(20, 22, 29);
	border-bottom-width: 1px;
	border-bottom-color: rgb(38, 41, 52);
	white-space: normal;
}

.idle-warn {
	color: rgb(232, 148, 108);
	-unity-font-style: bold;
}
