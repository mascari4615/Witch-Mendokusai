<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="BattleScreen.uss" />
    <Style src="CharacterWorkspace.uss" />
    <Style src="IdleGrammar.uss" />
    <ui:VisualElement name="page" class="idle-page idle-doll-page">
        <ui:VisualElement class="idle-profile idle-surface">
            <ui:VisualElement name="doll-portrait" class="idle-doll-portrait" />
            <ui:VisualElement class="idle-profile-controls">
                <ui:Label name="doll-name" class="idle-doll-name" />
                <ui:VisualElement name="party" class="idle-party">
                    <ui:Button name="seat-0" class="idle-party-seat"><ui:VisualElement name="seat-icon-0" class="idle-party-portrait" /><ui:Label name="seat-label-0" class="idle-party-label" /></ui:Button>
                    <ui:Button name="seat-1" class="idle-party-seat"><ui:VisualElement name="seat-icon-1" class="idle-party-portrait" /><ui:Label name="seat-label-1" class="idle-party-label" /></ui:Button>
                    <ui:Button name="seat-2" class="idle-party-seat"><ui:VisualElement name="seat-icon-2" class="idle-party-portrait" /><ui:Label name="seat-label-2" class="idle-party-label" /></ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="worn" class="idle-worn">
                    <ui:Button name="worn-0" class="idle-worn-cell"><ui:VisualElement name="worn-icon-0" class="idle-gear-visual idle-gear-icon--0" /><ui:Label name="worn-label-0" class="idle-gear-tier-badge" /></ui:Button>
                    <ui:Button name="worn-1" class="idle-worn-cell"><ui:VisualElement name="worn-icon-1" class="idle-gear-visual idle-gear-icon--1" /><ui:Label name="worn-label-1" class="idle-gear-tier-badge" /></ui:Button>
                    <ui:Button name="worn-2" class="idle-worn-cell"><ui:VisualElement name="worn-icon-2" class="idle-gear-visual idle-gear-icon--2" /><ui:Label name="worn-label-2" class="idle-gear-tier-badge" /></ui:Button>
                    <ui:Button name="worn-3" class="idle-worn-cell"><ui:VisualElement name="worn-icon-3" class="idle-gear-visual idle-gear-icon--3" /><ui:Label name="worn-label-3" class="idle-gear-tier-badge" /></ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="idle-growth idle-surface">
            <ui:Label text="UPGRADE" class="idle-growth-title" />
            <ui:VisualElement class="idle-stat-cols"><ui:Label text="PARAMETER" class="idle-stat-col" style="margin-left: 40px; width: 130px;" /><ui:Label text="VALUE" class="idle-stat-col" style="width: 204px;" /><ui:Label text="COST" class="idle-stat-col" /></ui:VisualElement>
            <ui:VisualElement name="stat-rows" class="idle-stat-rows">
                <ui:VisualElement name="stat-row-0" class="idle-stat-row"><ui:VisualElement class="idle-stat-icon idle-stat-icon--0" /><ui:Label name="stat-name-0" class="idle-stat-name" /><ui:Label name="stat-value-0" class="idle-stat-value" /><ui:Label name="stat-level-0" class="idle-stat-level" /><ui:Button name="stat-0-x1" text="+" class="idle-stat-buy idle-stat-buy--x1" /><ui:Button name="stat-0-x10" text="×10" class="idle-stat-buy idle-stat-buy--x10" /><ui:Button name="stat-0-x100" text="×100" class="idle-stat-buy idle-stat-buy--x100" /><ui:VisualElement class="idle-stat-hex" /><ui:Label name="stat-cost-0" class="idle-stat-cost" /></ui:VisualElement>
                <ui:VisualElement name="stat-row-1" class="idle-stat-row"><ui:VisualElement class="idle-stat-icon idle-stat-icon--1" /><ui:Label name="stat-name-1" class="idle-stat-name" /><ui:Label name="stat-value-1" class="idle-stat-value" /><ui:Label name="stat-level-1" class="idle-stat-level" /><ui:Button name="stat-1-x1" text="+" class="idle-stat-buy idle-stat-buy--x1" /><ui:Button name="stat-1-x10" text="×10" class="idle-stat-buy idle-stat-buy--x10" /><ui:Button name="stat-1-x100" text="×100" class="idle-stat-buy idle-stat-buy--x100" /><ui:VisualElement class="idle-stat-hex" /><ui:Label name="stat-cost-1" class="idle-stat-cost" /></ui:VisualElement>
                <ui:VisualElement name="stat-row-2" class="idle-stat-row"><ui:VisualElement class="idle-stat-icon idle-stat-icon--2" /><ui:Label name="stat-name-2" class="idle-stat-name" /><ui:Label name="stat-value-2" class="idle-stat-value" /><ui:Label name="stat-level-2" class="idle-stat-level" /><ui:Button name="stat-2-x1" text="+" class="idle-stat-buy idle-stat-buy--x1" /><ui:Button name="stat-2-x10" text="×10" class="idle-stat-buy idle-stat-buy--x10" /><ui:Button name="stat-2-x100" text="×100" class="idle-stat-buy idle-stat-buy--x100" /><ui:VisualElement class="idle-stat-hex" /><ui:Label name="stat-cost-2" class="idle-stat-cost" /></ui:VisualElement>
                <ui:VisualElement name="stat-row-3" class="idle-stat-row"><ui:VisualElement class="idle-stat-icon idle-stat-icon--3" /><ui:Label name="stat-name-3" class="idle-stat-name" /><ui:Label name="stat-value-3" class="idle-stat-value" /><ui:Label name="stat-level-3" class="idle-stat-level" /><ui:Button name="stat-3-x1" text="+" class="idle-stat-buy idle-stat-buy--x1" /><ui:Button name="stat-3-x10" text="×10" class="idle-stat-buy idle-stat-buy--x10" /><ui:Button name="stat-3-x100" text="×100" class="idle-stat-buy idle-stat-buy--x100" /><ui:VisualElement class="idle-stat-hex" /><ui:Label name="stat-cost-3" class="idle-stat-cost" /></ui:VisualElement>
                <ui:VisualElement name="stat-row-4" class="idle-stat-row"><ui:VisualElement class="idle-stat-icon idle-stat-icon--4" /><ui:Label name="stat-name-4" class="idle-stat-name" /><ui:Label name="stat-value-4" class="idle-stat-value" /><ui:Label name="stat-level-4" class="idle-stat-level" /><ui:Button name="stat-4-x1" text="+" class="idle-stat-buy idle-stat-buy--x1" /><ui:Button name="stat-4-x10" text="×10" class="idle-stat-buy idle-stat-buy--x10" /><ui:Button name="stat-4-x100" text="×100" class="idle-stat-buy idle-stat-buy--x100" /><ui:VisualElement class="idle-stat-hex" /><ui:Label name="stat-cost-4" class="idle-stat-cost" /></ui:VisualElement>
                <ui:VisualElement name="stat-row-5" class="idle-stat-row"><ui:VisualElement class="idle-stat-icon idle-stat-icon--5" /><ui:Label name="stat-name-5" class="idle-stat-name" /><ui:Label name="stat-value-5" class="idle-stat-value" /><ui:Label name="stat-level-5" class="idle-stat-level" /><ui:Button name="stat-5-x1" text="+" class="idle-stat-buy idle-stat-buy--x1" /><ui:Button name="stat-5-x10" text="×10" class="idle-stat-buy idle-stat-buy--x10" /><ui:Button name="stat-5-x100" text="×100" class="idle-stat-buy idle-stat-buy--x100" /><ui:VisualElement class="idle-stat-hex" /><ui:Label name="stat-cost-5" class="idle-stat-cost" /></ui:VisualElement>
                <ui:VisualElement name="stat-row-6" class="idle-stat-row"><ui:VisualElement class="idle-stat-icon idle-stat-icon--6" /><ui:Label name="stat-name-6" class="idle-stat-name" /><ui:Label name="stat-value-6" class="idle-stat-value" /><ui:Label name="stat-level-6" class="idle-stat-level" /><ui:Button name="stat-6-x1" text="+" class="idle-stat-buy idle-stat-buy--x1" /><ui:Button name="stat-6-x10" text="×10" class="idle-stat-buy idle-stat-buy--x10" /><ui:Button name="stat-6-x100" text="×100" class="idle-stat-buy idle-stat-buy--x100" /><ui:VisualElement class="idle-stat-hex" /><ui:Label name="stat-cost-6" class="idle-stat-cost" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="stat-feedback" class="idle-stat-feedback" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
