<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="BattleScreen.uss" />
    <ui:Button name="card" class="idle-card">
        <ui:VisualElement name="card-stripe" class="idle-card-stripe" />
        <ui:VisualElement name="card-face" class="idle-card-face" />
        <ui:VisualElement name="card-icon" class="idle-card-icon" />
        <ui:Label name="card-cost" class="idle-card-cost" />
        <ui:Label name="card-slot" class="idle-card-slot" />
        <ui:Label name="card-name" class="idle-card-name" />
        <ui:VisualElement name="card-dim" class="idle-card-dim" />
    </ui:Button>
</ui:UXML>
