<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <!-- 가방은 수량이 저장 데이터에 따라 달라져 이 틀을 런타임에 반복한다. -->
    <ui:Button name="bag-cell" class="idle-bag-cell">
        <ui:VisualElement name="bag-icon" class="idle-gear-visual" />
        <ui:Label name="bag-potential" class="idle-gear-potential" />
        <ui:Label name="bag-lock" text="잠금" class="idle-bag-lock" />
    </ui:Button>
</ui:UXML>
