@import url("../../Presentation/FloatingText.uss");

/*
 * V2 작전 화면. 정본 memo/wm/design/idle/layout.md (2026-08-30).
 *
 * 전투 창 1200 + 관리 열 720. 1920×1080 캔버스, PanelSettings 가 화면에 맞춰 스케일.
 * 전투 창 위의 HUD 는 어두운 상자(전술 단말기 문법). 관리 열도 어둡게 (축 74. 실물 보고 확정).
 * 이름과 문구는 임시.
 */

.idle-root {
	flex-grow: 1;
	flex-direction: row;
}

/* ── 전투 창 ── */
.idle-battle {
	width: 1200px;
	flex-shrink: 0;
	position: relative;
}

.idle-battle--full {
	width: 100%;
}

.idle-scene-cover {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	background-color: rgb(24, 20, 14);
	align-items: center;
	justify-content: center;
}

.idle-scene-cover-label {
	font-size: 38px;
	color: rgb(160, 138, 106);
	letter-spacing: 6px;
	margin-bottom: 20px;
}

.idle-box {
	background-color: rgba(16, 16, 16, 0.84);
	border-width: 1px;
	border-color: rgba(255, 255, 255, 0.14);
	border-radius: 0;
	color: rgb(255, 255, 255);
}

.idle-cap {
	font-size: 20px;
	color: rgb(138, 138, 130);
	letter-spacing: 2px;
}

/* HUD 칩. 프레임 없는 반투명 검정 (사용자 2026-09-05 S2 선택. 목업 mock/hud-style-2026-09-05.html) */
.idle-chip-dark {
	background-color: rgba(0, 0, 0, 0.55);
	border-width: 0;
	border-radius: 0;
	color: rgb(255, 255, 255);
}

/* 좌상. 작전 코드 + 웨이브 한 줄 */
.idle-op {
	position: absolute;
	left: 20px;
	top: 18px;
	height: 44px;
	padding: 0 14px;
	flex-direction: row;
	align-items: center;
}

.idle-op-code {
	font-size: 26px;
	-unity-font-style: bold;
	color: rgb(255, 255, 255);
	margin-right: 10px;
}

.idle-op-name {
	font-size: 14px;
	color: rgb(168, 168, 160);
	letter-spacing: 2px;
	margin-right: 16px;
}

.idle-op-cap {
	font-size: 14px;
	color: rgb(168, 168, 160);
	letter-spacing: 2px;
	margin-left: 10px;
}

.idle-wave {
	flex-direction: row;
	align-items: center;
}

.idle-wave-dot {
	width: 22px;
	height: 5px;
	margin-right: 3px;
	background-color: rgb(58, 58, 58);
}

.idle-wave-dot--done {
	background-color: rgb(255, 255, 255);
}

.idle-wave-dot--boss {
	width: 9px;
	height: 9px;
	background-color: rgb(196, 82, 106);
	rotate: 45deg;
	margin-left: 6px;
	margin-right: 0;
}

/* 좌상 둘째 줄. 스테퍼 + 반복 */
.idle-step-row {
	position: absolute;
	left: 20px;
	top: 70px;
	flex-direction: row;
}

.idle-stepper {
	flex-direction: row;
	align-items: center;
	height: 40px;
	padding: 0 6px;
	margin-right: 8px;
}

.idle-step-button {
	width: 28px;
	height: 40px;
	background-color: rgba(0, 0, 0, 0);
	border-width: 0;
	color: rgb(204, 204, 204);
	font-size: 15px;
	margin: 0;
	padding: 0;
}

.idle-step-button:disabled {
	opacity: 0.3;
}

.idle-step-label {
	font-size: 20px;
	-unity-font-style: bold;
	color: rgb(255, 255, 255);
	padding: 0 6px;
}

.idle-toggle {
	height: 40px;
	min-width: 88px;
	padding: 0 12px 0 32px;
	font-size: 15px;
	margin: 0;
	-unity-text-align: middle-left;
}

.idle-toggle-lamp {
	position: absolute;
	left: 12px;
	top: 14px;
	width: 12px;
	height: 12px;
	background-color: rgb(58, 58, 58);
}

.idle-toggle--on .idle-toggle-lamp {
	background-color: rgb(245, 175, 16);
}

/* 우상. 재화 + 분할 */
.idle-chips {
	position: absolute;
	right: 20px;
	top: 18px;
	flex-direction: row;
}

.idle-chip {
	height: 44px;
	padding: 0 14px;
	margin-left: 8px;
	font-size: 24px;
	-unity-font-style: bold;
	-unity-text-align: middle-left;
}

.idle-gold-chip {
	flex-direction: row;
	align-items: center;
}

.idle-gold-icon {
	width: 26px;
	height: 26px;
	margin-right: 8px;
	background-image: url("../../Domain/Component/Item/_Common/Sprite/game-icons.net/ore.png");
	-unity-background-scale-mode: scale-to-fit;
	-unity-background-image-tint-color: rgb(245, 188, 52);
}

.idle-gold-value {
	font-size: 24px;
	-unity-font-style: bold;
	color: rgb(245, 175, 16);
}

.idle-icon-button {
	height: 44px;
	padding: 0 10px;
	margin-left: 8px;
	font-size: 18px;
	color: rgb(220, 220, 214);
}

.idle-icon-button:hover {
	background-color: rgba(255, 255, 255, 0.12);
}

.idle-icon-button:disabled {
	opacity: 0.45;
}

.idle-settings-button,
.idle-split-button {
	width: 44px;
	padding: 0;
	align-items: center;
	justify-content: center;
}

.idle-settings-icon {
	width: 24px;
	height: 24px;
	background-image: url("../../Domain/Component/Item/_Common/Sprite/game-icons.net/gears.png");
	-unity-background-scale-mode: scale-to-fit;
	-unity-background-image-tint-color: rgb(224, 224, 216);
}

.idle-split-chevron {
	position: relative;
	width: 18px;
	height: 26px;
}

.idle-split-chevron-line {
	position: absolute;
	left: 6px;
	width: 3px;
	height: 14px;
	background-color: rgb(232, 232, 224);
}

.idle-split-chevron-line--top { top: 2px; rotate: -42deg; }
.idle-split-chevron-line--bottom { bottom: 2px; rotate: 42deg; }
.idle-split-button--collapsed .idle-split-chevron { scale: -1 1; }

/* 우측. 로그 */
.idle-log {
	position: absolute;
	right: 20px;
	top: 136px;
	width: 320px;
	padding: 8px 12px;
	background-color: rgba(16, 16, 16, 0.55);
}

.idle-log-line {
	font-size: 24px;
	color: rgb(200, 200, 192);
	white-space: normal;
	margin-top: 3px;
}

.idle-log-line--note {
	color: rgb(245, 175, 16);
	-unity-font-style: bold;
}

/* 상단 중앙. 보스 바 */
.idle-enemy {
	position: absolute;
	left: 50%;
	top: 112px;
	translate: -50% 0;
	align-items: center;
	padding: 8px 16px;
}

.idle-enemy-label {
	font-size: 28px;
	-unity-font-style: bold;
	color: rgb(255, 255, 255);
}

.idle-enemy-gauge {
	width: 420px;
	height: 12px;
	margin-top: 6px;
	background-color: rgb(24, 24, 24);
	border-width: 1px;
	border-color: rgb(0, 0, 0);
}

.idle-enemy-fill {
	height: 100%;
	background-color: rgb(196, 82, 106);
}

/* 중앙. 실패 배너 */
.idle-fail {
	position: absolute;
	left: 50%;
	top: 22%;
	translate: -50% 0;
	align-items: center;
	padding: 16px 28px;
}

.idle-fail-label {
	font-size: 28px;
	-unity-font-style: bold;
	color: rgb(255, 220, 190);
	white-space: normal;
	margin-bottom: 10px;
}

/* 하단 중앙. 손패 + 코스트 */
.idle-hand {
	position: absolute;
	left: 50%;
	bottom: 30px;
	translate: -50% 0;
	flex-direction: column;
	align-items: center;
}

.idle-skill-auto {
	position: absolute;
	right: -104px;
	bottom: 0;
	width: 92px;
	height: 44px;
	font-size: 18px;
	-unity-font-style: bold;
	color: rgb(190, 190, 184);
	background-color: rgba(0, 0, 0, 0.55);
	border-width: 0;
}

.idle-skill-auto.idle-icon-button--on {
	color: rgb(245, 175, 16);
}

#cards {
	flex-direction: row;
	align-items: flex-end;
}

/* 손패 (사용자 2026-09-05): 프레임 없는 어두운 카드, 좌상 파란 원 코스트, 쓸 수 있으면 앰버 테두리 */
.idle-card {
	position: relative;
	width: 170px;
	height: 166px;
	margin-right: 10px;
	font-size: 28px;
	-unity-font-style: bold;
	white-space: normal;
	background-color: rgba(18, 18, 18, 0.88);
	color: rgb(255, 255, 255);
	border-width: 2px;
	border-color: rgba(0, 0, 0, 0);
	border-radius: 0;
	-unity-text-align: lower-left;
	padding: 8px;
}

.idle-card-icon {
	position: absolute;
	left: 34px;
	top: 26px;
	width: 100px;
	height: 84px;
	-unity-background-scale-mode: scale-to-fit;
	-unity-background-image-tint-color: rgb(245, 238, 211);
}

.idle-card-cost {
	position: absolute;
	left: 8px;
	top: 8px;
	min-width: 40px;
	height: 40px;
	font-size: 24px;
	-unity-font-style: bold;
	-unity-text-align: middle-center;
	color: rgb(255, 255, 255);
	background-color: rgb(52, 120, 246);
	border-radius: 20px;
}

.idle-card-name {
	position: absolute;
	left: 8px;
	right: 8px;
	bottom: 8px;
	font-size: 20px;
	-unity-font-style: bold;
	-unity-text-align: middle-center;
	color: rgb(255, 255, 255);
}

.idle-card-icon--volley { background-image: url("../../Domain/Component/Item/_Common/Sprite/game-icons.net/arrow-cluster.png"); }
.idle-card-icon--supply { background-image: url("../../Domain/Component/Item/_Common/Sprite/game-icons.net/round-potion.png"); }
.idle-card-icon--appraise { background-image: url("../../Domain/Component/Item/_Common/Sprite/game-icons.net/sparkles.png"); }

.idle-skill-aim {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
}

.idle-skill-aim-origin {
	position: absolute;
	translate: -50% -50%;
	width: 48px;
	height: 48px;
	border-width: 3px;
	border-color: rgb(128, 228, 255);
	border-radius: 24px;
	background-color: rgba(78, 180, 255, 0.22);
}

.idle-skill-aim-line {
	position: absolute;
	min-width: 6px;
	min-height: 6px;
	border-left-width: 3px;
	border-bottom-width: 3px;
	border-left-color: rgba(128, 228, 255, 0.84);
	border-bottom-color: rgba(128, 228, 255, 0.84);
	background-color: rgba(78, 180, 255, 0.06);
}

.idle-skill-aim-range {
	position: absolute;
	translate: -50% -50%;
	width: 184px;
	height: 184px;
	border-width: 5px;
	border-color: rgb(128, 228, 255);
	border-radius: 92px;
	background-color: rgba(78, 180, 255, 0.22);
}

.idle-skill-aim-caption {
	position: absolute;
	translate: -50% -100%;
	margin-top: -94px;
	width: 200px;
	font-size: 22px;
	-unity-font-style: bold;
	-unity-text-align: middle-center;
	color: rgb(220, 248, 255);
	background-color: rgba(10, 25, 38, 0.9);
}

.idle-card:active {
	scale: 0.96 0.96;
}

.idle-card:disabled {
	opacity: 0.5;
}

.idle-card--ready {
	border-color: rgb(245, 175, 16);
}

.idle-icon-button--on {
	border-color: rgb(245, 175, 16);
	color: rgb(245, 175, 16);
}

.idle-hero-row {
	flex-direction: row;
	align-items: center;
}

.idle-hero-level {
	width: 150px;
	margin-left: 8px;
	font-size: 24px;
	background-color: rgb(28, 28, 28);
	color: rgb(255, 255, 255);
	border-width: 1px;
	border-color: rgb(120, 120, 120);
	border-radius: 0;
	padding: 6px;
}

.idle-hero-level:disabled {
	opacity: 0.4;
}

.idle-stat-rows {
	margin-bottom: 10px;
}

.idle-stat-feedback {
	min-height: 30px;
	margin-top: 3px;
	margin-bottom: 4px;
	font-size: 19px;
	color: rgb(255, 222, 128);
	opacity: 0;
	transition-property: opacity;
	transition-duration: 0.12s;
}

.idle-stat-feedback--shown {
	opacity: 1;
}

.idle-stat-row {
	flex-direction: row;
	align-items: center;
	min-height: 60px;
	margin-bottom: 5px;
}

.idle-stat-name,
.idle-stat-value,
.idle-stat-level {
	font-size: 22px;
	color: rgb(224, 224, 224);
	transition-property: color, scale;
	transition-duration: 0.12s;
}

.idle-stat-name { width: 116px; -unity-font-style: bold; }
.idle-stat-value { width: 124px; -unity-text-align: middle-right; color: rgb(255, 222, 128); }
.idle-stat-level { width: 82px; -unity-text-align: middle-right; color: rgb(154, 154, 148); }

.idle-stat-label--raised {
	color: rgb(255, 222, 128);
	scale: 1.03 1.03;
}

.idle-stat-buy {
	width: 96px;
	min-height: 56px;
	margin-left: 6px;
	font-size: 18px;
	background-color: rgb(28, 28, 28);
	color: rgb(255, 255, 255);
	border-width: 1px;
	border-color: rgb(120, 120, 120);
	border-radius: 0;
	transition-property: background-color, border-color, color, scale;
	transition-duration: 0.12s;
}

.idle-stat-buy--ready {
	background-color: rgba(245, 175, 16, 0.22);
	border-width: 2px;
	border-color: rgb(245, 175, 16);
	color: rgb(255, 236, 174);
}

.idle-stat-buy--ready:active {
	scale: 0.95 0.95;
}

.idle-stat-buy:disabled {
	opacity: 1;
	background-color: rgb(18, 18, 18);
	border-color: rgb(52, 52, 52);
	color: rgb(104, 104, 100);
}

.idle-stat-buy--maxed:disabled {
	background-color: rgb(24, 24, 24);
	color: rgb(128, 128, 122);
}

.idle-stat-buy--raised,
.idle-stat-buy--raised:disabled {
	background-color: rgb(245, 175, 16);
	border-color: rgb(255, 235, 170);
	color: rgb(17, 17, 17);
	scale: 1.04 1.04;
}

.idle-queue {
	flex-direction: row;
	align-items: center;
	margin-top: 6px;
}

.idle-queue-cap {
	font-size: 14px;
	color: rgb(168, 168, 160);
	margin-right: 8px;
	letter-spacing: 2px;
}

.idle-queue-chip {
	font-size: 16px;
	color: rgb(200, 200, 192);
	background-color: rgba(0, 0, 0, 0.55);
	border-width: 0;
	padding: 3px 10px;
	margin-right: 5px;
}

.idle-queue-chip--next {
	color: rgb(245, 175, 16);
}

.idle-cost {
	width: 412px;
	margin-top: 8px;
	flex-direction: row;
	align-items: center;
}

.idle-cost-label {
	width: 96px;
	font-size: 32px;
	-unity-font-style: bold;
	color: rgb(255, 255, 255);
}

.idle-cost-gauge {
	flex-grow: 1;
	height: 12px;
	background-color: rgba(0, 0, 0, 0.55);
	border-width: 0;
	margin: 0 8px;
}

/* 10분절. 채움은 연속이고 눈금이 위에서 나눈다 (하늘색 10분절) */
.idle-cost-tick {
	position: absolute;
	top: 0;
	bottom: 0;
	width: 3px;
	background-color: rgb(12, 12, 12);
}

.idle-cost-fill {
	height: 100%;
	background-color: rgb(116, 218, 255);
}

.idle-debug {
	position: absolute;
	left: 20px;
	bottom: 14px;
	color: rgb(181, 131, 18);
}

/* 맵 팝업 */
/* 템플릿 호스트(ui:Instance)는 기본이 흐름 배치라 높이 0. 층으로 깔아야 안의 absolute 가 화면 기준 (실측 2026-09-05: 팝업 y 1080, 손패 y -305) */
.idle-layer {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
}

.idle-modal-shade {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	align-items: center;
	justify-content: center;
	background-color: rgba(0, 0, 0, 0.76);
	-unity-background-scale-mode: scale-and-crop;
	-unity-background-image-tint-color: rgba(72, 72, 72, 0.68);
}

.idle-modal-panel {
	width: 1520px;
	height: 820px;
	padding: 26px 32px;
	background-color: rgba(22, 22, 24, 0.98);
	border-width: 2px;
	border-color: rgb(112, 112, 104);
}

.idle-modal-scroll { flex-grow: 1; margin-top: 14px; }

.idle-modal-pager {
	flex-direction: row;
	align-items: center;
	justify-content: center;
	height: 64px;
	margin-top: 10px;
}

.idle-modal-page-button {
	width: 72px;
	height: 54px;
	margin: 0 12px;
	font-size: 28px;
}

.idle-modal-page-label {
	min-width: 110px;
	font-size: 26px;
	-unity-text-align: middle-center;
}

.idle-map {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	align-items: center;
	justify-content: center;
	background-color: rgba(0, 0, 0, 0.76);
}

.idle-map-art {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background-image: url("../../Domain/World/Map/Map.png");
	-unity-background-scale-mode: scale-and-crop;
	opacity: 0.38;
}

.idle-map-panel {
	width: 1120px;
	height: 820px;
	padding: 24px 30px;
	background-color: rgba(15, 20, 26, 0.94);
	border-width: 2px;
	border-color: rgb(210, 177, 105);
}

.idle-map-scroll {
	flex-grow: 1;
	margin-top: 12px;
}

.idle-map-rows {
	padding: 8px;
}

/* ── 관리 열 ── */
.idle-side {
	width: 720px;
	flex-shrink: 0;
	background-color: rgb(26, 26, 26);
	border-left-width: 2px;
	border-left-color: rgb(0, 0, 0);
}

.idle-tabs {
	flex-direction: row;
	padding: 8px 8px 0 8px;
	background-color: rgb(21, 21, 21);
	border-bottom-width: 1px;
	border-bottom-color: rgb(58, 58, 58);
}

.idle-tab {
	flex-grow: 1;
	flex-basis: 0;
	min-width: 0;
	height: 72px;
	margin: 0 1px;
	padding: 0 2px;
	background-color: rgb(30, 30, 30);
	color: rgb(200, 200, 192);
	border-width: 0;
	border-radius: 0;
	/* 탭 일곱이 720 을 나눠 칸당 102px. 28px 글자로는 3자가 한계라 여기만 낮춘다.
	   XAG 28px 은 <본문> 기준이고 탭은 이름표 (실측 2026-09-01) */
	font-size: 20px;
	white-space: normal;
	overflow: hidden;
}

.idle-tab:hover {
	background-color: rgb(42, 42, 42);
}

.idle-tab--on {
	background-color: rgb(236, 236, 232);
	color: rgb(17, 17, 17);
	-unity-font-style: bold;
}

.idle-tab--badge {
	border-top-width: 4px;
	border-top-color: rgb(181, 20, 14);
}

.idle-tab--close {
	flex-grow: 0;
	width: 56px;
	min-height: 56px;
	font-size: 36px;
	-unity-font-style: bold;
}

.idle-panel-head {
	flex-direction: row;
	align-items: center;
	padding: 12px 18px;
	border-bottom-width: 2px;
	border-bottom-color: rgb(58, 58, 58);
}

.idle-panel-title {
	font-size: 38px;
	-unity-font-style: bold;
	color: rgb(255, 255, 255);
	margin-right: 12px;
}

.idle-panel-body {
	flex-grow: 1;
}

.idle-page {
	padding: 16px 18px;
}

.idle-row-head {
	font-size: 28px;
	color: rgb(200, 200, 192);
	margin: 8px 0 4px 0;
	white-space: normal;
}

.idle-row-title {
	font-size: 28px;
	color: rgb(240, 240, 236);
	margin-top: 6px;
	white-space: normal;
}

.idle-row-title--dim {
	color: rgb(110, 110, 104);
}

.idle-row-note {
	font-size: 24px;
	color: rgb(138, 138, 130);
	margin: 4px 0;
	white-space: normal;
}

.idle-row-button {
	height: 56px;
	font-size: 28px;
	margin: 3px 0;
	background-color: rgb(40, 40, 40);
	color: rgb(240, 240, 236);
	border-width: 1px;
	border-color: rgb(58, 58, 58);
	border-radius: 0;
	-unity-text-align: middle-left;
	padding: 0 12px;
	white-space: normal;
}

.idle-row-button:hover {
	background-color: rgb(56, 56, 56);
}

.idle-row-button:disabled {
	opacity: 0.45;
}

.idle-row-button--strong {
	background-color: rgb(245, 196, 0);
	color: rgb(17, 17, 17);
	-unity-font-style: bold;
	-unity-text-align: middle-center;
}

.idle-row-button--tall {
	height: 56px;
	font-size: 32px;
}

.idle-party {
	flex-direction: row;
	margin: 6px 0 4px 0;
}

.idle-party-seat {
	position: relative;
	flex-grow: 1;
	height: 132px;
	margin: 0 3px;
	font-size: 24px;
	white-space: normal;
	background-color: rgb(40, 40, 40);
	color: rgb(240, 240, 236);
	border-width: 2px;
	border-color: rgb(58, 58, 58);
	border-radius: 0;
}

.idle-party-portrait {
	position: absolute;
	left: 8px;
	top: 6px;
	width: 78px;
	height: 92px;
	-unity-background-scale-mode: scale-to-fit;
}

.idle-party-label {
	position: absolute;
	left: 8px;
	right: 8px;
	bottom: 5px;
	font-size: 18px;
	-unity-font-style: bold;
	-unity-text-align: middle-center;
	color: rgb(238, 238, 232);
}

.idle-party-seat--sub {
	border-color: rgb(79, 179, 166);
}

.idle-party-seat--picking {
	background-color: rgb(245, 175, 16);
	color: rgb(17, 17, 17);
}

.idle-worn {
	flex-direction: row;
	margin: 6px 0 10px 0;
}

.idle-worn-cell {
	position: relative;
	width: 128px;
	height: 110px;
	margin-right: 10px;
	background-color: rgb(40, 40, 40);
	border-width: 1px;
	border-color: rgb(58, 58, 58);
	color: rgb(240, 240, 236);
	font-size: 28px;
	-unity-text-align: middle-center;
	white-space: normal;
}

.idle-worn-cell--empty {
	color: rgb(110, 110, 104);
}

.idle-bag {
	flex-direction: row;
	flex-wrap: wrap;
	margin: 6px 0;
}

.idle-bag-cell {
	position: relative;
	width: 90px;
	height: 90px;
	margin: 3px;
	font-size: 24px;
	white-space: normal;
	background-color: rgb(40, 40, 40);
	color: rgb(240, 240, 236);
	border-width: 1px;
	border-color: rgb(58, 58, 58);
	border-radius: 0;
}

.idle-gear-visual {
	position: absolute;
	left: 12px;
	top: 8px;
	right: 12px;
	bottom: 22px;
	-unity-background-scale-mode: scale-to-fit;
	-unity-background-image-tint-color: rgb(245, 241, 226);
}

.idle-gear-tier-badge {
	position: absolute;
	left: 5px;
	bottom: 4px;
	font-size: 17px;
	-unity-font-style: bold;
	color: rgb(255, 224, 135);
}

.idle-gear-potential {
	position: absolute;
	right: 5px;
	bottom: 4px;
	font-size: 14px;
	color: rgb(190, 214, 238);
}

.idle-bag-cell:disabled {
	opacity: 0.3;
}

.idle-warn {
	color: rgb(220, 100, 100);
	-unity-font-style: bold;
}

.idle-banner {
	height: 220px;
	background-color: rgb(38, 30, 16);
	border-width: 2px;
	border-color: rgb(17, 17, 17);
	padding: 18px;
	margin-bottom: 12px;
}

.idle-banner-title {
	font-size: 52px;
	-unity-font-style: bold;
	color: rgb(255, 255, 255);
}

.idle-button {
	height: 56px;
	font-size: 28px;
	background-color: rgb(40, 40, 40);
	color: rgb(240, 240, 236);
	border-width: 1px;
	border-color: rgb(90, 90, 90);
	border-radius: 0;
	margin: 3px 0;
	padding: 0 16px;
}

.idle-button:hover {
	background-color: rgb(56, 56, 56);
}

.idle-button--strong {
	background-color: rgb(245, 175, 16);
	color: rgb(17, 17, 17);
	-unity-font-style: bold;
}

.idle-button,
.idle-row-button,
.idle-icon-button,
.idle-tab,
.idle-subtab {
	transition-property: background-color, scale, color;
	transition-duration: 0.12s;
}

.idle-button:hover,
.idle-row-button:hover,
.idle-icon-button:hover,
.idle-tab:hover,
.idle-subtab:hover {
	background-color: rgba(245, 175, 16, 0.18);
	color: rgb(255, 236, 174);
}

.idle-button:active,
.idle-row-button:active,
.idle-icon-button:active,
.idle-tab:active,
.idle-subtab:active {
	scale: 0.97 0.97;
}

.idle-merge-row {
	flex-direction: row;
	align-items: center;
	margin: 3px 0;
}

.idle-merge-label {
	flex-grow: 1;
	font-size: 28px;
	color: rgb(240, 240, 236);
	border-left-width: 4px;
	padding-left: 10px;
	margin-right: 8px;
}

.idle-merge-button {
	width: 230px;
	margin: 0;
}

/* 툴팁. 마우스 옆 */
.idle-tooltip {
	position: absolute;
	width: 300px;
	padding: 10px 12px;
	background-color: rgb(17, 17, 17);
	border-width: 1px;
	border-color: rgb(90, 90, 90);
	color: rgb(255, 255, 255);
	font-size: 24px;
	white-space: normal;
	border-radius: 8px;
}

/* 아이템 서브탭 */
.idle-subtabs {
	flex-direction: row;
	margin-bottom: 10px;
}

.idle-subtab {
	height: 56px;
	padding: 0 22px;
	margin-right: 4px;
	background-color: rgb(30, 30, 30);
	color: rgb(180, 180, 172);
	border-width: 1px;
	border-color: rgb(58, 58, 58);
	border-radius: 0;
	font-size: 28px;
}

.idle-subtab--on {
	background-color: rgb(236, 236, 232);
	color: rgb(17, 17, 17);
	-unity-font-style: bold;
}

/* 공방 */
.idle-forge-kinds {
	flex-direction: row;
	flex-wrap: wrap;
	margin-bottom: 12px;
}

.idle-forge-kind {
	height: 56px;
	padding: 0 12px;
	margin: 0 6px 6px 0;
	background-color: rgb(40, 40, 40);
	color: rgb(240, 240, 236);
	border-width: 2px;
	border-color: rgb(58, 58, 58);
	border-radius: 0;
	font-size: 24px;
}

.idle-forge-kind--on {
	background-color: rgb(236, 236, 232);
	color: rgb(17, 17, 17);
	-unity-font-style: bold;
}

.idle-forge-bench {
	flex-direction: row;
	align-items: center;
	margin: 6px 0 10px 0;
}

.idle-forge-grid {
	flex-direction: row;
	flex-wrap: wrap;
	width: 306px;
}

.idle-forge-cell {
	width: 112px;
	height: 96px;
	margin: 3px;
	background-color: rgb(40, 40, 40);
	border-width: 2px;
	border-color: rgb(58, 58, 58);
	color: rgb(240, 240, 236);
	font-size: 24px;
	-unity-text-align: middle-center;
	white-space: normal;
}

.idle-forge-outcome {
	flex-direction: row;
	align-items: center;
	margin-left: 20px;
}

.idle-forge-arrow {
	font-size: 52px;
	color: rgb(138, 138, 130);
	margin-right: 16px;
}

.idle-forge-cell--result {
	width: 160px;
	height: 120px;
	font-size: 28px;
}

.idle-forge-cell--ready {
	background-color: rgb(60, 50, 20);
}

.idle-gear-popup {
	width: 1520px;
	height: 820px;
}

.idle-choice-popup {
	width: 1520px;
	height: 820px;
}

.idle-away-shade {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	align-items: center;
	justify-content: center;
	background-color: rgba(0, 0, 0, 0.72);
}

.idle-away-card {
	width: 620px;
	padding: 32px 38px 28px 38px;
	background-color: rgba(20, 20, 20, 0.98);
	border-width: 2px;
	border-color: rgb(245, 175, 16);
}

.idle-away-cap {
	-unity-text-align: middle-center;
}

.idle-away-title {
	margin-top: 8px;
	font-size: 42px;
	-unity-font-style: bold;
	-unity-text-align: middle-center;
}

.idle-away-span {
	margin-top: 8px;
	font-size: 22px;
	color: rgb(190, 190, 182);
	-unity-text-align: middle-center;
}

.idle-away-rewards {
	margin-top: 24px;
	margin-bottom: 18px;
}

.idle-away-reward {
	min-height: 48px;
	flex-direction: row;
	align-items: center;
	border-bottom-width: 1px;
	border-bottom-color: rgba(255, 255, 255, 0.12);
}

.idle-away-reward-name {
	flex-grow: 1;
	font-size: 23px;
	color: rgb(190, 190, 182);
}

.idle-away-reward-value {
	font-size: 27px;
	-unity-font-style: bold;
	color: rgb(245, 175, 16);
}

.idle-away-warning {
	margin-bottom: 18px;
	padding: 10px 12px;
	font-size: 19px;
	white-space: normal;
	color: rgb(242, 170, 130);
	background-color: rgba(110, 38, 20, 0.32);
}

.idle-away-close {
	height: 58px;
	font-size: 24px;
	-unity-font-style: bold;
	color: rgb(20, 20, 20);
	background-color: rgb(245, 175, 16);
	border-width: 0;
}

.idle-choice-grid {
	flex-direction: row;
	flex-wrap: wrap;
	align-content: flex-start;
}

.idle-choice-card {
	width: 23%;
	height: 132px;
	margin: 6px 1%;
	padding: 10px;
	font-size: 20px;
	white-space: normal;
	flex-direction: row;
	align-items: center;
	-unity-text-align: middle-left;
	background-color: rgb(32, 32, 32);
	color: rgb(238, 238, 238);
	border-width: 1px;
	border-color: rgb(84, 84, 84);
	border-radius: 0;
}

.idle-choice-icon {
	width: 92px;
	height: 104px;
	margin-right: 12px;
	flex-shrink: 0;
	-unity-background-scale-mode: scale-to-fit;
	-unity-background-image-tint-color: rgb(236, 236, 228);
}

.idle-choice-label {
	flex-grow: 1;
	font-size: 20px;
	white-space: normal;
	color: rgb(238, 238, 238);
}

.idle-gear-icon--0 { background-image: url("../../Domain/Component/Item/_Common/Sprite/game-icons.net/suits.png"); }
.idle-gear-icon--1 { background-image: url("../../Domain/Component/Item/_Common/Sprite/game-icons.net/warlock-eye.png"); }
.idle-gear-icon--2 { background-image: url("../../Domain/Component/Item/_Common/Sprite/game-icons.net/winged-sword.png"); }
.idle-gear-icon--3 { background-image: url("../../Domain/Component/Item/_Common/Sprite/game-icons.net/walking-boot.png"); }

.idle-hero-grade-1 { background-color: rgb(29, 43, 49); }
.idle-hero-grade-2 { background-color: rgb(28, 45, 70); }
.idle-hero-grade-3 { background-color: rgb(54, 36, 72); }
.idle-hero-grade-4 { background-color: rgb(74, 50, 24); }

.idle-choice-card:hover {
	background-color: rgba(245, 175, 16, 0.16);
}

.idle-choice-card--selected {
	border-color: rgb(245, 175, 16);
}

.idle-gear-card {
	width: 15.6%;
	height: 132px;
	min-height: 132px;
}

.idle-choice-card--empty,
.idle-choice-card--empty:disabled {
	background-color: rgba(16, 16, 16, 0.72);
	border-color: rgb(48, 48, 48);
	opacity: 1;
}

.idle-gear-row {
	width: 100%;
	padding: 10px 12px;
	margin-bottom: 6px;
	-unity-text-align: middle-left;
}

.idle-party-seat--geared {
	border-color: rgb(226, 186, 96);
}

.idle-gold-panel {
	width: 620px;
	height: 430px;
	padding: 42px;
	align-items: center;
	justify-content: center;
	background-color: rgba(22, 22, 24, 0.98);
	border-width: 2px;
	border-color: rgb(245, 188, 52);
}

.idle-gold-panel .idle-gold-icon { width: 94px; height: 94px; margin: 0 0 14px 0; }
.idle-gold-amount { margin-top: 16px; font-size: 46px; -unity-font-style: bold; color: rgb(255, 229, 142); }
.idle-gold-income { margin-top: 10px; font-size: 28px; color: rgb(182, 218, 151); }
.idle-gold-close { margin-top: 28px; width: 220px; height: 58px; font-size: 24px; }

.idle-settings-panel {
	width: 820px;
	height: 690px;
	padding: 22px 30px 30px 30px;
	background-color: rgba(22, 22, 24, 0.98);
	border-width: 2px;
	border-color: rgb(112, 112, 104);
}

.idle-settings-section-title {
	margin-top: 28px;
	margin-bottom: 10px;
	font-size: 24px;
	-unity-font-style: bold;
	color: rgb(224, 224, 216);
}

.idle-settings-speeds { flex-direction: row; }
.idle-settings-speed {
	width: 150px;
	height: 64px;
	margin-right: 10px;
	font-size: 26px;
	background-color: rgb(34, 34, 36);
	color: rgb(220, 220, 214);
	border-width: 1px;
	border-color: rgb(84, 84, 84);
}
.idle-settings-speed--selected { color: rgb(18, 18, 18); background-color: rgb(245, 175, 16); border-color: rgb(255, 219, 126); }
.idle-settings-log { flex-grow: 1; min-height: 180px; padding: 18px; background-color: rgb(14, 14, 16); border-width: 1px; border-color: rgb(58, 58, 58); }
.idle-hidden {
	display: none;
}
