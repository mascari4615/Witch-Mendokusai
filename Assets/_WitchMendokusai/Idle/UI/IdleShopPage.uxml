<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- 상점 탭 (layout.md 표 3, 구현 순서 10). 배너 (픽업, 천장), 1회와 묶음, 확률표, 무료 상자, 가방 -->
    <Style src="BattleScreen.uss" />
    <Style src="IdleGrammar.uss" />
    <ui:VisualElement name="page" class="idle-page idle-workspace-page">
        <ui:VisualElement class="idle-section">
        <ui:Label text="DOLL SUMMON" class="idle-banner-title" />
        <ui:VisualElement class="idle-banner idle-shop-banner">
            <ui:VisualElement name="pickup-portrait" class="idle-shop-pickup-portrait" />
            <ui:VisualElement class="idle-shop-banner-text">
                <ui:Label text="PICKUP" class="idle-cap" />
                <ui:Label name="pickup-label" class="idle-shop-pickup-label" />
                <ui:Label name="pity-label" class="idle-shop-pity-label" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="idle-shop-pull-row">
            <ui:Button name="pull-button" class="idle-row-button idle-row-button--strong idle-row-button--tall idle-shop-pull" />
            <ui:Button name="pull-batch-button" class="idle-row-button idle-row-button--strong idle-row-button--tall idle-shop-pull idle-shop-pull--second" />
        </ui:VisualElement>
        <ui:VisualElement class="idle-shop-odds-row">
            <ui:Label name="pull-odds" class="idle-row-note idle-shop-odds-note" />
            <ui:Button name="odds-button" class="idle-row-button idle-shop-odds-button" />
        </ui:VisualElement>
        <ui:Label text="NO CASH PURCHASES. STONES FROM FIRST CLEARS, REBIRTH, DROPS AND FREE BOXES." class="idle-row-note" />
        </ui:VisualElement>
        <ui:VisualElement class="idle-section">
        <ui:Label text="FREE BOX" class="idle-row-title idle-shop-section-cap" />
        <ui:Button name="free-box-button" class="idle-row-button idle-row-button--strong" />
        </ui:VisualElement>
        <ui:VisualElement class="idle-section">
        <ui:Label text="EXPAND BAG" class="idle-row-title idle-shop-section-cap" />
        <ui:Button name="bag-button" class="idle-row-button idle-row-button--strong" />
        <ui:Label name="bag-note" class="idle-row-note" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
