<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- 상점 탭 (layout.md §3). 인형 뽑기와 무료 상자 -->
    <Style src="BattleScreen.uss" />
    <ui:VisualElement name="page" class="idle-page">
        <ui:VisualElement class="idle-banner">
            <ui:Label text="인형 뽑기" class="idle-banner-title" />
            <ui:Label text="PICK UP" class="idle-cap" />
        </ui:VisualElement>
        <ui:Button name="pull-button" class="idle-row-button idle-row-button--strong idle-row-button--tall" />
        <ui:Label name="pull-odds" class="idle-row-note" />
        <ui:Label text="현금 결제 없음. 뽑기 재화는 첫 클리어, 환생, 낮은 확률 드롭에서만." class="idle-row-note" />
        <ui:VisualElement class="idle-banner">
            <ui:Label text="가방 넓히기" class="idle-banner-title" />
            <ui:Label text="BAG" class="idle-cap" />
        </ui:VisualElement>
        <ui:Button name="bag-button" class="idle-row-button idle-row-button--strong" />
        <ui:Label name="bag-note" class="idle-row-note" />
        <ui:Label text="무료 상자" class="idle-cap" />
    </ui:VisualElement>
</ui:UXML>
