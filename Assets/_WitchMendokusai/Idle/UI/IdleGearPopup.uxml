<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- 장비 고르기 팝업. 인형 탭의 장비 칸을 누르면 뜬다 (사용자 2026-08-31: 가방에서 누르는 건 기획 오류) -->
    <Style src="BattleScreen.uss" />
    <ui:VisualElement name="popup" class="idle-modal-shade idle-hidden">
        <ui:VisualElement name="gear-panel" class="idle-box idle-modal-panel idle-gear-popup">
            <ui:VisualElement class="idle-panel-head">
                <ui:Label name="gear-title" class="idle-panel-title" />
                <ui:Button name="gear-close" text="X" class="idle-tab idle-tab--close" />
            </ui:VisualElement>
            <ui:Label name="gear-worn" class="idle-row-note" />
            <ui:ScrollView class="idle-modal-scroll">
                <ui:VisualElement name="gear-rows" class="idle-choice-grid" />
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
