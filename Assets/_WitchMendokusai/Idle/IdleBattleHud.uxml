<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="IdleBattleScreen.uss" />
    <ui:VisualElement name="hud">
        <ui:VisualElement name="scene-cover" class="idle-scene-cover">
            <ui:Label name="scene-cover-label" class="idle-scene-cover-label" />
            <ui:Button name="scene-cover-button" class="idle-button" text="전투로" />
        </ui:VisualElement>
        <ui:VisualElement name="op" class="idle-box idle-op">
            <ui:VisualElement class="idle-op-row">
                <ui:Label name="op-code" class="idle-op-code" />
                <ui:Label name="op-name" class="idle-op-name" />
            </ui:VisualElement>
            <ui:VisualElement class="idle-op-row">
                <ui:VisualElement name="wave-dots" class="idle-wave" />
                <ui:Label name="wave-label" class="idle-cap" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="idle-step-row">
            <ui:VisualElement class="idle-box idle-stepper">
                <ui:Button name="step-back" class="idle-step-button" text="◀" />
                <ui:Label name="step-label" class="idle-step-label" />
                <ui:Button name="step-forward" class="idle-step-button" text="▶" />
            </ui:VisualElement>
            <ui:Button name="repeat-button" class="idle-box idle-toggle" />
        </ui:VisualElement>
        <ui:VisualElement class="idle-chips">
            <ui:Label name="gold-chip" class="idle-box idle-chip" />
            <ui:Label name="pull-chip" class="idle-box idle-chip" />
            <ui:Label name="prestige-chip" class="idle-box idle-chip" />
            <ui:Button name="split-button" class="idle-box idle-icon-button" text="분할" />
        </ui:VisualElement>
        <ui:VisualElement class="idle-speed-row">
            <ui:Button name="speed-cycle-button" class="idle-box idle-icon-button" />
            <ui:Button name="auto-cast-button" class="idle-box idle-icon-button" text="AUTO" />
        </ui:VisualElement>
        <ui:VisualElement class="idle-box idle-log">
            <ui:Label class="idle-cap" text="LOG" />
            <ui:Label name="log-label" class="idle-log-line" />
            <ui:Label name="note-label" class="idle-log-line idle-log-line--note" />
        </ui:VisualElement>
        <ui:VisualElement name="enemy-bar" class="idle-box idle-enemy">
            <ui:Label name="enemy-label" class="idle-enemy-label" />
            <ui:VisualElement class="idle-enemy-gauge"><ui:VisualElement name="enemy-fill" class="idle-enemy-fill" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="fail-banner" class="idle-box idle-fail">
            <ui:Label name="fail-label" class="idle-fail-label" />
            <ui:Button name="next-stage-button" class="idle-button idle-button--strong" />
        </ui:VisualElement>
        <ui:VisualElement class="idle-hand">
            <ui:VisualElement name="cards" />
            <ui:VisualElement name="card-queue" class="idle-queue" />
            <ui:VisualElement class="idle-cost">
                <ui:Label name="cost-label" class="idle-cost-label" />
                <ui:VisualElement class="idle-cost-gauge"><ui:VisualElement name="cost-fill" class="idle-cost-fill" /></ui:VisualElement>
                <ui:Label class="idle-cap" text="COST" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
