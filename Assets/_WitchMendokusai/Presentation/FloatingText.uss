.wm-floating-text {
	position: absolute;
	translate: -50% -50%;
	opacity: 0;
	scale: 0.6 0.6;
	transition-property: opacity, scale, translate;
	transition-duration: 0.18s;
	transition-timing-function: ease-out-cubic;
}

.wm-floating-text--active {
	opacity: 1;
	scale: 1 1;
	translate: -50% -120%;
}

.wm-floating-text Label {
	-unity-text-align: middle-center;
	-unity-font-style: bold;
	font-size: 22px;
}

.wm-floating-text--normal Label { color: rgb(255, 255, 255); }
.wm-floating-text--critical Label { color: rgb(255, 106, 78); font-size: 26px; }
.wm-floating-text--heal Label { color: rgb(120, 220, 130); }
.wm-floating-text--exp Label { color: rgb(174, 204, 255); font-size: 16px; }
.wm-floating-text--warning Label { color: rgb(255, 230, 80); }
.wm-floating-text--hurt Label { color: rgb(255, 112, 104); font-size: 28px; }
.wm-floating-text--buff Label { color: rgb(96, 224, 255); font-size: 27px; }
